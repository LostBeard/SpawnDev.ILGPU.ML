<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>5.2.13</Version>
		<PackageReleaseNotes>v5.2.13 - BREAKING: model delivery no longer uses WebTorrent. SpawnDev.ILGPU.ML does not reference SpawnDev.WebTorrent at all; models arrive over plain HTTP through the SpawnDev hub and are cached locally (OPFS in the browser, disk on desktop). Torrent delivery moves to the optional SpawnDev.ILGPU.ML.WebTorrent package, whose HubModelStream implements the same IModelSource - a one-line swap. New delivery types: IModelSource / ICachingModelSource (transport), IModelStore / IResumableModelStore (storage), HubModelSource + OpfsModelCache (browser), HttpClientModelSource + FileModelStore (desktop). Downloads are resumable, cancellable, report progress during transfer, and refuse to serve a truncated entry; the payload never enters the managed heap (measured 9.6-20.1% of file size, vs 119.8-136.6% with a copy reinstated). MEASURED on WebGPU, Qwen3-1.7B-Q8_0 (1.83 GB): 44.4s download, 4.5s warm load to GPU. Chunk sizes measured rather than assumed: 16 MiB reads run 1559-1986 MB/s against 1290-1320 at 4 MiB, so BufferPool no longer overrides ILGPU's 16 MiB default downward. BREAKING signatures: DepthEstimationPipeline.CreateFromHubAsync and ImageGenerationPipeline.CreateAsync take IModelSource; InferenceSession.CreateFromHuggingFaceAsync loses its webTorrent parameter; ModelHub.OpenStreamAsync returns Stream and is no longer obsolete; ModelCache is removed. Full history: CHANGELOG.md</PackageReleaseNotes>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>Embedded</DebugType>
		<Title>SpawnDev.ILGPU.ML</Title>
		<Authors>LostBeard</Authors>
		<Description>Hardware-agnostic machine learning infrastructure for .NET. Implements high-performance neural network layers in C# that transpile to WebGPU, CUDA, OpenCL, and WebGL via SpawnDev.ILGPU. Optimized for Blazor WebAssembly and native GPU execution.</Description>
		<PackageProjectUrl>https://github.com/LostBeard/SpawnDev.ILGPU.ML</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon-128.png</PackageIcon>
		<RepositoryUrl>https://github.com/LostBeard/SpawnDev.ILGPU.ML.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Blazor;BlazorWebAssembly;WebGPU;WebGL;WebAssembly;WebWorkers;GPGPU;ILGPU;ParallelProcessing;Cuda;OpenCL;ComputeShader;CrossPlatform;MachineLearning</PackageTags>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>
		<IsPackable>true</IsPackable>
		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<None Include="Assets\icon-128.png" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SpawnDev.SpawnJS" Version="2.1.17" />
		<PackageReference Include="SpawnDev.ILGPU" Version="5.2.11" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
		<SupportedPlatform Include="windows" />
		<SupportedPlatform Include="linux" />
		<SupportedPlatform Include="macos" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Data\imagenet_classes.txt" />
	</ItemGroup>

  <ItemGroup>
    <!--
      The MIT English frontend. ZipVoice cannot speak English without a phonemizer - its shipped lexicon
      is Chinese-only - and the reference implementation reaches for espeak-ng (GPL-3) at that point.
      This is dependency-free and browser-capable, so it costs nothing to carry.
    -->
    <ProjectReference Include="..\SpawnDev.Phonemizer\SpawnDev.Phonemizer.csproj" />
  </ItemGroup>
</Project>
