<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>5.8.15</Version>
		<PackageReleaseNotes>v5.8.15 - on SpawnDev.ILGPU 5.4.28. Much faster SHORT prompts on CUDA: qwen3:1.7b Q4_K_M on an RTX 4070 reaches the first token of a 29-token prompt at ~2,550 prompt tok/s with the default (5.8.14: ~930) and ~3,320 with the opt-in int8 mode (5.8.14: ~1,480; Ollama's own prompt-eval timer: ~3.4k). Three changes: (1) the batch decoder hands out a token read that has already completed before it queues the next step, so the first token no longer waits for the first decode step (env GGUF_HANDOUT_FIRST=0 is the A/B); (2) prompts of at most 64 tokens use new tensor-core GEMMs with a 32-row token tile (the 128-row tile computed mostly padding at short prompts; env GGUF_S8_M32_MAX / GGUF_KQ_M32_MAX / GGUF_F16_M32_MAX, 0 = off); (3) GEMMs whose grid is too small to fill the GPU split K into one wave of partial sums, reduced in a fixed order (deterministic; env GGUF_S8_SPLITK / GGUF_F16_SPLITK / GGUF_KQ_SPLITK = 0 are the A/Bs). Long prompts +2-3%, decode unchanged, the default path's numerics unchanged (the 32-row K-quant kernel is bit-identical to the 128-row one; split-K is held to the same error bound and was more accurate in the tests). FIX: Wan22Paths.InRepo() named a text encoder the models host does not serve (umt5 bf16, 404); it now defaults to the hosted 8-bit umT5, which is as faithful to the reference. Also: the int8 prefill GEMM spreads its per-tile scale work over all warps. See CHANGELOG.md.</PackageReleaseNotes>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>Embedded</DebugType>
		<Title>SpawnDev.ILGPU.ML</Title>
		<Authors>LostBeard</Authors>
		<Description>Hardware-agnostic machine learning infrastructure for .NET. Implements high-performance neural network layers in C# that transpile to WebGPU, CUDA, OpenCL, and WebGL via SpawnDev.ILGPU. Optimized for Blazor WebAssembly and native GPU execution.</Description>
		<PackageProjectUrl>https://github.com/LostBeard/SpawnDev.ILGPU.ML</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon-128.png</PackageIcon>
		<RepositoryUrl>https://github.com/LostBeard/SpawnDev.ILGPU.ML.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Blazor;BlazorWebAssembly;WebGPU;WebGL;WebAssembly;WebWorkers;GPGPU;ILGPU;ParallelProcessing;Cuda;OpenCL;ComputeShader;CrossPlatform;MachineLearning</PackageTags>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>
		<IsPackable>true</IsPackable>
		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- Trim safe, enforced: the trim analyzer runs on every build and any trim (IL2xxx) warning fails it. -->
		<IsTrimmable>true</IsTrimmable>
		<EnableAotAnalyzer>true</EnableAotAnalyzer>
		<WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2057;IL2060;IL2062;IL2065;IL2067;IL2069;IL2070;IL2072;IL2073;IL2074;IL2075;IL2076;IL2077;IL2078;IL2080;IL2087;IL2088;IL2089;IL2090;IL2091;IL2092;IL2093;IL2094;IL2095;IL2106;IL2111;IL2112;IL2113;IL2114</WarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<None Include="Assets\icon-128.png" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SpawnDev.SpawnJS" Version="3.0.8" />
		<PackageReference Include="SpawnDev.ILGPU" Version="5.4.28" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
		<SupportedPlatform Include="windows" />
		<SupportedPlatform Include="linux" />
		<SupportedPlatform Include="macos" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Data\imagenet_classes.txt" />
	</ItemGroup>

  <ItemGroup>
    <!--
      The MIT English frontend. ZipVoice cannot speak English without a phonemizer - its shipped lexicon
      is Chinese-only - and the reference implementation reaches for espeak-ng (GPL-3) at that point.
      This is dependency-free and browser-capable, so it costs nothing to carry.
    -->
    <ProjectReference Include="..\SpawnDev.Phonemizer\SpawnDev.Phonemizer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- FaceDetectionPipeline.DetectBothWaysAsync: GPU decode vs the managed reference, for the parity test only -->
    <InternalsVisibleTo Include="SpawnDev.ILGPU.ML.Demo.Shared" />
  </ItemGroup>
	<!-- A stable package must carry its own release notes: 5.8.2 - 5.8.4 shipped 5.8.1's (found by Data on nuget.org, 2026-11-06). -local builds are exempt. -->
	<Target Name="CheckReleaseNotesMatchVersion" BeforeTargets="GenerateNuspec" Condition="!$(Version.Contains('-'))">
		<Error Condition="!$(PackageReleaseNotes.StartsWith('v$(Version) '))" Text="PackageReleaseNotes must start with 'v$(Version) ' for a stable package; it starts '$(PackageReleaseNotes.Substring(0, 12))'. Update the notes in SpawnDev.ILGPU.ML.csproj." />
	</Target>
</Project>
