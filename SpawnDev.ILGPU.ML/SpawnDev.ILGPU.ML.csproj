<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>5.2.18</Version>
		<PackageReleaseNotes>v5.2.18 - building a decode capture can no longer fail a generation, whatever goes wrong. 5.2.17 made ONE guard inside TryCaptureAsync return null instead of throwing, and the next report was a different guard in the same method - 'attention slot count mismatch 44/49' - still killing every chat turn. Guards are exactly what gets added to over time, so catching them one at a time at the throw site is a losing shape; the contract now lives at the call site in GgufGenerator, beside the fallback. A capture is an OPTIMISATION and the fallback next to it is a complete, correct decode, so a capture that cannot be built is a performance outcome and never a failed answer. The failure is still reported loudly and capture is disabled for the session.</PackageReleaseNotes>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>Embedded</DebugType>
		<Title>SpawnDev.ILGPU.ML</Title>
		<Authors>LostBeard</Authors>
		<Description>Hardware-agnostic machine learning infrastructure for .NET. Implements high-performance neural network layers in C# that transpile to WebGPU, CUDA, OpenCL, and WebGL via SpawnDev.ILGPU. Optimized for Blazor WebAssembly and native GPU execution.</Description>
		<PackageProjectUrl>https://github.com/LostBeard/SpawnDev.ILGPU.ML</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon-128.png</PackageIcon>
		<RepositoryUrl>https://github.com/LostBeard/SpawnDev.ILGPU.ML.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Blazor;BlazorWebAssembly;WebGPU;WebGL;WebAssembly;WebWorkers;GPGPU;ILGPU;ParallelProcessing;Cuda;OpenCL;ComputeShader;CrossPlatform;MachineLearning</PackageTags>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>
		<IsPackable>true</IsPackable>
		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<None Include="Assets\icon-128.png" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SpawnDev.SpawnJS" Version="2.1.17" />
		<PackageReference Include="SpawnDev.ILGPU" Version="5.2.12" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
		<SupportedPlatform Include="windows" />
		<SupportedPlatform Include="linux" />
		<SupportedPlatform Include="macos" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Data\imagenet_classes.txt" />
	</ItemGroup>

  <ItemGroup>
    <!--
      The MIT English frontend. ZipVoice cannot speak English without a phonemizer - its shipped lexicon
      is Chinese-only - and the reference implementation reaches for espeak-ng (GPL-3) at that point.
      This is dependency-free and browser-capable, so it costs nothing to carry.
    -->
    <ProjectReference Include="..\SpawnDev.Phonemizer\SpawnDev.Phonemizer.csproj" />
  </ItemGroup>
</Project>
