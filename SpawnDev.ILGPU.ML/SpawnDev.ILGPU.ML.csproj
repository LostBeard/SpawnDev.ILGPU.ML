<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>5.3.16</Version>
		<PackageReleaseNotes>v5.3.16 - Humanoid animation: SpawnDev.ILGPU.ML.Animation plays NVIDIA Kimodo motion clips on a SkinTokens-rigged character (HumanoidMapper finds the body by the shape of the bone tree, HumanoidRetargeter retargets in world space with rest alignment, AnimatedGlb writes glTF animations; matches the reference script to 4e-8). The Image to 3D demo gets an Animate button with 22 preset moves, an in-place toggle and Download animated .glb, and its viewer now skins on the GPU and plays glTF animations. v5.3.15 - Auto-rigging: SkinTokensRigger gives a generated character a skeleton and learned skin weights in one pass (VAST AI SkinTokens, MIT, re-implemented on ILGPU; 5.8 s on CUDA, runs in the browser on WebGPU; 295/296 tokens identical to the PyTorch reference, skin weights 5.7e-5), UniRigRigger is the smaller skeleton + skinning-prior alternative, and the Image to 3D demo has a Rig this model button. v5.3.14 - TRELLIS.2 meshes are cleaned up before they are simplified and unwrapped (MeshRepair, on by default: non-manifold edges, winding, small holes, floating fragments). v5.3.13 -Browser storage is not capped at 10 GB: Chrome's navigator.storage.estimate() reports usage + 10 GiB, not a limit (BrowserStorageEstimate, RangeStreamModelSource plans every file for the cache and falls back to streaming only when the browser really refuses a write). v5.3.12 -SentencePiece honours the GGUF tokenizer.ggml.add_space_prefix flag (Gemma 2/3 multi-turn chat fixed: no stray space token at turn boundaries). v5.3.11 -Image and text to 3D (TRELLIS.2: photo or prompt -> PBR GLB) on CUDA (tensor cores), OpenCL, CPU and in the browser on WebGPU (portable tiled GEMM + flash attention, device mesh clustering, checkpoint streaming / per-file OPFS caching, background pipeline builds). Face detection and recognition (YuNet + SFace, matched against OpenCV). Requires SpawnDev.ILGPU 5.3.8. See CHANGELOG.md.</PackageReleaseNotes>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>Embedded</DebugType>
		<Title>SpawnDev.ILGPU.ML</Title>
		<Authors>LostBeard</Authors>
		<Description>Hardware-agnostic machine learning infrastructure for .NET. Implements high-performance neural network layers in C# that transpile to WebGPU, CUDA, OpenCL, and WebGL via SpawnDev.ILGPU. Optimized for Blazor WebAssembly and native GPU execution.</Description>
		<PackageProjectUrl>https://github.com/LostBeard/SpawnDev.ILGPU.ML</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon-128.png</PackageIcon>
		<RepositoryUrl>https://github.com/LostBeard/SpawnDev.ILGPU.ML.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Blazor;BlazorWebAssembly;WebGPU;WebGL;WebAssembly;WebWorkers;GPGPU;ILGPU;ParallelProcessing;Cuda;OpenCL;ComputeShader;CrossPlatform;MachineLearning</PackageTags>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>
		<IsPackable>true</IsPackable>
		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- Trim safe, enforced: the trim analyzer runs on every build and any trim (IL2xxx) warning fails it. -->
		<IsTrimmable>true</IsTrimmable>
		<EnableAotAnalyzer>true</EnableAotAnalyzer>
		<WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2057;IL2060;IL2062;IL2065;IL2067;IL2069;IL2070;IL2072;IL2073;IL2074;IL2075;IL2076;IL2077;IL2078;IL2080;IL2087;IL2088;IL2089;IL2090;IL2091;IL2092;IL2093;IL2094;IL2095;IL2106;IL2111;IL2112;IL2113;IL2114</WarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<None Include="Assets\icon-128.png" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SpawnDev.SpawnJS" Version="3.0.3" />
		<PackageReference Include="SpawnDev.ILGPU" Version="5.3.8" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
		<SupportedPlatform Include="windows" />
		<SupportedPlatform Include="linux" />
		<SupportedPlatform Include="macos" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Data\imagenet_classes.txt" />
	</ItemGroup>

  <ItemGroup>
    <!--
      The MIT English frontend. ZipVoice cannot speak English without a phonemizer - its shipped lexicon
      is Chinese-only - and the reference implementation reaches for espeak-ng (GPL-3) at that point.
      This is dependency-free and browser-capable, so it costs nothing to carry.
    -->
    <ProjectReference Include="..\SpawnDev.Phonemizer\SpawnDev.Phonemizer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- FaceDetectionPipeline.DetectBothWaysAsync: GPU decode vs the managed reference, for the parity test only -->
    <InternalsVisibleTo Include="SpawnDev.ILGPU.ML.Demo.Shared" />
  </ItemGroup>
</Project>
