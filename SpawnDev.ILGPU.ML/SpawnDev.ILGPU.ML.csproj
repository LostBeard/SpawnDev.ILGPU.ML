<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>5.2.3</Version>
		<PackageReleaseNotes>v5.2.3 - FIX: AudioPreprocessor.Resample had NO anti-aliasing filter. It was bare linear interpolation, carrying its own comment conceding "for production quality, consider using a proper sinc resampler". Linear interpolation does not band-limit, so decimating 48 kHz microphone audio to the 16 kHz speech models want folded everything from 8-24 kHz back on top of the speech, where sibilants and fricatives live. MEASURED on 5.2.2: a 10 kHz tone resampled 48k->16k survived at FULL amplitude (0.500 of a 0.500 source) as 6000 Hz, inside the band the mel spectrogram reads - so Whisper answered microphone audio with fluent, confident, entirely unrelated text. Any consumer resampling audio was affected. Now a windowed-sinc kernel (Blackman, 8 lobes) whose cutoff is the decimation ratio, precomputed per output phase - 48k->16k reduces to a single phase, so the trig leaves the hot path without changing an output value. No test caught it even though one exercised the method: AudioPreprocessor_Resample_Frequency resampled 44100->16000 but asserted only output LENGTH and that values sit in [-1.1, 1.1], and its 440 Hz input was far below the destination Nyquist, so it ran the real conversion and could not fail. ADDED: real microphone capture - MediaStreamCapture.OnAudioReady was DECLARED and never raised, and the only capture call was GetUserMedia(video: true, audio: false). StartMicrophoneAsync now delivers mono float32 via MediaStreamTrackProcessor at the device native rate, with OnAudioError/LastAudioError and a frame-buffer depth so a stalled WASM thread cannot silently drop audio; MediaInterop.FromAudioDataAsync converts a WebCodecs AudioData frame and THROWS on an unknown format rather than returning silence. /whisper now records, transcribes, and passes the decoder_with_past session. See Changelog.</PackageReleaseNotes>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>Embedded</DebugType>
		<Title>SpawnDev.ILGPU.ML</Title>
		<Authors>LostBeard</Authors>
		<Description>Hardware-agnostic machine learning infrastructure for .NET. Implements high-performance neural network layers in C# that transpile to WebGPU, CUDA, OpenCL, and WebGL via SpawnDev.ILGPU. Optimized for Blazor WebAssembly and native GPU execution.</Description>
		<PackageProjectUrl>https://github.com/LostBeard/SpawnDev.ILGPU.ML</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon-128.png</PackageIcon>
		<RepositoryUrl>https://github.com/LostBeard/SpawnDev.ILGPU.ML.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Blazor;BlazorWebAssembly;WebGPU;WebGL;WebAssembly;WebWorkers;GPGPU;ILGPU;ParallelProcessing;Cuda;OpenCL;ComputeShader;CrossPlatform;MachineLearning</PackageTags>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>
		<IsPackable>true</IsPackable>
		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<None Include="Assets\icon-128.png" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SpawnDev.SpawnJS" Version="2.1.9" />
		<PackageReference Include="SpawnDev.ILGPU" Version="5.2.4" />
		<PackageReference Include="SpawnDev.WebTorrent" Version="4.2.2" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
		<SupportedPlatform Include="windows" />
		<SupportedPlatform Include="linux" />
		<SupportedPlatform Include="macos" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Data\imagenet_classes.txt" />
	</ItemGroup>

  <ItemGroup>
    <!--
      The MIT English frontend. ZipVoice cannot speak English without a phonemizer - its shipped lexicon
      is Chinese-only - and the reference implementation reaches for espeak-ng (GPL-3) at that point.
      This is dependency-free and browser-capable, so it costs nothing to carry.
    -->
    <ProjectReference Include="..\SpawnDev.Phonemizer\SpawnDev.Phonemizer.csproj" />
  </ItemGroup>
</Project>
