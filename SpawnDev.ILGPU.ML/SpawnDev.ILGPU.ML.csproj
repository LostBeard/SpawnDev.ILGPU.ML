<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>5.8.10</Version>
		<PackageReleaseNotes>v5.8.10 - faster decode on CUDA (and WebGPU attention), accuracy unchanged: qwen3:1.7b Q4_K_M on an RTX 4070 decodes at ~213 tok/s at a short prompt and ~200 at an 1,800-token prompt (5.8.9: ~192 / ~160). CUDA decode GEMVs: F16 one output a warp (2x a GEMV), Q6_K split along K (+35% bandwidth on ffn_down); the fused residual Add + RMSNorm reduces with warp shuffles in double. Decode attention: CUDA now runs the vector kernel (16-byte K loads) with four-ahead P.V and warp-shuffle reductions (also WebGPU with subgroups), and the chunk merge runs a group per row and head (long-prompt attention 38.5 + 16.0 us -&gt; 23.0 + 3.1 us a layer). Every attention variant is bit-identical to the kernel it replaces (new GgufBatchDecoder_ShuffleAttention_BitIdentical, red-checked). Env switches (GGUF_ATTN_VEC / _ILP / _SHUFFLE / _COMBINE_GROUP, GGUF_F16_VEC_ROWS, GGUF_Q6_VEC_SPLIT, GGUF_RMS_SHUFFLE) are the A/B. See CHANGELOG.md.</PackageReleaseNotes>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>Embedded</DebugType>
		<Title>SpawnDev.ILGPU.ML</Title>
		<Authors>LostBeard</Authors>
		<Description>Hardware-agnostic machine learning infrastructure for .NET. Implements high-performance neural network layers in C# that transpile to WebGPU, CUDA, OpenCL, and WebGL via SpawnDev.ILGPU. Optimized for Blazor WebAssembly and native GPU execution.</Description>
		<PackageProjectUrl>https://github.com/LostBeard/SpawnDev.ILGPU.ML</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon-128.png</PackageIcon>
		<RepositoryUrl>https://github.com/LostBeard/SpawnDev.ILGPU.ML.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Blazor;BlazorWebAssembly;WebGPU;WebGL;WebAssembly;WebWorkers;GPGPU;ILGPU;ParallelProcessing;Cuda;OpenCL;ComputeShader;CrossPlatform;MachineLearning</PackageTags>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>
		<IsPackable>true</IsPackable>
		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- Trim safe, enforced: the trim analyzer runs on every build and any trim (IL2xxx) warning fails it. -->
		<IsTrimmable>true</IsTrimmable>
		<EnableAotAnalyzer>true</EnableAotAnalyzer>
		<WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2057;IL2060;IL2062;IL2065;IL2067;IL2069;IL2070;IL2072;IL2073;IL2074;IL2075;IL2076;IL2077;IL2078;IL2080;IL2087;IL2088;IL2089;IL2090;IL2091;IL2092;IL2093;IL2094;IL2095;IL2106;IL2111;IL2112;IL2113;IL2114</WarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<None Include="Assets\icon-128.png" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SpawnDev.SpawnJS" Version="3.0.8" />
		<PackageReference Include="SpawnDev.ILGPU" Version="5.4.24" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
		<SupportedPlatform Include="windows" />
		<SupportedPlatform Include="linux" />
		<SupportedPlatform Include="macos" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Data\imagenet_classes.txt" />
	</ItemGroup>

  <ItemGroup>
    <!--
      The MIT English frontend. ZipVoice cannot speak English without a phonemizer - its shipped lexicon
      is Chinese-only - and the reference implementation reaches for espeak-ng (GPL-3) at that point.
      This is dependency-free and browser-capable, so it costs nothing to carry.
    -->
    <ProjectReference Include="..\SpawnDev.Phonemizer\SpawnDev.Phonemizer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- FaceDetectionPipeline.DetectBothWaysAsync: GPU decode vs the managed reference, for the parity test only -->
    <InternalsVisibleTo Include="SpawnDev.ILGPU.ML.Demo.Shared" />
  </ItemGroup>
	<!-- A stable package must carry its own release notes: 5.8.2 - 5.8.4 shipped 5.8.1's (found by Data on nuget.org, 2026-11-06). -local builds are exempt. -->
	<Target Name="CheckReleaseNotesMatchVersion" BeforeTargets="GenerateNuspec" Condition="!$(Version.Contains('-'))">
		<Error Condition="!$(PackageReleaseNotes.StartsWith('v$(Version) '))" Text="PackageReleaseNotes must start with 'v$(Version) ' for a stable package; it starts '$(PackageReleaseNotes.Substring(0, 12))'. Update the notes in SpawnDev.ILGPU.ML.csproj." />
	</Target>
</Project>
