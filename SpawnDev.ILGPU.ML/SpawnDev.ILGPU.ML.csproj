<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>5.8.33</Version>
		<PackageReleaseNotes>v5.8.33 - on SpawnDev.ILGPU 5.4.53. WebGPU: a captured replay ends with its submit instead of a GPU wait (Chrome charges ~2.9 ms per waited submit): MobileNetV2 captured replay with readback 8.0 to 5.1 ms. Convolutions: a 32x32-tile implicit-GEMM kernel for small grids, bit-identical to the 64x64 kernel (MobileNetV2 WebGPU GPU time 1.58 to 1.24 ms, desktop 3x3 at 7x7 1.8x; on by default on the desktop, off in the browser where it costs a first run 72 ms). Model stores: a sidecar that cannot be read throws instead of reading as no record (a scanner holding it made a complete model re-download from byte 0); atomic sidecar writes. ModelResidency: a lazy model is measured at its own first run, not charged for models that load after it in the same prompt.</PackageReleaseNotes>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>Embedded</DebugType>
		<Title>SpawnDev.ILGPU.ML</Title>
		<Authors>LostBeard</Authors>
		<Description>Hardware-agnostic machine learning infrastructure for .NET. Implements high-performance neural network layers in C# that transpile to WebGPU, CUDA, OpenCL, and WebGL via SpawnDev.ILGPU. Optimized for Blazor WebAssembly and native GPU execution.</Description>
		<PackageProjectUrl>https://github.com/LostBeard/SpawnDev.ILGPU.ML</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon-128.png</PackageIcon>
		<RepositoryUrl>https://github.com/LostBeard/SpawnDev.ILGPU.ML.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Blazor;BlazorWebAssembly;WebGPU;WebGL;WebAssembly;WebWorkers;GPGPU;ILGPU;ParallelProcessing;Cuda;OpenCL;ComputeShader;CrossPlatform;MachineLearning</PackageTags>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>
		<IsPackable>true</IsPackable>
		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- Trim safe, enforced: the trim analyzer runs on every build and any trim (IL2xxx) warning fails it. -->
		<IsTrimmable>true</IsTrimmable>
		<EnableAotAnalyzer>true</EnableAotAnalyzer>
		<WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2057;IL2060;IL2062;IL2065;IL2067;IL2069;IL2070;IL2072;IL2073;IL2074;IL2075;IL2076;IL2077;IL2078;IL2080;IL2087;IL2088;IL2089;IL2090;IL2091;IL2092;IL2093;IL2094;IL2095;IL2106;IL2111;IL2112;IL2113;IL2114</WarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<None Include="Assets\icon-128.png" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SpawnDev.SpawnJS" Version="3.0.8" />
		<PackageReference Include="SpawnDev.ILGPU" Version="5.4.53" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
		<SupportedPlatform Include="windows" />
		<SupportedPlatform Include="linux" />
		<SupportedPlatform Include="macos" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Data\imagenet_classes.txt" />
	</ItemGroup>

  <ItemGroup>
    <!--
      The MIT English frontend. ZipVoice cannot speak English without a phonemizer - its shipped lexicon
      is Chinese-only - and the reference implementation reaches for espeak-ng (GPL-3) at that point.
      This is dependency-free and browser-capable, so it costs nothing to carry.
    -->
    <ProjectReference Include="..\SpawnDev.Phonemizer\SpawnDev.Phonemizer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      The generated GPU kernels, in their own assembly so a browser AOT build can leave them to the interpreter (see that project and
      buildTransitive/SpawnDev.ILGPU.ML.targets). PrivateAssets="all": not a package dependency; its DLL and XML ship in THIS package's lib folder
      (PackKernelsAssembly below), so consumers see one package.
    -->
    <ProjectReference Include="..\SpawnDev.ILGPU.ML.Kernels\SpawnDev.ILGPU.ML.Kernels.csproj" PrivateAssets="all" />
    <None Include="buildTransitive\SpawnDev.ILGPU.ML.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);PackKernelsAssembly</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <Target Name="PackKernelsAssembly" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_MlKernelsDll Include="@(ReferenceCopyLocalPaths->WithMetadataValue('Filename', 'SpawnDev.ILGPU.ML.Kernels')->WithMetadataValue('Extension', '.dll'))" />
      <!-- the XML from beside the DLL in that project's output (it is not in ReferenceCopyLocalPaths at this point) -->
      <_MlKernelsXml Include="@(_MlKernelsDll->'%(RootDir)%(Directory)%(Filename).xml')" />
      <BuildOutputInPackage Include="@(_MlKernelsDll);@(_MlKernelsXml)" />
    </ItemGroup>
    <Error Condition="'@(_MlKernelsDll)' == ''" Text="SpawnDev.ILGPU.ML.Kernels.dll was not found to pack into SpawnDev.ILGPU.ML" />
    <Error Condition="!Exists('@(_MlKernelsXml)')" Text="SpawnDev.ILGPU.ML.Kernels.xml was not found beside @(_MlKernelsDll)" />
  </Target>
  <ItemGroup>
    <!-- FaceDetectionPipeline.DetectBothWaysAsync: GPU decode vs the managed reference, for the parity test only -->
    <InternalsVisibleTo Include="SpawnDev.ILGPU.ML.Demo.Shared" />
  </ItemGroup>
	<!-- A stable package must carry its own release notes: 5.8.2 - 5.8.4 shipped 5.8.1's (found by Data on nuget.org, 2026-11-06). -local builds are exempt. -->
	<Target Name="CheckReleaseNotesMatchVersion" BeforeTargets="GenerateNuspec" Condition="!$(Version.Contains('-'))">
		<Error Condition="!$(PackageReleaseNotes.StartsWith('v$(Version) '))" Text="PackageReleaseNotes must start with 'v$(Version) ' for a stable package; it starts '$(PackageReleaseNotes.Substring(0, 12))'. Update the notes in SpawnDev.ILGPU.ML.csproj." />
	</Target>
</Project>
