<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!--
      NO dependencies, deliberately. This is the piece the open TTS ecosystem is missing: every model
      worth running (ZipVoice, Piper, Kokoro) phonemizes through espeak-ng, which is GPL-3, and that one
      dependency is why there is no permissively licensed English TTS frontend for .NET. It must stay
      loadable in a browser, so it takes nothing from ILGPU, nothing from ML, and nothing from the BCL
      beyond what WASM already carries.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      PUBLISHED as its own package, for two reasons.

      The forced one: SpawnDev.ILGPU.ML is packable and ProjectReferences this, so `pack` declares a
      dependency on "SpawnDev.Phonemizer" whether or not such a package exists. Shipping ILGPU.ML while
      this was unpublished would have given every consumer NU1101 on restore.

      The right one: this is useful on its own. It is the MIT English text-to-phoneme frontend that the
      open .NET TTS ecosystem is missing - ZipVoice, Piper and Kokoro all phonemize through espeak-ng,
      which is GPL-3. Zero dependencies, browser-capable, data embedded. Tying it to an ML runtime nobody
      needs for text-to-phonemes would be the wrong shape.
    -->
    <Version>1.0.0</Version>
    <PackageReleaseNotes>v1.0.0 - First release. MIT English grapheme-to-phoneme: CMUdict lookup, morphological decomposition, and learned letter-to-sound for unknown words. Replaces GPL-3 espeak-ng as a TTS frontend.</PackageReleaseNotes>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <EmbedAllSources>true</EmbedAllSources>
    <DebugType>Embedded</DebugType>
    <Title>SpawnDev.Phonemizer</Title>
    <Authors>LostBeard</Authors>
    <Description>MIT-licensed English grapheme-to-phoneme (text to phoneme) for .NET, with no dependencies and no native binaries. A permissive replacement for GPL-3 espeak-ng as a text-to-speech frontend: CMUdict pronunciation lookup, morphological decomposition for unknown words, and letter-to-sound rules LEARNED from CMUdict and measured on held-out words. Outputs ARPAbet or IPA with stress. Runs in Blazor WebAssembly - the dictionary and rules are embedded in the assembly.</Description>
    <PackageProjectUrl>https://github.com/LostBeard/SpawnDev.ILGPU.ML</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <RepositoryUrl>https://github.com/LostBeard/SpawnDev.ILGPU.ML.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Phonemizer;GraphemeToPhoneme;G2P;TextToSpeech;TTS;IPA;ARPAbet;CMUdict;Blazor;BlazorWebAssembly;WebAssembly;Speech;NLP</PackageTags>
    <NoPackageAnalysis>true</NoPackageAnalysis>
  </PropertyGroup>

  <ItemGroup>
    <!--
      THIRD-PARTY-NOTICES.md is not optional packaging polish: CMUdict is BSD-2-Clause, whose terms
      require the copyright notice and disclaimer to travel with binary distributions. The dictionary and
      the learned letter-to-sound model are both derived from it, so the notice ships in the nupkg.
    -->
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <!--
      The data travels INSIDE the assembly, gzipped. A phonemizer that needs files fetched from
      somewhere is not really dependency-free, and in a browser it is one more thing to host and
      version. 915 KB and 340 KB, against models measured in hundreds of megabytes elsewhere here.
    -->
    <EmbeddedResource Include="cmudict.dict.gz" />
    <EmbeddedResource Include="lts-model.txt.gz" />
  </ItemGroup>
</Project>
