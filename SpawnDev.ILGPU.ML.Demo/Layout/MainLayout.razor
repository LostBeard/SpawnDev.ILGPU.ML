@inherits LayoutComponentBase
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://github.com/LostBeard/SpawnDev.ILGPU.ML" target="_blank">GitHub</a>
            <a href="https://www.nuget.org/packages/SpawnDev.ILGPU.ML" target="_blank">NuGet</a>
        </div>

        <article class="content px-4">
            @* every route, not only the DemoLayout pages: /ai-chat (a 0.7-4 GB GGUF), /self-consistency, /inspector, /models, /getting-started and /cache
               download through the same HubModelSource without DemoLayout, so they showed no bar (driven 2026-11-27) *@
            <ActiveDownloadsBar />
            @Body
        </article>

        <footer class="global-footer px-4">
            <div class="footer-ecosystem">
                <span class="footer-label">SpawnDev Ecosystem:</span>
                <a href="https://github.com/LostBeard/SpawnDev.SpawnJS" target="_blank">SpawnJS</a>
                <span class="footer-dot">&middot;</span>
                <a href="https://github.com/LostBeard/SpawnDev.ILGPU" target="_blank">ILGPU</a>
                <span class="footer-dot">&middot;</span>
                <a href="https://github.com/LostBeard/SpawnDev.ILGPU.ML" target="_blank">ILGPU.ML</a>
            </div>
            <div class="footer-credit">
                Built upon <a href="https://github.com/m4rs-mt/ILGPU" target="_blank">ILGPU</a>
                by <a href="https://github.com/m4rs-mt" target="_blank">Marcel Koester</a> and contributors.
            </div>
        </footer>
    </main>

    <KeyboardShortcuts />
    <WelcomeToast />
</div>

@inject SpawnDev.SpawnJS.SpawnJSRuntime JS

@code {
    private static bool _buildTracked;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && !_buildTracked)
        {
            _buildTracked = true;
            BuildChangeTracker.PrintDiff(JS);
        }
    }
}
