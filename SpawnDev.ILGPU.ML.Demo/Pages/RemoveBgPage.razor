@page "/remove-bg"
@using SpawnDev.BlazorJS
@using SpawnDev.ILGPU.ML
@using SpawnDev.ILGPU.WebGPU
@using SpawnDev.ILGPU.WebGPU.Backend
@implements IDisposable

<PageTitle>Background Removal — SpawnDev.ILGPU.ML</PageTitle>

<DemoLayout Title="Background Removal"
            Description="Remove image backgrounds instantly. No server, no upload — your images stay on your device."
            AvailableBackends="@_backends"
            SelectedBackend="@_selectedBackend"
            SelectedBackendChanged="@((v) => _selectedBackend = v)"
            OnBackendChange="@HandleBackendChange"
            InferenceTimeMs="@_inferenceMs"
            IsRunning="@_isRunning"
            ShowModelProgress="true"
            ModelName="RMBG-1.4"
            IsModelLoading="@_isModelLoading"
            IsModelLoaded="@_isModelLoaded"
            ModelProgressPercent="@_modelProgress"
            ModelSizeMB="40">

    @if (_resultImageUrl != null && _imageDataUrl != null)
    {
        <div class="rmbg-output-controls">
            <label class="bg-option-label">Background:</label>
            <button class="bg-option @(_bgMode == "transparent" ? "active" : "")" @onclick='() => SetBgMode("transparent")'>Transparent</button>
            <button class="bg-option @(_bgMode == "white" ? "active" : "")" @onclick='() => SetBgMode("white")'>White</button>
            <button class="bg-option @(_bgMode == "blur" ? "active" : "")" @onclick='() => SetBgMode("blur")'>Blur</button>
        </div>

        <BeforeAfterSlider BeforeImageUrl="@_imageDataUrl"
                           AfterImageUrl="@_resultImageUrl"
                           BeforeLabel="Original"
                           AfterLabel="Removed"
                           AfterHasTransparency="@(_bgMode == "transparent")" />

        <div class="rmbg-actions">
            <button class="download-btn" @onclick="DownloadResult">Download PNG</button>
        </div>
    }
    else
    {
        <ImageDropZone @bind-ImageDataUrl="_imageDataUrl"
                       OnImageLoaded="@HandleImageLoaded"
                       SampleImages="@_samples" />
    }

    @if (_imageDataUrl != null && _resultImageUrl == null && _isModelLoaded && !_isRunning)
    {
        <button class="run-btn" @onclick="RunRemoval">Remove Background</button>
    }

    @if (!_isModelLoaded && !_isModelLoading)
    {
        <div class="model-needed">
            Loading RMBG-1.4 (~44MB) from HuggingFace CDN. Model will be cached locally after first download.
        </div>
    }

    <PrivacyBadge />

</DemoLayout>

<style>
    .rmbg-output-controls {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-bottom: 1rem;
    }

    .bg-option-label {
        color: #64748b;
        font-size: 0.85rem;
        margin-right: 0.25rem;
    }

    .bg-option {
        padding: 0.3rem 0.7rem;
        border-radius: 6px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(255, 255, 255, 0.04);
        color: #94a3b8;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .bg-option.active {
        background: rgba(139, 92, 246, 0.2);
        border-color: rgba(139, 92, 246, 0.4);
        color: #e2e8f0;
    }

    .bg-option:hover:not(.active) {
        background: rgba(255, 255, 255, 0.08);
    }

    .rmbg-actions {
        margin-top: 1rem;
        display: flex;
        gap: 0.5rem;
    }

    .download-btn {
        padding: 0.5rem 1.2rem;
        border-radius: 8px;
        border: 1px solid rgba(52, 211, 153, 0.3);
        background: rgba(52, 211, 153, 0.1);
        color: #6ee7b7;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .download-btn:hover {
        background: rgba(52, 211, 153, 0.2);
        transform: translateY(-1px);
    }

    .run-btn {
        margin-top: 1rem;
        padding: 0.6rem 1.5rem;
        border-radius: 8px;
        border: none;
        background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
        color: white;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .model-needed {
        margin-top: 1rem;
        padding: 0.75rem 1rem;
        background: rgba(245, 158, 11, 0.08);
        border: 1px solid rgba(245, 158, 11, 0.2);
        border-radius: 8px;
        color: #fbbf24;
        font-size: 0.85rem;
    }

    .run-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(59, 130, 246, 0.3);
    }
</style>

@code {
    private string _selectedBackend = "WebGPU";
    private string? _imageDataUrl;
    private string? _resultImageUrl;
    private string _bgMode = "transparent";
    private bool _isRunning;
    private bool _isModelLoading;
    private bool _isModelLoaded;
    private double _modelProgress;
    private double _inferenceMs;

    private List<BackendSelector.BackendInfo> _backends = new()
    {
        new() { Id = "WebGPU", DisplayName = "WebGPU" },
        new() { Id = "WebGL", DisplayName = "WebGL" },
        new() { Id = "Wasm", DisplayName = "Wasm (CPU)" },
    };

    private List<ImageDropZone.SampleImage> _samples = new()
    {
        new() { Label = "Portrait", Url = "samples/portrait.jpg" },
        new() { Label = "Dog", Url = "samples/dog.jpg" },
    };

    [Inject] BlazorJS.BlazorJSRuntime JS { get; set; } = default!;

    private global::ILGPU.Runtime.Accelerator? _accelerator;
    private global::ILGPU.Context? _context;
    private SpawnDev.ILGPU.ML.Pipelines.BackgroundRemovalPipeline? _pipeline;
    private int[]? _rgbaPixels;
    private int _imageWidth, _imageHeight;
    // Cache last mask + cutout RGB so bg-mode buttons can re-composite without re-running inference.
    private float[]? _lastMask;
    private int _lastMaskWidth, _lastMaskHeight;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await LoadModelAsync();
    }

    private async Task LoadModelAsync()
    {
        try
        {
            _isModelLoading = true;
            StateHasChanged();

            if (_context == null)
            {
                var builder = SpawnDev.ILGPU.ML.MLContext.Create();
                await builder.AllAcceleratorsAsync();
                _context = builder.ToContext();
            }

            _accelerator = await CreateAcceleratorForBackendAsync(_selectedBackend);
            if (_accelerator == null)
            {
                Console.WriteLine($"[RemoveBg] No {_selectedBackend} device available");
                _isModelLoading = false; StateHasChanged(); return;
            }

            using var hub = new SpawnDev.ILGPU.ML.Hub.ModelHub(JS);
            var modelBytes = await hub.LoadAsync(
                SpawnDev.ILGPU.ML.Hub.ModelHub.KnownModels.RMBG14,
                SpawnDev.ILGPU.ML.Hub.ModelHub.KnownFiles.OnnxModel);
            var session = SpawnDev.ILGPU.ML.InferenceSession.CreateFromFile(_accelerator, modelBytes);
            _pipeline = new SpawnDev.ILGPU.ML.Pipelines.BackgroundRemovalPipeline(session, _accelerator);

            _isModelLoaded = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemoveBg] Error: {ex.Message}");
        }
        finally
        {
            _isModelLoading = false;
            StateHasChanged();
        }
    }

    private async Task<global::ILGPU.Runtime.Accelerator?> CreateAcceleratorForBackendAsync(string backendId)
    {
        if (_context == null) return null;
        try
        {
            return backendId switch
            {
                "WebGPU" => await TryCreateAsync<WebGPUILGPUDevice>(),
                "WebGL"  => await TryCreateAsync<SpawnDev.ILGPU.WebGL.WebGLILGPUDevice>(),
                "Wasm"   => await TryCreateAsync<SpawnDev.ILGPU.Wasm.WasmILGPUDevice>(),
                _ => null,
            };
        }
        catch { return null; }
    }

    private async Task<global::ILGPU.Runtime.Accelerator?> TryCreateAsync<TDevice>() where TDevice : global::ILGPU.Runtime.Device
    {
        var devices = _context!.GetDevices<TDevice>();
        return devices.Count > 0 ? await devices[0].CreateAcceleratorAsync(_context) : null;
    }

    private async Task HandleBackendChange(string backend)
    {
        if (backend == _selectedBackend && _isModelLoaded) return;
        _selectedBackend = backend;
        _resultImageUrl = null;
        _lastMask = null;
        _pipeline?.Dispose();
        _accelerator?.Dispose();
        _pipeline = null;
        _accelerator = null;
        await LoadModelAsync();
    }

    private void SetBgMode(string mode)
    {
        if (_bgMode == mode) return;
        _bgMode = mode;
        // Re-composite from cached mask + source pixels — no inference re-run.
        RebuildResultImage();
        StateHasChanged();
    }

    private void RebuildResultImage()
    {
        if (_lastMask == null || _rgbaPixels == null) return;
        int w = _lastMaskWidth, h = _lastMaskHeight;
        int[] composed = _bgMode switch
        {
            "white" => CompositeOver(_rgbaPixels, _lastMask, w, h, 0xFFFFFF),
            "blur"  => CompositeOverBlur(_rgbaPixels, _lastMask, w, h),
            _        => ApplyAlpha(_rgbaPixels, _lastMask, w, h),
        };
        _resultImageUrl = Services.ImageDisplayHelper.ToDataUrl(JS, composed, w, h);
    }

    private static int[] ApplyAlpha(int[] src, float[] mask, int w, int h)
    {
        var dst = new int[w * h];
        for (int i = 0; i < w * h; i++)
        {
            int p = src[i];
            int a = (int)(mask[i] * 255f + 0.5f);
            if (a < 0) a = 0; if (a > 255) a = 255;
            dst[i] = (p & 0x00FFFFFF) | (a << 24);
        }
        return dst;
    }

    private static int[] CompositeOver(int[] src, float[] mask, int w, int h, int bgRgb)
    {
        int bgR = bgRgb & 0xFF, bgG = (bgRgb >> 8) & 0xFF, bgB = (bgRgb >> 16) & 0xFF;
        var dst = new int[w * h];
        for (int i = 0; i < w * h; i++)
        {
            int p = src[i];
            float a = mask[i]; if (a < 0f) a = 0f; if (a > 1f) a = 1f;
            int r = (int)((p & 0xFF) * a + bgR * (1f - a) + 0.5f);
            int g = (int)(((p >> 8) & 0xFF) * a + bgG * (1f - a) + 0.5f);
            int b = (int)(((p >> 16) & 0xFF) * a + bgB * (1f - a) + 0.5f);
            dst[i] = (r & 0xFF) | ((g & 0xFF) << 8) | ((b & 0xFF) << 16) | (0xFF << 24);
        }
        return dst;
    }

    private static int[] CompositeOverBlur(int[] src, float[] mask, int w, int h)
    {
        // Cheap 5x5 box blur of source, then composite cutout over the blurred copy.
        var blurred = BoxBlur5(src, w, h);
        var dst = new int[w * h];
        for (int i = 0; i < w * h; i++)
        {
            int p = src[i];
            int bg = blurred[i];
            float a = mask[i]; if (a < 0f) a = 0f; if (a > 1f) a = 1f;
            int r = (int)((p & 0xFF) * a + (bg & 0xFF) * (1f - a) + 0.5f);
            int g = (int)(((p >> 8) & 0xFF) * a + ((bg >> 8) & 0xFF) * (1f - a) + 0.5f);
            int b = (int)(((p >> 16) & 0xFF) * a + ((bg >> 16) & 0xFF) * (1f - a) + 0.5f);
            dst[i] = (r & 0xFF) | ((g & 0xFF) << 8) | ((b & 0xFF) << 16) | (0xFF << 24);
        }
        return dst;
    }

    private static int[] BoxBlur5(int[] src, int w, int h)
    {
        // 5x5 box blur — separable horizontal+vertical pass.
        var tmp = new int[w * h]; var dst = new int[w * h];
        for (int y = 0; y < h; y++)
            for (int x = 0; x < w; x++)
            {
                int rS = 0, gS = 0, bS = 0, n = 0;
                for (int k = -2; k <= 2; k++)
                {
                    int xs = x + k; if (xs < 0) xs = 0; if (xs >= w) xs = w - 1;
                    int p = src[y * w + xs];
                    rS += p & 0xFF; gS += (p >> 8) & 0xFF; bS += (p >> 16) & 0xFF; n++;
                }
                tmp[y * w + x] = (rS / n) | ((gS / n) << 8) | ((bS / n) << 16);
            }
        for (int y = 0; y < h; y++)
            for (int x = 0; x < w; x++)
            {
                int rS = 0, gS = 0, bS = 0, n = 0;
                for (int k = -2; k <= 2; k++)
                {
                    int ys = y + k; if (ys < 0) ys = 0; if (ys >= h) ys = h - 1;
                    int p = tmp[ys * w + x];
                    rS += p & 0xFF; gS += (p >> 8) & 0xFF; bS += (p >> 16) & 0xFF; n++;
                }
                dst[y * w + x] = (rS / n) | ((gS / n) << 8) | ((bS / n) << 16) | (0xFF << 24);
            }
        return dst;
    }

    private async Task HandleImageLoaded(byte[] imageBytes)
    {
        _resultImageUrl = null;
        try
        {
            using var blob = new SpawnDev.BlazorJS.JSObjects.Blob(
                new[] { imageBytes }, new SpawnDev.BlazorJS.JSObjects.BlobOptions { Type = "image/jpeg" });
            using var window = JS.Get<SpawnDev.BlazorJS.JSObjects.Window>("window");
            using var bitmap = await window.CreateImageBitmap(blob);
            int w = (int)bitmap.Width; int h = (int)bitmap.Height;
            using var canvas = new SpawnDev.BlazorJS.JSObjects.HTMLCanvasElement();
            canvas.Width = w; canvas.Height = h;
            using var ctx = canvas.Get2DContext();
            ctx.DrawImage(bitmap, 0, 0, w, h);
            using var imageData = ctx.GetImageData(0, 0, w, h);
            using var data = imageData.Data;
            _rgbaPixels = data.Read<int>();
            _imageWidth = w; _imageHeight = h;

            if (_isModelLoaded)
                await RunRemoval();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemoveBg] Image decode error: {ex.Message}");
        }
    }

    private async Task RunRemoval()
    {
        if (_pipeline == null || _rgbaPixels == null) return;
        _isRunning = true;
        StateHasChanged();
        await Task.Yield();

        try
        {
            var result = await _pipeline.RemoveBackgroundAsync(_rgbaPixels, _imageWidth, _imageHeight);
            _inferenceMs = result.InferenceTimeMs;
            // Cache mask + dims so bg-mode toggles can re-composite without re-running inference.
            _lastMask = result.Mask;
            _lastMaskWidth = result.Width;
            _lastMaskHeight = result.Height;
            // Diagnostic: mask statistics — helps confirm whether the backend produced a real mask.
            float min = float.PositiveInfinity, max = float.NegativeInfinity; double sum = 0;
            for (int i = 0; i < result.Mask.Length; i++)
            {
                var v = result.Mask[i];
                if (v < min) min = v; if (v > max) max = v; sum += v;
            }
            Console.WriteLine($"[RemoveBg] mask {_lastMaskWidth}x{_lastMaskHeight} min={min:F4} max={max:F4} avg={sum / result.Mask.Length:F4}");
            RebuildResultImage();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemoveBg] Error: {ex.Message}");
        }

        _isRunning = false;
        StateHasChanged();
    }

    private void DownloadResult()
    {
        if (_resultImageUrl == null) return;
        try
        {
            using var document = JS.Get<SpawnDev.BlazorJS.JSObjects.Document>("document");
            using var link = document.CreateElement<SpawnDev.BlazorJS.JSObjects.HTMLAnchorElement>("a");
            link.Href = _resultImageUrl;
            link.Download = "removed-bg.png";
            using var body = document.Body!;
            body.AppendChild(link);
            link.Click();
            body.RemoveChild(link);
        }
        catch { }
    }

    public void Dispose()
    {
        _pipeline?.Dispose();
        _accelerator?.Dispose();
        _context?.Dispose();
    }
}
