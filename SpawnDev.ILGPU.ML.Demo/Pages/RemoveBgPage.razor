@page "/remove-bg"
@using SpawnDev.SpawnJS
@using SpawnDev.ILGPU.ML
@using SpawnDev.ILGPU.WebGPU
@using SpawnDev.ILGPU.WebGPU.Backend
@implements IDisposable

<PageTitle>Background Removal — SpawnDev.ILGPU.ML</PageTitle>

<DemoLayout Title="Background Removal"
            Description="Remove image backgrounds instantly. No server, no upload — your images stay on your device."
            AvailableBackends="@_backends"
            SelectedBackend="@_selectedBackend"
            SelectedBackendChanged="@((v) => _selectedBackend = v)"
            OnBackendChange="@HandleBackendChange"
            InferenceTimeMs="@_inferenceMs"
            IsRunning="@_isRunning"
            ShowModelProgress="true"
            ModelName="RMBG-1.4"
            IsModelLoading="@_isModelLoading"
            IsModelLoaded="@_isModelLoaded"
            ModelProgressPercent="@_modelProgress"
            ModelSizeMB="40">

    @if (_resultImageUrl != null && _imageDataUrl != null)
    {
        <div class="rmbg-output-controls">
            <label class="bg-option-label">Background:</label>
            <button class="bg-option @(_bgMode == "transparent" ? "active" : "")" @onclick='() => SetBgMode("transparent")'>Transparent</button>
            <button class="bg-option @(_bgMode == "white" ? "active" : "")" @onclick='() => SetBgMode("white")'>White</button>
            <button class="bg-option @(_bgMode == "blur" ? "active" : "")" @onclick='() => SetBgMode("blur")'>Blur</button>
        </div>

        <BeforeAfterSlider BeforeImageUrl="@_imageDataUrl"
                           AfterImageUrl="@_resultImageUrl"
                           BeforeLabel="Original"
                           AfterLabel="Removed"
                           AfterHasTransparency="@(_bgMode == "transparent")" />

        <div class="rmbg-actions">
            <button class="download-btn" @onclick="DownloadResult">Download PNG</button>
        </div>
    }
    else
    {
        <ImageDropZone @bind-ImageDataUrl="_imageDataUrl"
                       OnImageLoaded="@HandleImageLoaded"
                       SampleImages="@_samples" />
    }

    @if (_imageDataUrl != null && _resultImageUrl == null && _isModelLoaded && !_isRunning)
    {
        <button class="run-btn" @onclick="RunRemoval">Remove Background</button>
    }

    @if (!_isModelLoaded && !_isModelLoading)
    {
        <div class="model-needed">
            Loading RMBG-1.4 (~44MB) from HuggingFace CDN. Model will be cached locally after first download.
        </div>
    }

    <PrivacyBadge />

    <PipelineHowTo SourceFile="Pages/RemoveBgPage.razor" Note="RMBG-1.4" />

</DemoLayout>

<style>
    .rmbg-output-controls {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-bottom: 1rem;
    }

    .bg-option-label {
        color: #64748b;
        font-size: 0.85rem;
        margin-right: 0.25rem;
    }

    .bg-option {
        padding: 0.3rem 0.7rem;
        border-radius: 6px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(255, 255, 255, 0.04);
        color: #94a3b8;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .bg-option.active {
        background: rgba(139, 92, 246, 0.2);
        border-color: rgba(139, 92, 246, 0.4);
        color: #e2e8f0;
    }

    .bg-option:hover:not(.active) {
        background: rgba(255, 255, 255, 0.08);
    }

    .rmbg-actions {
        margin-top: 1rem;
        display: flex;
        gap: 0.5rem;
    }

    .download-btn {
        padding: 0.5rem 1.2rem;
        border-radius: 8px;
        border: 1px solid rgba(52, 211, 153, 0.3);
        background: rgba(52, 211, 153, 0.1);
        color: #6ee7b7;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .download-btn:hover {
        background: rgba(52, 211, 153, 0.2);
        transform: translateY(-1px);
    }

    .run-btn {
        margin-top: 1rem;
        padding: 0.6rem 1.5rem;
        border-radius: 8px;
        border: none;
        background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
        color: white;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .model-needed {
        margin-top: 1rem;
        padding: 0.75rem 1rem;
        background: rgba(245, 158, 11, 0.08);
        border: 1px solid rgba(245, 158, 11, 0.2);
        border-radius: 8px;
        color: #fbbf24;
        font-size: 0.85rem;
    }

    .run-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(59, 130, 246, 0.3);
    }
</style>

@code {
    private string _selectedBackend = "WebGPU";
    private string? _imageDataUrl;
    private string? _resultImageUrl;
    private string _bgMode = "transparent";
    private bool _isRunning;
    private bool _isModelLoading;
    private bool _isModelLoaded;
    private double _modelProgress;
    private double _inferenceMs;

    private List<BackendSelector.BackendInfo> _backends = new()
    {
        new() { Id = "WebGPU", DisplayName = "WebGPU" },
        new() { Id = "WebGL", DisplayName = "WebGL" },
        new() { Id = "Wasm", DisplayName = "Wasm (CPU)" },
    };

    private List<ImageDropZone.SampleImage> _samples = new()
    {
        new() { Label = "Portrait", Url = "samples/portrait.jpg" },
        new() { Label = "Dog", Url = "samples/dog.jpg" },
    };

    [Inject] SpawnJS.SpawnJSRuntime JS { get; set; } = default!;
    [Inject] HttpClient Http { get; set; } = default!;

    private global::ILGPU.Runtime.Accelerator? _accelerator;
    private global::ILGPU.Context? _context;
    private SpawnDev.ILGPU.ML.Pipelines.BackgroundRemovalPipeline? _pipeline;
    // The picture stays in the browser (the Uint8ClampedArray of its ImageData) and goes to the GPU from there; the source and the cut-out stay on the device
    // so the background buttons re-composite without re-running inference or touching a pixel on the host.
    private SpawnDev.SpawnJS.JSObjects.ImageData? _imageData;
    private SpawnDev.SpawnJS.JSObjects.TypedArray? _imageBytes;
    private int _imageWidth, _imageHeight;
    private global::ILGPU.Runtime.MemoryBuffer1D<int, global::ILGPU.Stride1D.Dense>? _sourceDev, _cutDev;

    // OPT-IN: RMBG-1.4 is NOT downloaded/loaded on page entry. It loads on the first real
    // interaction (picking an image) — see HandleImageLoaded.

    private async Task LoadModelAsync()
    {
        try
        {
            _isModelLoading = true;
            StateHasChanged();

            if (_context == null)
            {
                var builder = SpawnDev.ILGPU.ML.MLContext.Create();
                await builder.AllAcceleratorsAsync();
                _context = builder.ToContext();
            }

            _accelerator = await CreateAcceleratorForBackendAsync(_selectedBackend);
            if (_accelerator == null)
            {
                Console.WriteLine($"[RemoveBg] No {_selectedBackend} device available");
                _isModelLoading = false; StateHasChanged(); return;
            }

            using var hub = new SpawnDev.ILGPU.ML.Hub.ModelHub(JS);
            // Weights are delivered as a LAZY-HASH torrent: streamable with random access, OPFS-cached
            // by piece, restored on reload with no re-download, and seeded to peers.
            var session = await SpawnDev.ILGPU.ML.InferenceSession.CreateFromHuggingFaceAsync(
                _accelerator, hub, SpawnDev.ILGPU.ML.Hub.ModelHub.KnownModels.RMBG14, SpawnDev.ILGPU.ML.Hub.ModelHub.KnownFiles.OnnxModel,
                http: Http);
            _pipeline = new SpawnDev.ILGPU.ML.Pipelines.BackgroundRemovalPipeline(session, _accelerator);

            _isModelLoaded = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemoveBg] Error: {ex.Message}");
        }
        finally
        {
            _isModelLoading = false;
            StateHasChanged();
        }
    }

    private async Task<global::ILGPU.Runtime.Accelerator?> CreateAcceleratorForBackendAsync(string backendId)
    {
        if (_context == null) return null;
        try
        {
            return backendId switch
            {
                "WebGPU" => await TryCreateAsync<WebGPUILGPUDevice>(),
                "WebGL"  => await TryCreateAsync<SpawnDev.ILGPU.WebGL.WebGLILGPUDevice>(),
                "Wasm"   => await TryCreateAsync<SpawnDev.ILGPU.Wasm.WasmILGPUDevice>(),
                _ => null,
            };
        }
        catch { return null; }
    }

    private async Task<global::ILGPU.Runtime.Accelerator?> TryCreateAsync<TDevice>() where TDevice : global::ILGPU.Runtime.Device
    {
        var devices = _context!.GetDevices<TDevice>();
        return devices.Count > 0 ? await devices[0].CreateAcceleratorAsync(_context) : null;
    }

    private async Task HandleBackendChange(string backend)
    {
        if (backend == _selectedBackend && _isModelLoaded) return;
        bool wasLoaded = _isModelLoaded;
        _selectedBackend = backend;
        _resultImageUrl = null;
        _cutDev?.Dispose(); _sourceDev?.Dispose(); _cutDev = null; _sourceDev = null;
        _pipeline?.Dispose();
        _accelerator?.Dispose();
        _pipeline = null;
        _accelerator = null;
        _isModelLoaded = false;
        // Opt-in: only re-load if the model was already loaded; switching backend before
        // first use must not trigger a download.
        if (wasLoaded)
            await LoadModelAsync();
        else
            StateHasChanged();
    }

    private async Task SetBgMode(string mode)
    {
        if (_bgMode == mode) return;
        _bgMode = mode;
        // Re-composite from the cut-out kept on the device: no inference re-run.
        await RebuildResultImage();
        StateHasChanged();
    }

    private async Task RebuildResultImage()
    {
        if (_cutDev == null || _accelerator == null) return;
        int w = _imageWidth, h = _imageHeight;
        var shown = _bgMode switch
        {
            "white" => await SpawnDev.ILGPU.ML.Preprocessing.ImageCompositor.OverColorAsync(_accelerator, _cutDev.View, w, h, 0xFFFFFF),
            "blur" => await SpawnDev.ILGPU.ML.Preprocessing.ImageCompositor.OverBlurAsync(_accelerator, _cutDev.View, w, h),
            _ => null,
        };
        using (shown)
        {
            var composed = await (shown ?? _cutDev).View.SubView(0, (long)w * h).CopyToHostAsync();
            _resultImageUrl = Services.ImageDisplayHelper.ToDataUrl(JS, composed, w, h);
        }
    }

    private async Task HandleImageLoaded(byte[] imageBytes)
    {
        _resultImageUrl = null;
        try
        {
            using var blob = new SpawnDev.SpawnJS.JSObjects.Blob(
                new[] { imageBytes }, new SpawnDev.SpawnJS.JSObjects.BlobOptions { Type = "image/jpeg" });
            using var window = JS.Get<SpawnDev.SpawnJS.JSObjects.Window>("window");
            using var bitmap = await window.CreateImageBitmap(blob);
            int w = (int)bitmap.Width; int h = (int)bitmap.Height;
            using var canvas = new SpawnDev.SpawnJS.JSObjects.HTMLCanvasElement();
            canvas.Width = w; canvas.Height = h;
            using var ctx = canvas.Get2DContext();
            ctx.DrawImage(bitmap, 0, 0, w, h);
            _imageBytes?.Dispose(); _imageData?.Dispose();
            _imageData = ctx.GetImageData(0, 0, w, h);
            _imageBytes = _imageData.Data;
            _imageWidth = w; _imageHeight = h;

            // Opt-in load: pull the model on first use (user picked an image), not on page entry.
            if (!_isModelLoaded && !_isModelLoading)
                await LoadModelAsync();
            if (_isModelLoaded)
                await RunRemoval();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemoveBg] Image decode error: {ex.Message}");
        }
    }

    private async Task RunRemoval()
    {
        if (_pipeline == null || _imageBytes == null || _accelerator == null) return;
        _isRunning = true;
        StateHasChanged();
        await Task.Yield();

        try
        {
            var sw = System.Diagnostics.Stopwatch.StartNew();
            _cutDev?.Dispose(); _sourceDev?.Dispose();
            _sourceDev = SpawnDev.ILGPU.ML.Preprocessing.RgbaUpload.FromTypedArray(_accelerator, _imageBytes, _imageWidth, _imageHeight);
            _cutDev = await _pipeline.RemoveBackgroundToDeviceAsync(_sourceDev.View, _imageWidth, _imageHeight);
            _inferenceMs = sw.Elapsed.TotalMilliseconds;
            Console.WriteLine($"[RemoveBg] {_imageWidth}x{_imageHeight} cut out in {_inferenceMs:F0} ms");
            await RebuildResultImage();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemoveBg] Error: {ex.Message}");
        }

        _isRunning = false;
        StateHasChanged();
    }

    private void DownloadResult()
    {
        if (_resultImageUrl == null) return;
        try
        {
            using var document = JS.Get<SpawnDev.SpawnJS.JSObjects.Document>("document");
            using var link = document.CreateElement<SpawnDev.SpawnJS.JSObjects.HTMLAnchorElement>("a");
            link.Href = _resultImageUrl;
            link.Download = "removed-bg.png";
            using var body = document.Body!;
            body.AppendChild(link);
            link.Click();
            body.RemoveChild(link);
        }
        catch { }
    }

    public void Dispose()
    {
        _cutDev?.Dispose(); _sourceDev?.Dispose();
        _imageBytes?.Dispose(); _imageData?.Dispose();
        _pipeline?.Dispose();
        _accelerator?.Dispose();
        _context?.Dispose();
    }
}
