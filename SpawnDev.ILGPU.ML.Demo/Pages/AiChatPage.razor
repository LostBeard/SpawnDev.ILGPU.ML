@page "/ai-chat"
@using global::ILGPU.Runtime
@using SpawnDev.ILGPU.ML
@using SpawnDev.ILGPU.ML.Pipelines
@using SpawnDev.ILGPU.ML.Preprocessing
@using SpawnDev.ILGPU.ML.Hub
@using SpawnDev.WebTorrent
@using SpawnDev.BlazorJS
@implements IAsyncDisposable
@inject BlazorJSRuntime JS
@inject WebTorrentClient WebTorrent
@inject HttpClient Http

<PageTitle>AI Chat — on-device LLM</PageTitle>

<div class="ai-chat">
    <header class="hdr">
        <h1>AI Chat <span class="badge">100% on-device</span></h1>
        <p class="sub">Chat with a quantized GGUF language model running entirely in your browser on WebGPU — your
            text never leaves your device. The weights stream peer-to-peer from the SpawnDev hub and are cached
            in your browser; pick a model to begin.</p>
    </header>

    @if (_state == LoadState.Idle)
    {
        <div class="optin">
            <h2>Choose a model</h2>
            <p>
                The model downloads from the SpawnDev hub (pulled from Hugging Face, seeded over WebTorrent) and is
                cached in your browser — manage or evict it on the <a href="/cache">Model Cache</a> page. Loading
                starts streaming straight to the GPU as soon as the download begins; you don't wait for the full file.
            </p>
            <ul class="models picker-list">
                @foreach (var m in _models)
                {
                    <li class="@(m.Status == "ok" ? "ok" : m.Status == "warn" ? "warn" : "bad") selectable" @onclick="() => LoadModelAsync(m)">
                        <span class="dot"></span>
                        <span class="name">@m.Label</span>
                        <span class="meta">@m.Arch · @m.Size</span>
                        <span class="note">@m.Note</span>
                    </li>
                }
            </ul>
            <p class="fineprint">
                ✅ verified end-to-end (generates correctly on WebGPU); ⚠️ loads &amp; runs but output is being
                refined. First load of a model downloads it (hundreds of MB) — later loads use the browser cache.
            </p>
        </div>
    }
    else if (_state == LoadState.Loading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>@_status</p>
            <button class="link" @onclick="CancelLoad">Cancel</button>
        </div>
    }
    else if (_state == LoadState.Error)
    {
        <div class="error">
            <h2>Could not load the model</h2>
            <pre>@_status</pre>
            <button @onclick="BackToIdle">Back</button>
        </div>
    }
    else // Ready
    {
        <div class="chat">
            <div class="bar">
                <span class="model-tag">@_modelLabel <span class="fmt">@_arch · @_chatFormat</span></span>
                <span class="accel">@_acceleratorName</span>
                <button class="link" @onclick="ResetChat" disabled="@_busy">New conversation</button>
                <button class="link" @onclick="BackToIdle" disabled="@_busy">Switch model</button>
            </div>

            <div class="transcript" @ref="_transcriptRef">
                @foreach (var msg in _messages)
                {
                    <div class="msg @msg.Role">
                        <div class="who">@(msg.Role == "user" ? "You" : "Assistant")</div>
                        <div class="text">@msg.Content</div>
                    </div>
                }
                @if (_busy)
                {
                    <div class="msg assistant"><div class="who">Assistant</div><div class="text typing">@_streaming<span class="caret">▋</span></div></div>
                }
            </div>

            <div class="composer">
                <textarea @bind="_input" @bind:event="oninput" @onkeydown="OnKeyDown"
                          placeholder="Send a message…" disabled="@_busy" rows="1"></textarea>
                <button class="primary" @onclick="SendAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_input))">Send</button>
            </div>
        </div>
    }
</div>

@code {
    enum LoadState { Idle, Loading, Ready, Error }
    LoadState _state = LoadState.Idle;
    string _status = "";

    // The models served via the hub (Hugging Face GGUF repos, streamed over WebTorrent). HONEST status — see
    // DEMO_AND_MODEL_STATUS.md. Repo/File are the Hugging Face coordinates HubModelStream.OpenAsync streams.
    sealed record ModelOption(string Label, string Repo, string File, string Size, string Arch, string Status, string Note);
    readonly List<ModelOption> _models = new()
    {
        new("Qwen2.5 0.5B Instruct (Q8_0)", "Qwen/Qwen2.5-0.5B-Instruct-GGUF", "qwen2.5-0.5b-instruct-q8_0.gguf",
            "~0.5 GB", "qwen2", "ok", "✅ verified — coherent on WebGPU"),
        new("SmolLM2 360M Instruct (Q8_0)", "HuggingFaceTB/SmolLM2-360M-Instruct-GGUF", "smollm2-360m-instruct-q8_0.gguf",
            "~0.4 GB", "llama", "ok", "✅ verified — coherent (BPE tokenizer + RoPE NORM-style fix)"),
        new("Gemma 3 270M (Q8_0)", "ggml-org/gemma-3-270m-GGUF", "gemma-3-270m-Q8_0.gguf",
            "~0.3 GB", "gemma3", "ok", "✅ coherent — forward-pass fixed (CUDA-verified vs Ollama; WebGPU graph PMT-green)"),
    };

    ElementReference _transcriptRef;

    global::ILGPU.Context? _context;
    Accelerator? _accelerator;
    GgufTextGenerationPipeline? _pipeline;
    HubModelStream.HubModel? _openModel; // keep the hub stream alive for the session
    System.Threading.CancellationTokenSource? _loadCts;
    string _acceleratorName = "";
    string _modelLabel = "";
    string _arch = "";
    string _chatFormat = "";

    sealed class ChatMessage { public string Role = "user"; public string Content = ""; }
    readonly List<ChatMessage> _messages = new();

    string _input = "";
    bool _busy;
    string _streaming = "";

    async Task LoadModelAsync(ModelOption model)
    {
        _state = LoadState.Loading;
        _modelLabel = model.Label;
        _status = "Initializing WebGPU…";
        _loadCts = new System.Threading.CancellationTokenSource();
        await InvokeAsync(StateHasChanged);
        try
        {
            if (_accelerator == null)
            {
                var builder = MLContext.Create();
                await builder.AllAcceleratorsAsync();
                _context = builder.ToContext();
                _accelerator = await _context.CreatePreferredAcceleratorAsync();
                if (_accelerator == null) { Fail("No WebGPU accelerator is available in this browser."); await InvokeAsync(StateHasChanged); return; }
                _acceleratorName = $"{_accelerator.Name} ({_accelerator.AcceleratorType})";
                JS.Log($"[AiChat] accelerator: {_acceleratorName}");
            }

            // Stream the GGUF from the hub. The returned stream is SEEKABLE and downloads on demand — the weights
            // stream to the GPU AS the file downloads (no waiting for the whole file or for the hub to finish
            // caching). The torrent stays in the WebTorrent client's OPFS store for fast later loads (managed on
            // the /cache page).
            var hub = new HubModelStream(WebTorrent, Http) { PrepareTimeout = TimeSpan.FromMinutes(15) };
            _status = $"Streaming {model.Label} ({model.Size}) from the hub to the GPU…";
            await InvokeAsync(StateHasChanged);
            _openModel?.Stream.Dispose();
            _openModel = await hub.OpenAsync(model.Repo, model.File, deselect: false, _loadCts.Token);

            _pipeline = await GgufTextGenerationPipeline.CreateFromStreamAsync(_accelerator, _openModel.Stream,
                maxSeqLen: 4096,
                onProgress: (stage, pct) => { _status = $"{Humanize(stage)} {pct}%"; InvokeAsync(StateHasChanged); },
                ct: _loadCts.Token);
            _arch = _pipeline.Architecture;
            _chatFormat = _pipeline.ChatFormat.ToString();
            _messages.Clear();
            _state = LoadState.Ready;
            _status = "";
            JS.Log($"[AiChat] ready: {model.Label} arch={_arch} format={_chatFormat}");
        }
        catch (OperationCanceledException) { BackToIdle(); }
        catch (Exception ex)
        {
            JS.LogError($"[AiChat] load failed: {ex.GetType().Name}: {ex.Message}");
            Fail($"{ex.GetType().Name}: {ex.Message}");
        }
        await InvokeAsync(StateHasChanged);
    }

    static string Humanize(string stage) => stage switch
    {
        "parse" => "Reading model header",
        "build_graph" => "Building compute graph",
        "upload" or "weights" => "Streaming weights to GPU",
        _ => stage,
    };

    void Fail(string msg) { _status = msg; _state = LoadState.Error; }

    void CancelLoad() { _loadCts?.Cancel(); }

    void BackToIdle()
    {
        _pipeline?.Dispose();
        _pipeline = null;
        _openModel?.Stream.Dispose();
        _openModel = null;
        _messages.Clear();
        _state = LoadState.Idle;
        _status = "";
    }

    async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey) await SendAsync();
    }

    async Task SendAsync()
    {
        if (_busy || _pipeline == null || string.IsNullOrWhiteSpace(_input)) return;
        var text = _input.Trim();
        _input = "";
        _messages.Add(new ChatMessage { Role = "user", Content = text });
        _busy = true; _streaming = "";
        StateHasChanged();
        await ScrollToBottom();

        var convo = _messages.Select(m => (m.Role, m.Content)).ToList();
        try
        {
            string answer = await _pipeline.GenerateAsync(convo,
                config: new GenerationConfig { MaxNewTokens = 512, Strategy = "greedy" },
                onToken: (_, soFar) => { _streaming = soFar; InvokeAsync(async () => { StateHasChanged(); await ScrollToBottom(); }); return Task.CompletedTask; });
            _messages.Add(new ChatMessage { Role = "assistant", Content = answer.Trim() });
        }
        catch (Exception ex)
        {
            JS.LogError($"[AiChat] generate failed: {ex.Message}");
            _messages.Add(new ChatMessage { Role = "assistant", Content = $"[error: {ex.Message}]" });
        }
        _busy = false; _streaming = "";
        StateHasChanged();
        await ScrollToBottom();
    }

    void ResetChat() { _messages.Clear(); _streaming = ""; }

    async Task ScrollToBottom()
    {
        try { using var el = new SpawnDev.BlazorJS.JSObjects.HTMLElement(_transcriptRef); el.ScrollTop = el.ScrollHeight; }
        catch { /* transcript not mounted yet */ }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            _loadCts?.Cancel();
            _pipeline?.Dispose();
            // Keep the torrent in the WebTorrent client's OPFS store (fast later loads); just dispose our reader.
            _openModel?.Stream.Dispose();
            _accelerator?.Dispose();
            _context?.Dispose();
        }
        catch (Exception ex) { JS.LogError($"[AiChat] dispose: {ex.Message}"); }
        await Task.CompletedTask;
    }
}
