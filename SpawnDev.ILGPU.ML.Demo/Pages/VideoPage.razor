@page "/video"
@using SpawnDev.SpawnJS
@using SpawnDev.ILGPU.ML
@using SpawnDev.ILGPU.ML.Wan
@using SpawnDev.ILGPU.ML.Ltx
@implements IDisposable

<PageTitle>Video Generation - SpawnDev.ILGPU.ML</PageTitle>

<DemoLayout Title="Video Generation"
            Description="Generate video on your GPU, in this tab: from text, from a picture (or your camera), as a morph between two pictures, or by extending the clip you just made; watch it form step by step while it is denoised. LTX-Video 2B (a 2B transformer, 7 steps, the 0.9.8 two-pass recipe with its x2 latent upscaler) or Wan 2.2 TI2V-5B (5B, Turbo 4 steps, up to 1280x704), the 8-bit and 4-bit exports streamed from the SpawnDev models host. Everything runs on WebGPU; nothing leaves your machine."
            AvailableBackends="@_backends"
            SelectedBackend="@_selectedBackend"
            SelectedBackendChanged="@((v) => _selectedBackend = v)"
            OnBackendChange="@HandleBackendChange"
            InferenceTimeMs="@_inferenceMs"
            IsRunning="@_isRunning"
            ShowModelProgress="true"
            ModelName="@_modelStatusText"
            IsModelLoading="@_isModelLoading"
            IsModelLoaded="@_isModelLoaded"
            ModelProgressPercent="@_modelProgress"
            ModelSizeMB="@(Ltx ? 8100 : _dit is "q4" or "turbo_q4" ? 10900 : 13400)">

    <div class="vid-presets">
        <span class="vid-presets-label">Try one:</span>
        @foreach (var pr in Presets)
        {
            <button class="vid-preset" @onclick="@(() => UsePresetAsync(pr))" disabled="@(_isRunning || _isModelLoading)" title="@pr.Prompt">@pr.Label</button>
        }
    </div>

    <div class="vid-prompt-section">
        <label class="vid-label">@(_mode == "story" ? "Shots, one per line (each continues the clip from the last; the first can start from a picture):" : "Prompt:")</label>
        <div class="vid-prompt-row">
            <textarea class="vid-prompt-input" rows="@(_mode == "story" ? 5 : 3)" @bind="_prompt" @bind:event="oninput"
                      placeholder="Describe the scene and the motion: a red fox walking through fresh snow at golden hour, the camera follows it slowly, soft light, shallow depth of field."
                      disabled="@(_isModelLoading || _isRunning)"></textarea>
            <button class="vid-btn" @onclick="GenerateVideo"
                    disabled="@(string.IsNullOrWhiteSpace(_prompt) || _isModelLoading || Busy)">
                @(Busy ? "Generating..." : _isModelLoading ? "Loading..." : "Generate")
            </button>
        </div>

        <div class="vid-settings">
            <div class="vid-setting">
                <label>Model:</label>
                <select @bind="_model" @bind:after="ModelChanged" class="vid-select" disabled="@(_isRunning || _isModelLoading)" title="Wan 2.2 TI2V-5B: text to video and image to video, sharper, 4 to 50 steps. LTX-Video 2B: text or image to video, 7 steps (plus 3 at twice the size with the two-pass recipe), a much smaller transformer and a heavily compressed video, so clips are fast and cheap on memory.">
                    <option value="wan">Wan 2.2 TI2V-5B</option>
                    <option value="ltx">LTX-Video 2B (distilled, 7 steps)</option>
                </select>
            </div>
            <div class="vid-setting">
                <label>Size:</label>
                <select @bind="_size" class="vid-select" disabled="@_isRunning" title="@(Ltx ? "Multiples of 32. The model is native at 704x480; 480x320 is the first pass of its two-pass recipe and the fastest." : "The model was trained at 1280x704 (720p); small sizes are fast but show its limits, and some seeds fail at small sizes. The decoder and the 5B transformer need GPU memory in proportion to the size.")">
                    @if (Ltx)
                    {
                        <option value="480x320">480x320 (fastest)</option>
                        <option value="640x384">640x384</option>
                        <option value="704x480">704x480 (native)</option>
                    }
                    else
                    {
                        <option value="512x288">512x288 (fastest)</option>
                        <option value="640x352">640x352</option>
                        <option value="832x480">832x480</option>
                        <option value="1280x704">1280x704 (native, slow)</option>
                    }
                </select>
            </div>
            <div class="vid-setting">
                <label>Frames:</label>
                <select @bind="_frames" class="vid-select" disabled="@_isRunning" title="@(Ltx ? "24 frames per second; 8n + 1 frames" : "24 frames per second; 4n + 1 frames")">
                    @if (Ltx)
                    {
                        <option value="9">9 (0.4 s)</option>
                        <option value="17">17 (0.7 s)</option>
                        <option value="33">33 (1.4 s)</option>
                        <option value="49">49 (2 s)</option>
                        <option value="65">65 (2.7 s)</option>
                        <option value="97">97 (4 s)</option>
                    }
                    else
                    {
                        <option value="9">9 (0.4 s)</option>
                        <option value="17">17 (0.7 s)</option>
                        <option value="25">25 (1 s)</option>
                        <option value="33">33 (1.4 s)</option>
                        <option value="49">49 (2 s)</option>
                    }
                </select>
            </div>
            @if (!Ltx)
            {
            <div class="vid-setting">
                <label>Steps:</label>
                <select @bind="_steps" class="vid-select" disabled="@_isRunning" title="The Turbo transformer is distilled for 4 steps. The standard one uses 50 in the reference; 20 to 30 is usually fine">
                    <option value="4">4 (Turbo)</option>
                    <option value="8">8</option>
                    <option value="12">12 (draft)</option>
                    <option value="20">20</option>
                    <option value="30">30</option>
                    <option value="50">50 (reference)</option>
                </select>
            </div>
            <div class="vid-setting">
                <label>Guidance:</label>
                <input type="number" min="1" max="12" step="0.5" @bind="_guidance" class="vid-input" disabled="@(_isRunning || Turbo)" title="@(Turbo ? "Turbo has the guidance built in (1): one transformer pass per step" : "classifier-free guidance scale, the reference uses 5")" />
            </div>
            }
            <div class="vid-setting">
                <label>Seed:</label>
                <input type="number" @bind="_seed" class="vid-input" placeholder="random" disabled="@_isRunning" />
            </div>
            @if (!Ltx)
            {
            <div class="vid-setting">
                <label>Tiled decode:</label>
                <input type="checkbox" @bind="_wanTiled" disabled="@_isRunning" title="Decode the video in 256 px tiles (diffusers' enable_tiling): the decoder needs a fraction of the GPU memory (720p: 2.5 GB instead of 8.4 GB) and takes about 1.5x as long. For GPUs with 8 GB or less." />
            </div>
            }
            @if (Ltx)
            {
            <div class="vid-setting">
                <label>Keep loaded:</label>
                <input type="checkbox" class="vid-keep" @bind="_ltxKeep" disabled="@Busy" title="Keep the transformer and the VAE on the GPU between clips: about 5 s faster per clip (a 704x480 clip with a repeated prompt: 35 s to 30 s on an RTX 4070), about 5 GB more GPU memory. Leave it off on GPUs with 8 GB or less." />
            </div>
            <div class="vid-setting">
                <label>Two-pass:</label>
                <input type="checkbox" @bind="_ltxUpscale" disabled="@Busy" title="The distilled model's recipe: a first pass at 2/3 of the size, the x2 latent upscaler, and 3 more steps at twice the first-pass size (896x576 for 704x480). Sharper, slower, more GPU memory." />
            </div>
            }
            @if (!Ltx)
            {
            <div class="vid-setting">
                <label>Transformer:</label>
                <select @bind="_dit" @bind:after="PrecisionChanged" class="vid-select" disabled="@(_isRunning || _isModelLoading)" title="Turbo: Wan2.2-TI2V-5B-Turbo, a step-distilled version that draws a clip in 4 steps with one pass each (about 8x faster than the standard 30 steps with guidance, and sharper at 720p). Standard 8-bit: 5.6 GB, matches the 16-bit model. 4-bit: 3.1 GB, visibly softer for the standard transformer; the 4-bit Turbo draws clips like the 8-bit one (for 8 GB GPUs, with Tiled decode at 1280x704).">
                    <option value="turbo">Turbo 8-bit (5.6 GB, 4 steps)</option>
                    <option value="turbo_q4">Turbo 4-bit (3.1 GB, 4 steps)</option>
                    <option value="q8">Standard 8-bit (5.6 GB)</option>
                    <option value="q4">Standard 4-bit (3.1 GB)</option>
                </select>
            </div>
            }
        </div>

        <div class="vid-modes">
            <button class="vid-mode @(_mode == "t2v" ? "on" : "")" @onclick="@(() => SetMode("t2v"))" disabled="@_isRunning">Text to video</button>
            <button class="vid-mode @(_mode == "i2v" ? "on" : "")" @onclick="@(() => SetMode("i2v"))" disabled="@_isRunning">Animate a picture</button>
            <button class="vid-mode @(_mode == "morph" ? "on" : "")" @onclick="@(() => SetMode("morph"))" disabled="@_isRunning" title="LTX-Video: a first and a last frame, the model fills the motion between them (keyframe conditioning)">Morph start to end</button>
            <button class="vid-mode @(_mode == "story" ? "on" : "")" @onclick="@(() => SetMode("story"))" disabled="@_isRunning" title="LTX-Video: one shot per line; each shot extends the clip from its last 17 frames, so a few lines make one continuous video">Story</button>
            <button class="vid-mode @(_mode == "extend" ? "on" : "")" @onclick="@(() => SetMode("extend"))" disabled="@(_isRunning || _lastClip == null)" title="LTX-Video: continue the clip on screen from its last 17 frames with a new prompt (video conditioning); the new frames are appended">Extend this clip</button>
        </div>
        @if (_mode == "story")
        {
            <div class="vid-writer">
                <input type="text" class="vid-prompt-input vid-idea" @bind="_storyIdea" @bind:event="oninput" disabled="@Busy"
                       placeholder="Or give an idea and let AI write the shots: a lighthouse keeper's cat during a storm" />
                <select @bind="_storyShots" class="vid-select" disabled="@Busy" title="How many shots: each one is a clip of about 4 seconds that continues the one before">
                    <option value="2">2 shots</option>
                    <option value="3">3 shots</option>
                    <option value="4">4 shots</option>
                    <option value="5">5 shots</option>
                </select>
                <button class="vid-action vid-download" @onclick="WriteStoryAsync" disabled="@(Busy || _isModelLoading || string.IsNullOrWhiteSpace(_storyIdea))">Write the shots</button>
            </div>
            <p class="vid-hint">@LtxStoryWriter.Label (@LtxStoryWriter.SizeText, downloaded once) writes one shot per line, in this tab; edit them, then Generate. Each new idea or click writes a different story.</p>
        }
        @if (_mode == "i2v" || _mode == "morph" || _mode == "story")
        {
            <ReferenceImages @ref="_refs" MaxImages="@(_mode == "morph" ? 2 : 1)" MaxSide="1024" Disabled="@(_isRunning || _isModelLoading)" ReferencesChanged="@OnReferencesChanged" />
            <div class="vid-camera">
                @if (!_cameraOn)
                {
                    <button class="vid-action" @onclick="StartCameraAsync" disabled="@(_isRunning || PictureCount >= (_mode == "morph" ? 2 : 1))">Use the camera</button>
                }
                else
                {
                    <img class="vid-camera-view" src="@_camUrl" alt="the camera" />
                    <button class="vid-action vid-download" @onclick="SnapAsync">Take the picture</button>
                    <button class="vid-action" @onclick="StopCamera">Close the camera</button>
                }
            </div>
            @if (_snaps.Count > 0)
            {
                <div class="vid-snaps">
                    @foreach (var sn in _snaps)
                    {
                        <img class="vid-snap" src="@sn.Url" alt="a picture" />
                    }
                    <button class="vid-action" @onclick="@(() => { _snaps.Clear(); StateHasChanged(); })" disabled="@_isRunning">Remove</button>
                </div>
            }
            <p class="vid-hint">@(_mode == "morph"
                ? (PictureCount == 2 ? "Morph: the first picture is frame 1, the second is the last frame; describe the motion between them." : "Add two pictures: the first frame and the last frame.")
                : _mode == "story" ? (PictureCount > 0 ? "The story starts from your picture." : "Optional: a picture for the first frame of the story.")
                : (PictureCount > 0 ? "Your picture is the first frame; describe how it moves." : "Add a picture (or take one with the camera): it becomes the first frame."))</p>
        }
        @if (_mode == "extend")
        {
            <p class="vid-hint">The clip on screen continues from its last 17 frames; describe what happens next. The new frames are appended (Download saves the whole clip).</p>
        }
        @if (Ltx)
        {
            <p class="vid-hint">LTX-Video weights are under the LTXV Open Weights License 0.X: use restrictions apply, and entities with $10M+ annual revenue need a commercial licence from Lightricks (see the model repo's LICENSE).</p>
        }

        <details class="vid-advanced">
            <summary>Advanced</summary>
            @if (!Ltx)
            {
                <label class="vid-label">Negative prompt (standard transformer only: Turbo has no guidance; empty = the model's default list of video defects):</label>
                <input type="text" class="vid-prompt-input" @bind="_negative" disabled="@_isRunning" />
            }
            <label class="vid-label">Model server (empty = models.spawndev.com):</label>
            <input type="text" class="vid-prompt-input" @bind="_modelServer" disabled="@(_isRunning || _isModelLoading)" placeholder="http://127.0.0.1:8767" />
        </details>
    </div>

    @if (_isRunning)
    {
        <div class="vid-progress">
            <div class="vid-progress-bar"><div class="vid-progress-fill" style="width: @(_fraction * 100)%"></div></div>
            <span class="vid-progress-text">@(_storyStatus.Length > 0 ? _storyStatus + ": " : "")@_stage @_stageMessage</span>
        </div>
    }

    @if (_error != null)
    {
        <div class="vid-error">@_error</div>
    }

    <div class="vid-live" style="@(_isRunning && _hasPreview ? "" : "display:none")">
        <img id="vid-preview" class="vid-preview" alt="the clip forming" />
        <div class="vid-live-label">@_previewLabel</div>
    </div>

    <div class="vid-result" style="@(_hasVideo && !Busy ? "" : "display:none")">
        <img id="vid-player" class="vid-player" alt="the generated video" />
        <div class="vid-info">
            <span class="vid-info-item">@_resultInfo</span>
        </div>
        <div class="vid-actions">
            <button class="vid-action" @onclick="ReplayAsync">Replay</button>
            <button class="vid-action vid-download" @onclick="DownloadAsync" disabled="@_recording">@(_recording ? "Encoding..." : "Download WebM")</button>
        </div>
    </div>
</DemoLayout>

<style>
    .vid-prompt-section { margin-bottom: 1rem; }
    .vid-label { display: block; color: #94a3b8; font-size: 0.85rem; margin: 0.4rem 0; }
    .vid-prompt-row { display: flex; gap: 0.5rem; align-items: stretch; }
    .vid-prompt-input { flex: 1; padding: 0.6rem 0.75rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.04); color: #e2e8f0; font-size: 0.95rem; width: 100%; }
    .vid-prompt-input:focus { border-color: rgba(139,92,246,0.5); outline: none; }
    .vid-btn { padding: 0.6rem 1.5rem; border-radius: 8px; border: none; background: linear-gradient(135deg, #3b82f6, #8b5cf6); color: white; font-weight: 600; cursor: pointer; white-space: nowrap; }
    .vid-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .vid-settings { display: flex; gap: 1rem; margin-top: 0.75rem; flex-wrap: wrap; }
    .vid-setting { display: flex; align-items: center; gap: 0.3rem; }
    .vid-setting label { color: #64748b; font-size: 0.8rem; }
    .vid-input { width: 80px; padding: 0.3rem 0.5rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.04); color: #e2e8f0; font-size: 0.8rem; text-align: center; }
    .vid-select { padding: 0.3rem 0.5rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.04); color: #e2e8f0; font-size: 0.8rem; }
    .vid-select option { background: #1e293b; }
    .vid-hint { color: #64748b; font-size: 0.8rem; margin: 0.4rem 0; }
    .vid-presets { display: flex; gap: 0.4rem; flex-wrap: wrap; align-items: center; margin-bottom: 0.9rem; }
    .vid-presets-label { color: #64748b; font-size: 0.8rem; }
    .vid-preset { padding: 0.35rem 0.75rem; border-radius: 8px; border: 1px solid rgba(52,211,153,0.3); background: rgba(52,211,153,0.08); color: #6ee7b7; font-size: 0.8rem; cursor: pointer; }
    .vid-preset:disabled { opacity: 0.45; cursor: not-allowed; }
    .vid-writer { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; margin: 0.4rem 0; }
    .vid-idea { flex: 1 1 18rem; }
    .vid-snaps { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; margin: 0.4rem 0; }
    .vid-snap { height: 72px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.12); }
    .vid-modes { display: flex; gap: 0.4rem; flex-wrap: wrap; margin: 0.9rem 0 0.5rem; }
    .vid-mode { padding: 0.45rem 0.9rem; border-radius: 999px; border: 1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.04); color: #94a3b8; font-size: 0.85rem; cursor: pointer; }
    .vid-mode.on { border-color: rgba(139,92,246,0.7); background: rgba(139,92,246,0.18); color: #e2e8f0; }
    .vid-mode:disabled { opacity: 0.45; cursor: not-allowed; }
    .vid-camera { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; margin: 0.4rem 0; }
    .vid-camera-view { width: 240px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1); transform: scaleX(-1); }
    .vid-live { text-align: center; margin: 1.5rem 0; }
    .vid-preview { width: min(100%, 720px); aspect-ratio: @(PreviewAspect); border-radius: 10px; border: 1px solid rgba(139,92,246,0.35); filter: saturate(1.1); }
    .vid-live-label { color: #a78bfa; font-size: 0.8rem; margin-top: 0.4rem; font-family: monospace; }
    .vid-advanced { margin-top: 0.5rem; color: #94a3b8; font-size: 0.85rem; }
    .vid-progress { margin: 1rem 0; }
    .vid-progress-bar { height: 8px; background: rgba(255,255,255,0.06); border-radius: 4px; overflow: hidden; }
    .vid-progress-fill { height: 100%; background: linear-gradient(90deg, #3b82f6, #8b5cf6); border-radius: 4px; transition: width 0.3s; }
    .vid-progress-text { color: #94a3b8; font-size: 0.8rem; margin-top: 0.25rem; display: block; }
    .vid-result { text-align: center; margin: 1.5rem 0; }
    .vid-player { max-width: 100%; border-radius: 10px; border: 1px solid rgba(255,255,255,0.1); }
    .vid-info { margin-top: 0.75rem; }
    .vid-info-item { color: #64748b; font-size: 0.8rem; font-family: monospace; }
    .vid-actions { display: flex; gap: 0.5rem; margin-top: 1rem; justify-content: center; }
    .vid-action { padding: 0.5rem 1rem; border-radius: 8px; font-size: 0.85rem; font-weight: 600; cursor: pointer; border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.05); color: #94a3b8; }
    .vid-download { border: 1px solid rgba(52,211,153,0.3); background: rgba(52,211,153,0.1); color: #6ee7b7; }
    .vid-error { margin-top: 1rem; padding: 0.75rem 1rem; background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); border-radius: 8px; color: #fca5a5; font-size: 0.85rem; white-space: pre-wrap; }
</style>

@code {
    private string _selectedBackend = "WebGPU";
    private string _prompt = "A red fox walking through fresh snow at golden hour, the camera follows it slowly, soft light, shallow depth of field.";
    private string _negative = "";
    private string _size = "640x352";
    private int _frames = 17, _steps = 4;
    private double _guidance = 1.0;
    private long? _seed;
    private string _dit = "turbo";                      // "turbo" | "turbo_q4" | "q8" | "q4"
    private string _model = "wan";                      // "wan" | "ltx"
    private bool Ltx => _model == "ltx";
    private bool _ltxUpscale, _ltxKeep;
    private string _mode = "t2v";                       // "t2v" | "i2v" | "morph" (LTX) | "extend" (LTX)
    private bool _hasPreview, _cameraOn;
    private string _previewLabel = "", _camUrl = "";
    private SpawnDev.ILGPU.ML.Preprocessing.MediaStreamCapture? _camera;
    private readonly List<(byte[] Rgba, int Width, int Height, string Url)> _snaps = new();      // camera pictures and the presets' pictures
    /// <summary>The last frames of the clip on screen (what "Extend" conditions on): RGB bytes, frames back to back.</summary>
    private (byte[] Rgb, int Frames, int Width, int Height)? _lastClip;
    private const int ExtendFrames = 17;
    private int PictureCount => _references.Count + _snaps.Count;
    private string PreviewAspect { get { var p = _size.Split('x'); return $"{p[0]} / {p[1]}"; } }
    private bool _wanTiled;
    private bool Turbo => _dit.StartsWith("turbo", StringComparison.Ordinal);       // "turbo" (8-bit) or "turbo_q4"
    private LtxPipeline? _ltxPipeline;
    private string _modelServer = "";
    private bool _isRunning, _isModelLoading, _isModelLoaded, _hasVideo, _recording;
    private double _modelProgress, _inferenceMs, _fraction;
    private string _modelStatusText = "Wan 2.2 TI2V-5B", _stage = "", _stageMessage = "", _resultInfo = "";
    private string? _error;
    private ReferenceImages? _refs;
    private IReadOnlyList<SpawnDev.ILGPU.ML.Flux2.Flux2ReferenceImage> _references = Array.Empty<SpawnDev.ILGPU.ML.Flux2.Flux2ReferenceImage>();
    private int _frameCount, _fps = 24;

    private readonly List<BackendSelector.BackendInfo> _backends = new() { new() { Id = "WebGPU", DisplayName = "WebGPU" } };

    [Inject] SpawnJSRuntime JS { get; set; } = default!;
    [Inject] SpawnDev.ILGPU.ML.Hub.HubModelSource ModelSource { get; set; } = default!;
    private global::ILGPU.Runtime.Accelerator? _accelerator;
    private global::ILGPU.Context? _context;
    private Wan22Pipeline? _pipeline;

    private void OnReferencesChanged(IReadOnlyList<SpawnDev.ILGPU.ML.Flux2.Flux2ReferenceImage> references) { _references = references; StateHasChanged(); }

    private Task HandleBackendChange(string backend) => Task.CompletedTask;

    private void ModelChanged()
    {
        _ltxPipeline?.Dispose();                                                   // frees the weights it kept on the GPU (KeepLoaded)
        _pipeline = null; _ltxPipeline = null; _isModelLoaded = false;
        _modelStatusText = Ltx ? "LTX-Video 2B" : "Wan 2.2 TI2V-5B";
        if (Ltx) { _size = "480x320"; _frames = 49; }              // the first pass of LTX's recipe: fast; 8n + 1 frames
        else { _size = "640x352"; _frames = 17; }
    }

    private void PrecisionChanged()
    {
        _pipeline = null; _isModelLoaded = false;
        if (Turbo) { _steps = 4; _guidance = 1.0; } else { if (_steps < 12) _steps = 30; if (_guidance <= 1.0) _guidance = 5.0; }     // each transformer's own recipe
    }

    /// <summary>An example: a prompt (or, with <c>Idea</c>, the idea the story writer turns into the shots first) and its pictures.</summary>
    private sealed record Preset(string Label, string Mode, string Prompt, string[] Pictures, bool Upscale = false, string? Idea = null);
    private static readonly Preset[] Presets =
    {
        new("Animate the kitten", "i2v", "The kitten slowly lifts its head, blinks and looks around curiously, its ears twitching, soft window light, shallow depth of field.", new[] { "samples/cat.jpg" }),
        new("Bring a landscape to life", "i2v", "Clouds drift slowly across the sky, the grass and trees sway in a gentle wind, light shifts across the hills, slow cinematic push forward.", new[] { "samples/landscape.jpg" }),
        new("Keyframes: fly into the house", "morph", "The camera glides smoothly toward the house, through the open front door and into the cozy living room, one continuous cinematic shot, warm light.", new[] { "samples/house.jpg", "samples/room.jpg" }),
        new("A story in three shots", "story", "A small red fox wakes up in a snowy forest at dawn, stretches and yawns, soft golden light.\nThe fox trots through the snowy forest between the trees, the camera follows it from the side.\nThe fox stops at the edge of a frozen lake and watches the sunrise, its breath visible in the cold air.", Array.Empty<string>()),
        new("AI writes the story", "story", "", Array.Empty<string>(), Idea: "A paper boat sails down a rainy city street and out to the sea"),
        new("A street at dusk", "i2v", "Evening falls on the street: people walk past, cars drive by with their headlights on, shop lights flicker on, slow camera pan.", new[] { "samples/street.jpg" }),
        new("A fox in the snow (two-pass)", "t2v", "A red fox trots through fresh snow at golden hour, its breath visible in the cold air, the camera follows it slowly, soft light, shallow depth of field.", Array.Empty<string>(), Upscale: true),
    };

    [Inject] HttpClient Http { get; set; } = default!;

    private async Task UsePresetAsync(Preset pr)
    {
        _error = null;
        if (!Ltx) { _model = "ltx"; ModelChanged(); }                      // the presets run on LTX-Video: fast enough to show off in a minute
        _mode = pr.Mode; _prompt = pr.Prompt; _ltxUpscale = pr.Upscale;
        _size = "704x480"; _frames = 97;
        _snaps.Clear();
        try
        {
            foreach (var url in pr.Pictures)
            {
                var bytes = await Http.GetByteArrayAsync(url);
                var (w, h, rgba) = await Services.ImageDisplayHelper.DecodeAsync(JS, bytes, 1024);
                _snaps.Add((rgba, w, h, Services.ImageDisplayHelper.ToDataUrl(JS, rgba, w, h)));
            }
        }
        catch (Exception ex) { _error = "Could not load the example's picture: " + ex.Message; }
        StateHasChanged();
        if (pr.Idea != null) { _storyIdea = pr.Idea; _storyShots = 3; if (!await WriteStoryAsync()) return; }
        if (_error == null) await GenerateVideo();
    }

    private string _storyIdea = "";
    private int _storyShots = 3;

    /// <summary>The story writer (<see cref="LtxStoryWriter"/>): the idea becomes one shot per line in the prompt box, shown as it is written. False when it failed or wrote nothing.</summary>
    private async Task<bool> WriteStoryAsync()
    {
        if (Busy || string.IsNullOrWhiteSpace(_storyIdea)) return false;
        _error = null; _isRunning = true; _hasPreview = false; _fraction = 0; _stage = ""; _stageMessage = "starting";
        _storyStatus = "writing the shots";                         // Busy, and the result panel stays hidden while the shots are written
        StateHasChanged();
        try
        {
            await EnsureAcceleratorAsync();
            if (!string.IsNullOrWhiteSpace(_modelServer)) SpawnDev.ILGPU.ML.Hub.ModelsHost.BaseUrl = _modelServer.Trim().TrimEnd('/');
            if (_ltxPipeline != null) _ltxPipeline.KeepLoaded = false;          // the language model and the video transformer never share the GPU; Generate loads it again
            int shots = _storyShots;
            var lines = await LtxStoryWriter.WriteAsync(_accelerator!, (repo, file, download) => ModelSource.OpenAsync(repo, file, download), _storyIdea, shots,
                _seed is { } s ? (int)(s % int.MaxValue) : Random.Shared.Next(1, int.MaxValue),
                status => { _stageMessage = status; _ = InvokeAsync(StateHasChanged); },
                pct => { _fraction = 0.5 * pct / 100; _ = InvokeAsync(StateHasChanged); },
                text => { _prompt = text; _fraction = 0.5 + 0.5 * Math.Min(1, text.Length / (330.0 * shots)); _ = InvokeAsync(StateHasChanged); });
            if (lines.Length == 0) { _error = "The story writer wrote no shots; try again or change the idea."; return false; }
            _prompt = string.Join("\n", lines);
            Console.WriteLine($"[Video] story: {lines.Length} shots written for \"{_storyIdea}\"");
            return true;
        }
        catch (Exception ex) { _error = "The story writer failed: " + ex.Message; Console.WriteLine($"[Video] story writer: {ex}"); return false; }
        finally { _isRunning = false; _storyStatus = ""; _stage = ""; _stageMessage = ""; StateHasChanged(); }
    }

    private void SetMode(string mode)
    {
        _mode = mode;
        if ((mode == "morph" || mode == "extend" || mode == "story") && !Ltx) { _model = "ltx"; ModelChanged(); }      // keyframes and clip conditioning are LTX-Video's
        StateHasChanged();
    }

    private IEnumerable<(byte[] Rgba, int Width, int Height)> Pictures() => _references.Select(r => (r.Rgba, r.Width, r.Height)).Concat(_snaps.Select(sn => (sn.Rgba, sn.Width, sn.Height)));

    private static byte[] ToRgb(byte[] rgba, int pixels)
    {
        var rgb = new byte[pixels * 3];
        for (int p = 0; p < pixels; p++) { rgb[p * 3] = rgba[p * 4]; rgb[p * 3 + 1] = rgba[p * 4 + 1]; rgb[p * 3 + 2] = rgba[p * 4 + 2]; }
        return rgb;
    }

    private async Task StartCameraAsync()
    {
        _error = null;
        _camera ??= new SpawnDev.ILGPU.ML.Preprocessing.MediaStreamCapture(JS) { TargetFps = 8 };
        _camera.OnFrameReady -= OnCameraFrame;
        _camera.OnFrameReady += OnCameraFrame;
        if (!await _camera.StartWebcamAsync(640, 480)) { _error = "The camera did not start: " + (_camera.LastVideoError?.Message ?? "no stream"); StateHasChanged(); return; }
        _cameraOn = true;
        StateHasChanged();
    }

    private void OnCameraFrame(byte[] rgba, int w, int h)
    {
        _camUrl = Services.ImageDisplayHelper.ToDataUrl(JS, rgba, w, h);
        _ = InvokeAsync(StateHasChanged);
    }

    private Task SnapAsync()
    {
        var frame = _camera?.CaptureFrame();
        if (frame != null) _snaps.Add((frame, _camera!.Width, _camera.Height, Services.ImageDisplayHelper.ToDataUrl(JS, frame, _camera.Width, _camera.Height)));
        if (PictureCount >= (_mode == "morph" ? 2 : 1)) StopCamera();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void StopCamera()
    {
        if (_camera != null) { _camera.OnFrameReady -= OnCameraFrame; _camera.Stop(); }
        _cameraOn = false; _camUrl = "";
        StateHasChanged();
    }

    /// <summary>A sampler step's x0 estimate as a tiny looping clip (one pixel per latent voxel, scaled up by the browser): the video forming while it is denoised.</summary>
    private void ShowPreview(float[] x0, int frames, int h, int w, LatentPreview lp, string label)
    {
        try
        {
            using var player = JS.Get<SpawnJSObject>("videoPlayer");
            player.JSRef!.CallVoid("clear", "vid-preview");
            for (int f = 0; f < frames; f++)
                player.JSRef!.CallVoid("addFrame", "vid-preview", Services.ImageDisplayHelper.ToDataUrl(JS, lp.FrameRgba(x0, frames, h, w, f), w, h));
            player.JSRef!.CallVoid("play", "vid-preview", Math.Max(1, _fps / lp.TemporalRatio));
            _previewLabel = label; _hasPreview = true;
            _ = InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) { Console.WriteLine($"[Video] preview: {ex.Message}"); }
    }

    private async Task EnsureAcceleratorAsync()
    {
        if (_accelerator != null) return;
        if (_context == null)
        {
            var builder = SpawnDev.ILGPU.ML.MLContext.Create();
            await builder.AllAcceleratorsAsync();
            _context = builder.ToContext();
        }
        _accelerator = await _context.CreatePreferredAcceleratorAsync() ?? throw new InvalidOperationException("No GPU accelerator available (this page needs WebGPU).");
    }

    private async Task GenerateVideo()
    {
        if (_mode != "story") { await GenerateCoreAsync(); return; }
        // a story: the first shot from text (or the picture), every following one extends the clip on screen from its last frames
        var shots = _prompt.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        var story = _prompt;
        var storyClock = System.Diagnostics.Stopwatch.StartNew();
        try
        {
            for (int i = 0; i < shots.Count; i++)
            {
                _mode = i == 0 ? (PictureCount > 0 ? "i2v" : "t2v") : "extend";
                _prompt = shots[i];
                _storyStatus = $"shot {i + 1} of {shots.Count}";
                await GenerateCoreAsync();
                if (_error != null) break;
            }
        }
        finally
        {
            if (_error == null && _hasVideo) _resultInfo = $"{_frameCount} frames at {_fps} fps ({_frameCount / (double)_fps:F1} s), a story of {shots.Count} shots, {storyClock.Elapsed.TotalSeconds:F0} s total";
            _mode = "story"; _prompt = story; _storyStatus = ""; StateHasChanged();
        }
    }

    private string _storyStatus = "";
    private bool Busy => _isRunning || _storyStatus.Length > 0;           // a story is busy between its shots too

    private async Task GenerateCoreAsync()
    {
        bool extending = _mode == "extend" && _lastClip != null && Ltx;
        _error = null; _isRunning = true; _hasPreview = false; _fraction = 0; _stage = "starting"; _stageMessage = "";
        if (!extending) _hasVideo = false;
        StateHasChanged();
        var total = System.Diagnostics.Stopwatch.StartNew();
        try
        {
            await EnsureAcceleratorAsync();
            if (!string.IsNullOrWhiteSpace(_modelServer)) SpawnDev.ILGPU.ML.Hub.ModelsHost.BaseUrl = _modelServer.Trim().TrimEnd('/');
            var parts = _size.Split('x');
            int width = int.Parse(parts[0]), height = int.Parse(parts[1]);
            long seed = _seed ?? Random.Shared.NextInt64(1, int.MaxValue);
            var request = new WanRequest { Prompt = _prompt, Width = width, Height = height, Frames = _frames, Seed = seed };     // replaced below for Wan; only the common fields matter for LTX
            if (Ltx) _ltxPipeline ??= new LtxPipeline(_accelerator!, ModelSource, LtxPipeline.DefaultRepo, LtxPaths.InRepo(LtxPaths.DitFile("q8"), LtxPaths.TextEncoderFile("q8")));
            else
            {
                _pipeline ??= new Wan22Pipeline(_accelerator!, ModelSource, Wan22Pipeline.DefaultRepo, Wan22Paths.InRepo(Wan22Paths.DitFile(_dit == "turbo" ? "turbo_q8" : _dit), Wan22Paths.TextEncoderFile("q8")));
                request = new WanRequest
                {
                    Prompt = _prompt, NegativePrompt = string.IsNullOrWhiteSpace(_negative) ? null : _negative, Width = width, Height = height, Frames = _frames, Steps = _steps,
                    GuidanceScale = Turbo ? 1.0 : _guidance, Seed = seed,
                    Sampler = Turbo ? WanSampler.FewStep : WanSampler.UniPC, TiledDecode = _wanTiled, RgbaFrames = true,
                };
            }
            var pics = Pictures().ToList();
            byte[]? firstRgb = null; int firstW = 0, firstH = 0;
            if ((_mode == "i2v" || _mode == "morph") && pics.Count > 0)
            {
                var pic = pics[0];
                firstRgb = ToRgb(pic.Rgba, pic.Width * pic.Height); firstW = pic.Width; firstH = pic.Height;
            }
            if (_mode == "morph" && pics.Count < 2) throw new InvalidOperationException("Morph needs two pictures: the first frame and the last frame.");
            if (_mode == "i2v" && firstRgb == null) throw new InvalidOperationException("Add a picture to animate (or take one with the camera).");
            if (!Ltx && firstRgb != null)
            {
                var rgb = firstRgb; var pic = pics[0];
                request = new WanRequest
                {
                    Prompt = request.Prompt, NegativePrompt = request.NegativePrompt, Width = width, Height = height, Frames = _frames, Steps = _steps, GuidanceScale = request.GuidanceScale, Seed = request.Seed, Sampler = request.Sampler,
                    ImageRgb = rgb, ImageWidth = pic.Width, ImageHeight = pic.Height, TiledDecode = request.TiledDecode, RgbaFrames = true,
                };
            }
            var progress = new Progress<WanProgress>(p =>
            {
                _stage = p.Stage; _stageMessage = p.Message;
                // the transformer's steps are most of the time: text 0-10 %, loading + steps 10-90 %, decode 90-100 %
                _fraction = p.Stage switch { "text" => 0.1 * p.Fraction, "image" or "conditions" or "upscale" => 0.1, "denoise" => 0.1 + 0.8 * p.Fraction, "decode" => 0.9 + 0.1 * p.Fraction, _ => _fraction };
                _modelStatusText = $"{(Ltx ? "LTX-Video" : "Wan 2.2")} - {p.Stage}";
                _ = InvokeAsync(StateHasChanged);
            });
            // the conditions of the LTX modes: a first frame; a first and a last frame (keyframes); the last frames of the clip on screen (video conditioning)
            LtxCondition[]? conditions = null;
            if (Ltx && _mode == "i2v" && firstRgb != null) conditions = new[] { LtxCondition.Image(firstRgb, firstW, firstH) };
            if (Ltx && _mode == "morph")
            {
                var end = pics[1];
                conditions = new[] { LtxCondition.Image(firstRgb!, firstW, firstH), LtxCondition.Image(ToRgb(end.Rgba, end.Width * end.Height), end.Width, end.Height, frameIndex: _frames - 1) };
            }
            if (extending)
            {
                var c = _lastClip!.Value;
                conditions = new[] { new LtxCondition { Rgb = c.Rgb, Width = c.Width, Height = c.Height, Frames = c.Frames } };
            }
            if (Ltx) _ltxPipeline!.KeepLoaded = _ltxKeep;
            if (Ltx) _ltxPipeline!.Preview = p => ShowPreview(p.X0, p.Frames, p.Height, p.Width, LatentPreview.Ltx, $"step {p.Step} of {p.Steps}{(p.Pass.Length > 0 ? $" ({p.Pass})" : "")}: what the model sees so far");
            else _pipeline!.Preview = p => ShowPreview(p.X0, p.Frames, p.Height, p.Width, LatentPreview.Wan, $"step {p.Step} of {p.Steps}: what the model sees so far");
            var video = Ltx
                ? await _ltxPipeline!.GenerateAsync(new LtxRequest
                {
                    Prompt = _prompt, Width = width, Height = height, Frames = _frames, Seed = seed, FrameRate = _fps, Upscale = _ltxUpscale, Conditions = conditions,
                    RgbaFrames = true,                                                     // frames as bytes read a frame at a time: floats of whole clips exhaust the tab's .NET heap
                }, progress)
                : await _pipeline!.GenerateAsync(request, progress);
            try { using var pv = JS.Get<SpawnJSObject>("videoPlayer"); pv.JSRef!.CallVoid("stop", "vid-preview"); } catch { }
            _stage = "showing"; _stageMessage = "the frames"; StateHasChanged();
            await Task.Yield();
            using var player = JS.Get<SpawnJSObject>("videoPlayer");
            // extending: the new clip's first frames are the old clip's last ones (the condition): append only what follows
            int skip = extending ? _lastClip!.Value.Frames : 0;
            if (!extending) { player.JSRef!.CallVoid("clear", "vid-player"); _frameCount = 0; }
            for (int f = skip; f < video.Frames; f++)
                player.JSRef!.CallVoid("addFrame", "vid-player", Services.ImageDisplayHelper.ToDataUrl(JS, video.GetFrameRgba(f), video.Width, video.Height));
            _frameCount += video.Frames - skip;
            // remember the last frames for "Extend this clip"
            if (Ltx && video.Frames >= ExtendFrames)
            {
                int px = video.Width * video.Height;
                var tail = new byte[ExtendFrames * px * 3];
                for (int f = 0; f < ExtendFrames; f++) Array.Copy(ToRgb(video.GetFrameRgba(video.Frames - ExtendFrames + f), px), 0, tail, (long)f * px * 3, px * 3);
                _lastClip = (tail, ExtendFrames, video.Width, video.Height);
            }
            else if (!Ltx) _lastClip = null;
            _hasVideo = true; _isModelLoaded = true;
            _inferenceMs = total.Elapsed.TotalMilliseconds;
            _resultInfo = $"{_frameCount} frames {video.Width}x{video.Height} at {_fps} fps ({_frameCount / (double)_fps:F1} s), seed {request.Seed}, {total.Elapsed.TotalSeconds:F0} s{(extending ? " for the extension" : " total")}";
            _modelStatusText = Ltx ? "LTX-Video 2B" : "Wan 2.2 TI2V-5B";
            StateHasChanged();
            await Task.Yield();
            player.JSRef!.CallVoid("play", "vid-player", _fps);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Console.WriteLine($"[Video] Error: {ex}");
        }
        _isRunning = false;
        StateHasChanged();
    }

    private async Task ReplayAsync()
    {
        using var player = JS.Get<SpawnJSObject>("videoPlayer");
        player.JSRef!.CallVoid("play", "vid-player", _fps);
        await Task.CompletedTask;
    }

    private async Task DownloadAsync()
    {
        _recording = true; StateHasChanged();
        try
        {
            using var player = JS.Get<SpawnJSObject>("videoPlayer");
            await player.JSRef!.CallVoidAsync("download", "vid-player", _fps, "video.webm");
        }
        catch (Exception ex) { _error = ex.Message; }
        _recording = false; StateHasChanged();
    }

    public void Dispose()
    {
        try { _camera?.Dispose(); } catch { }
        try { _ltxPipeline?.Dispose(); } catch { }
        try { using var pv = JS.Get<SpawnJSObject>("videoPlayer"); pv.JSRef!.CallVoid("stop", "vid-preview"); } catch { }
        try { using var player = JS.Get<SpawnJSObject>("videoPlayer"); player.JSRef!.CallVoid("stop", "vid-player"); } catch { }
        _accelerator?.Dispose(); _accelerator = null;
    }
}
