@page "/face"
@using System.IO
@using SpawnDev.SpawnJS
@using SpawnDev.ILGPU.ML
@using SpawnDev.ILGPU.ML.Pipelines
@implements IDisposable

<PageTitle>Face Detection — SpawnDev.ILGPU.ML</PageTitle>

<DemoLayout Title="Face Detection &amp; Landmarks"
            Description="Face detection with landmark points. BlazeFace is only ~0.5MB — loads instantly. Upload an image or use the webcam."
            AvailableBackends="@_backends"
            SelectedBackend="@_selectedBackend"
            SelectedBackendChanged="@((v) => _selectedBackend = v)"
            OnBackendChange="@HandleBackendChange"
            InferenceTimeMs="@_inferenceMs"
            IsRunning="@_isRunning"
            ShowFps="@_useWebcam"
            ShowModelProgress="true"
            ModelName="BlazeFace"
            IsModelLoading="@_isModelLoading"
            IsModelLoaded="@_isModelLoaded"
            ModelProgressPercent="@_modelProgress"
            ModelSizeMB="0.5">

    <div class="face-controls">
        <div class="mode-toggle">
            <button class="mode-btn @(!_useWebcam ? "active" : "")" @onclick="SwitchToImage">Image</button>
            <button class="mode-btn @(_useWebcam ? "active" : "")" @onclick="SwitchToWebcam">Webcam</button>
        </div>
        <div class="control-group">
            <label>Show:</label>
            <label class="checkbox-label"><input type="checkbox" @bind="_showBoxes" /> Boxes</label>
            <label class="checkbox-label"><input type="checkbox" @bind="_showLandmarks" /> Landmarks</label>
            <label class="checkbox-label"><input type="checkbox" @bind="_showConfidence" /> Confidence</label>
        </div>
        <span class="face-count">Faces: @_faceCount</span>
    </div>

    @if (_useWebcam)
    {
        <div class="face-viewport">
            <WebcamCapture OnFrameCaptured="@HandleFrame"
                           AutoCapture="@_isModelLoaded"
                           CaptureIntervalMs="33"
                           ShowCaptureButton="true"
                           Width="640" Height="480" />

            @if (_faces != null && _faces.Count > 0)
            {
                <svg class="face-overlay" viewBox="0 0 640 480" preserveAspectRatio="xMidYMid meet">
                    @foreach (var face in _faces)
                    {
                        @if (_showBoxes)
                        {
                            <rect x="@face.X" y="@face.Y" width="@face.Width" height="@face.Height"
                                  fill="none" stroke="#3b82f6" stroke-width="2" rx="4" />
                        }
                        @if (_showConfidence)
                        {
                            @((MarkupString)$"<text x=\"{face.X}\" y=\"{face.Y - 6}\" fill=\"#3b82f6\" font-size=\"12\" font-weight=\"600\">{(face.Confidence * 100):F0}%</text>")
                        }
                        @if (_showLandmarks)
                        {
                            @foreach (var (lx, ly) in face.Landmarks)
                            {
                                <circle cx="@lx" cy="@ly" r="3" fill="#34d399" stroke="#0f172a" stroke-width="1" />
                            }
                        }
                    }
                </svg>
            }
        </div>
    }
    else if (_stillImageDataUrl != null)
    {
        <div class="face-viewport face-still">
            <img src="@_stillImageDataUrl" class="face-still-img" alt="Input" />
            @if (_faces != null && _faces.Count > 0)
            {
                <svg class="face-overlay" viewBox="0 0 @_stillImageWidth @_stillImageHeight" preserveAspectRatio="xMidYMid meet">
                    @foreach (var face in _faces)
                    {
                        @if (_showBoxes)
                        {
                            <rect x="@face.X" y="@face.Y" width="@face.Width" height="@face.Height"
                                  fill="none" stroke="#3b82f6" stroke-width="@Math.Max(2, _stillImageWidth / 320)" rx="4" />
                        }
                        @if (_showConfidence)
                        {
                            @((MarkupString)$"<text x=\"{face.X}\" y=\"{face.Y - 6}\" fill=\"#3b82f6\" font-size=\"{Math.Max(10, _stillImageWidth / 50)}\" font-weight=\"600\">{(face.Confidence * 100):F0}%</text>")
                        }
                        @if (_showLandmarks)
                        {
                            @foreach (var (lx, ly) in face.Landmarks)
                            {
                                <circle cx="@lx" cy="@ly" r="@Math.Max(2, _stillImageWidth / 200)" fill="#34d399" stroke="#0f172a" stroke-width="1" />
                            }
                        }
                    }
                </svg>
            }
        </div>
        <div class="result-actions">
            <button class="action-btn clear-btn" @onclick="ClearStillImage">Try Another Image</button>
            @if (_faces != null && _faces.Count == 0)
            {
                <span class="no-faces-hint">No faces detected — BlazeFace NHWC forward is still wrong vs MediaPipe (engine bug). Portrait should light up once that gate is green.</span>
            }
        </div>
    }
    else
    {
        <ImageDropZone @bind-ImageDataUrl="_stillImageDataUrl"
                       OnImageLoaded="@HandleStillImageLoaded"
                       SampleImages="@_faceSamples" />
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="error-banner">@_error</div>
    }
    else if (!_isModelLoaded && !_isModelLoading)
    {
        <div class="model-needed">
            BlazeFace (~0.5&nbsp;MB) loads on your first image or Capture click.
        </div>
    }

    <PrivacyBadge />

    <PipelineHowTo SourceFile="Pages/FaceDetectPage.razor" Note="BlazeFace" />

</DemoLayout>

<style>
    .face-controls { display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap; }
    .mode-toggle {
        display: flex; border-radius: 6px; overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .mode-btn {
        padding: 0.3rem 0.75rem; border: none; background: rgba(255, 255, 255, 0.04);
        color: #64748b; font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: all 0.15s ease;
    }
    .mode-btn.active { background: rgba(139, 92, 246, 0.2); color: #e2e8f0; }
    .mode-btn:hover:not(.active) { background: rgba(255, 255, 255, 0.08); }
    .control-group { display: flex; align-items: center; gap: 0.75rem; }
    .control-group label:first-child { color: #64748b; font-size: 0.85rem; }
    .checkbox-label { display: flex; align-items: center; gap: 0.3rem; color: #94a3b8; font-size: 0.82rem; cursor: pointer; }
    .checkbox-label input { accent-color: #8b5cf6; }
    .face-count { margin-left: auto; color: #38bdf8; font-size: 0.9rem; font-weight: 700; font-family: monospace; }

    .face-viewport { position: relative; border-radius: 10px; overflow: hidden; }
    .face-overlay { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 2; }
    .face-still { width: 100%; max-width: 800px; }
    .face-still-img { width: 100%; height: auto; display: block; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1); }

    .result-actions { display: flex; gap: 0.5rem; margin-top: 1rem; }
    .action-btn { padding: 0.5rem 1rem; border-radius: 8px; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: all 0.15s ease; }
    .clear-btn { border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.05); color: #94a3b8; }
    .clear-btn:hover { background: rgba(255,255,255,0.1); }
    .no-faces-hint { color: #94a3b8; font-size: 0.85rem; align-self: center; }

    .model-needed { margin-top: 1rem; padding: 0.75rem 1rem; background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2); border-radius: 8px; color: #fbbf24; font-size: 0.85rem; }
    .error-banner { margin-top: 1rem; padding: 0.75rem 1rem; background: rgba(248,113,113,0.1); border: 1px solid rgba(248,113,113,0.3); border-radius: 8px; color: #fca5a5; font-size: 0.85rem; }
</style>

@code {
    private string _selectedBackend = "WebGPU";
    // Image is the default — matches Style/Detect; webcam is opt-in.
    private bool _useWebcam;
    private bool _showBoxes = true, _showLandmarks = true, _showConfidence = true;
    private int _faceCount;
    private List<FaceDetection>? _faces;
    private bool _isRunning, _isModelLoading, _isModelLoaded;
    private double _modelProgress, _inferenceMs;
    private bool _processingFrame;
    private string? _error;
    private Task? _loadTask;

    private string? _stillImageDataUrl;
    private int _stillImageWidth = 640, _stillImageHeight = 480;

    private List<BackendSelector.BackendInfo> _backends = new()
    {
        new() { Id = "WebGPU", DisplayName = "WebGPU" },
        new() { Id = "WebGL", DisplayName = "WebGL" },
        new() { Id = "Wasm", DisplayName = "Wasm (CPU)" },
    };

    private List<ImageDropZone.SampleImage> _faceSamples = new()
    {
        new() { Label = "Portrait", Url = "samples/portrait.jpg" },
        // Cat/Dog are useful negatives — BlazeFace should return 0 faces.
        new() { Label = "Cat", Url = "samples/cat.jpg" },
        new() { Label = "Dog", Url = "samples/dog.jpg" },
    };

    [Inject] SpawnJS.SpawnJSRuntime JS { get; set; } = default!;
    [Inject] HttpClient Http { get; set; } = default!;

    private global::ILGPU.Runtime.Accelerator? _accelerator;
    private global::ILGPU.Context? _context;
    private Pipelines.FaceDetectionPipeline? _pipeline;

    // OPT-IN: BlazeFace loads on first image pick or webcam Capture — not on page entry.

    private void SwitchToImage()
    {
        if (!_useWebcam) return;
        _useWebcam = false;
        _faces = null;
        _faceCount = 0;
        StateHasChanged();
    }

    private void SwitchToWebcam()
    {
        if (_useWebcam) return;
        _useWebcam = true;
        _stillImageDataUrl = null;
        _faces = null;
        _faceCount = 0;
        StateHasChanged();
    }

    private void ClearStillImage()
    {
        _stillImageDataUrl = null;
        _faces = null;
        _faceCount = 0;
        StateHasChanged();
    }

    private async Task EnsureModelAsync()
    {
        if (_isModelLoaded) return;
        if (_loadTask != null)
        {
            await _loadTask;
            return;
        }
        _loadTask = LoadModelAsync();
        try { await _loadTask; }
        finally { _loadTask = null; }
    }

    private async Task LoadModelAsync()
    {
        try
        {
            _isModelLoading = true;
            _error = null;
            _modelProgress = 5;
            StateHasChanged();

            if (_context == null)
            {
                var builder = MLContext.Create();
                await builder.AllAcceleratorsAsync();
                _context = builder.ToContext();
            }

            _modelProgress = 20;
            StateHasChanged();
            _accelerator = await _context.CreatePreferredAcceleratorAsync();
            if (_accelerator == null)
            {
                _error = "No GPU/Wasm accelerator available";
                return;
            }

            _modelProgress = 40;
            StateHasChanged();

            // Bundled demo copy only — do NOT fall through to hub.spawndev.com.
            // litert-community/blaze-face returns 502 on the hub (2026-09-26); a hub fallback just
            // threw after a working (or almost-working) local path and looked like the demo was broken.
            //
            // Known size + cache-bust: CreateFromFileAsync/DownloadBytesChunkedAsync could "succeed" at
            // 199050 bytes when the browser HTTP cache served a truncated body whose Content-Length
            // matched the short length (so the incomplete-stream fallback never ran). Measured on
            // lostbeard.github.io/face with Build 2026-09-27 04:32:24 UTC still FlatBuffer-OOB.
            const int blazeFaceBytes = 229746;
            var modelUrl = $"models/blaze-face/model.tflite?v={blazeFaceBytes}";
            _modelProgress = 50;
            StateHasChanged();
            var bytes = await Http.GetByteArrayAsync(modelUrl);
            Console.WriteLine($"[Face] downloaded {bytes.Length} bytes (expect {blazeFaceBytes})");
            if (bytes.Length != blazeFaceBytes)
                throw new InvalidDataException(
                    $"BlazeFace download truncated or corrupt: got {bytes.Length} bytes, expected {blazeFaceBytes}. "
                    + "Unregister the site's service worker (DevTools → Application) and reload.");
            _modelProgress = 70;
            StateHasChanged();
            var session = InferenceSession.CreateFromFile(
                _accelerator, bytes,
                onProgress: (stage, pct) =>
                {
                    _modelProgress = 70 + pct * 0.25;
                    StateHasChanged();
                });

            _pipeline?.Dispose();
            _pipeline = new Pipelines.FaceDetectionPipeline(session, _accelerator);
            _isModelLoaded = true;
            _modelProgress = 100;
            Console.WriteLine("[Face] Model loaded");
        }
        catch (Exception ex)
        {
            _error = $"Failed to load BlazeFace: {ex.Message}";
            Console.WriteLine($"[Face] Error: {ex}");
            _isModelLoaded = false;
        }
        finally
        {
            _isModelLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleBackendChange(string backend)
    {
        bool wasLoaded = _isModelLoaded;
        _selectedBackend = backend;
        _pipeline?.Dispose();
        _pipeline = null;
        _accelerator?.Dispose();
        _accelerator = null;
        _isModelLoaded = false;
        _faces = null;
        _faceCount = 0;
        if (wasLoaded)
            await EnsureModelAsync();
        else
            StateHasChanged();
    }

    private async Task HandleStillImageLoaded(byte[] imageBytes)
    {
        await EnsureModelAsync();
        if (_pipeline == null) return;
        try
        {
            _error = null;
            var mime = SniffImageMime(imageBytes);
            using var blob = new SpawnDev.SpawnJS.JSObjects.Blob(
                new[] { imageBytes }, new SpawnDev.SpawnJS.JSObjects.BlobOptions { Type = mime });
            using var window = JS.Get<SpawnDev.SpawnJS.JSObjects.Window>("window");
            using var bitmap = await window.CreateImageBitmap(blob);
            int w = (int)bitmap.Width;
            int h = (int)bitmap.Height;
            using var canvas = new SpawnDev.SpawnJS.JSObjects.HTMLCanvasElement();
            canvas.Width = w;
            canvas.Height = h;
            using var ctx = canvas.Get2DContext();
            ctx.DrawImage(bitmap, 0, 0, w, h);
            using var imageData = ctx.GetImageData(0, 0, w, h);
            using var data = imageData.Data;
            var rgbaPixels = data.Read<int>();
            _stillImageWidth = w;
            _stillImageHeight = h;

            await RunDetection(rgbaPixels, w, h);
        }
        catch (Exception ex)
        {
            _error = $"Image decode/inference failed: {ex.Message}";
            Console.WriteLine($"[Face] Still image error: {ex}");
            StateHasChanged();
        }
    }

    private async Task HandleFrame(byte[] frameBytes)
    {
        if (_processingFrame) return;
        _processingFrame = true;
        try
        {
            await EnsureModelAsync();
            if (_pipeline == null) return;
            var rgbaPixels = new int[frameBytes.Length / 4];
            Buffer.BlockCopy(frameBytes, 0, rgbaPixels, 0, frameBytes.Length);
            await RunDetection(rgbaPixels, 640, 480);
        }
        catch (Exception ex)
        {
            _error = $"Frame error: {ex.Message}";
            Console.WriteLine($"[Face] Frame error: {ex}");
            _isRunning = false;
        }
        finally
        {
            _processingFrame = false;
        }
    }

    private async Task RunDetection(int[] rgbaPixels, int width, int height)
    {
        _isRunning = true;
        try
        {
            var result = await _pipeline!.DetectAsync(rgbaPixels, width, height);
            _inferenceMs = result.InferenceTimeMs;
            _faceCount = result.FaceCount;
            _faces = result.Faces.Select(f => new FaceDetection
            {
                X = f.X,
                Y = f.Y,
                Width = f.Width,
                Height = f.Height,
                Confidence = f.Confidence,
                Landmarks = f.Landmarks,
            }).ToList();
        }
        catch (Exception ex)
        {
            _error = $"Inference failed: {ex.Message}";
            Console.WriteLine($"[Face] Inference error: {ex}");
        }
        _isRunning = false;
        StateHasChanged();
    }

    private static string SniffImageMime(byte[] bytes)
    {
        if (bytes.Length >= 3 && bytes[0] == 0xFF && bytes[1] == 0xD8 && bytes[2] == 0xFF)
            return "image/jpeg";
        if (bytes.Length >= 8 && bytes[0] == 0x89 && bytes[1] == 0x50 && bytes[2] == 0x4E && bytes[3] == 0x47)
            return "image/png";
        if (bytes.Length >= 12 && bytes[0] == 0x52 && bytes[1] == 0x49 && bytes[2] == 0x46 && bytes[3] == 0x46
            && bytes[8] == 0x57 && bytes[9] == 0x45 && bytes[10] == 0x42 && bytes[11] == 0x50)
            return "image/webp";
        return "image/jpeg";
    }

    public void Dispose()
    {
        _pipeline?.Dispose();
        _accelerator?.Dispose();
        _context?.Dispose();
    }

    private class FaceDetection
    {
        public float X { get; set; }
        public float Y { get; set; }
        public float Width { get; set; }
        public float Height { get; set; }
        public float Confidence { get; set; }
        public List<(float X, float Y)> Landmarks { get; set; } = new();
    }
}
