@code {
    // Same path SpawnDev.AI.AiImageEngine uses: ImageGenerationPipeline.CreateAsync + RunAsync.
    // Evidence: SDTurbo_Generate_E2E (HeavyModel) + SDTurbo_WebGPU_ImageGen_MultiGen.
    // The prior "Coming soon" stub never called LoadModelAsync, so Generate stayed disabled forever.
    private string _selectedBackend = "WebGPU";
    private string _prompt = "a photo of a cat";
    private string _negativePrompt = "";
    private bool _showNegative;
    private int _numSteps = 1;
    private float _guidanceScale = 0;
    private int? _seed;
    private int _usedSeed;
    private int _imageSize = 512;
    private int _currentStep;
    private bool _isRunning, _isModelLoading, _isModelLoaded;
    private double _modelProgress, _inferenceMs;
    private string? _generatedImageUrl;
    private string? _error;
    private string _modelStatusText = "FLUX.2 klein";
    private string _model = "flux2";                    // "flux3" | "flux2" | "sd"
    private int _fluxSize = 512;                        // the picture side (its longer side when reference images set the proportions)
    private int _resultWidth, _resultHeight;
    private SpawnDev.ILGPU.ML.Flux2.Flux2Pipeline? _flux;
    private SpawnDev.ILGPU.ML.Flux3.Flux3Pipeline? _flux3;
    private const string FluxRepo = "LostBeard/FLUX.2-klein-4B-q4-ILGPU";
    private const string Flux3Repo = "LostBeard/flux-3-image-klein-q4-ILGPU";
    private ReferenceImages? _refs;
    private bool _expandPrompt;                         // FLUX 3: a local LLM writes the full scene caption first
    private string? _usedCaption, _timings;
    private int _pictures = 1;                          // 1, 4 or 8 pictures of the prompt (consecutive seeds), shown together
    private sealed record GalleryItem(int Seed, string Url);
    private readonly List<GalleryItem> _gallery = new();
    private IReadOnlyList<SpawnDev.ILGPU.ML.Flux2.Flux2ReferenceImage> _references = Array.Empty<SpawnDev.ILGPU.ML.Flux2.Flux2ReferenceImage>();

    private void OnReferencesChanged(IReadOnlyList<SpawnDev.ILGPU.ML.Flux2.Flux2ReferenceImage> references) { _references = references; StateHasChanged(); }

    private string ModelLabel => _model == "flux3" ? "FLUX 3 Klein" : _model == "flux2" ? "FLUX.2 klein" : "SD Turbo";

    /// <summary>The picture size: a square of <see cref="_fluxSize"/> pixels, or with reference images the first one's proportions with that longer side (multiples of 16).</summary>
    private (int Width, int Height) PictureSize()
    {
        if (_references.Count == 0) return (_fluxSize, _fluxSize);
        var first = _references[0];
        double aspect = (double)first.Width / first.Height;
        int w = aspect >= 1 ? _fluxSize : (int)Math.Round(_fluxSize * aspect / 16) * 16, h = aspect >= 1 ? (int)Math.Round(_fluxSize / aspect / 16) * 16 : _fluxSize;
        return (Math.Max(64, w), Math.Max(64, h));
    }

    /// <summary>The caption FLUX 3 draws from: <see cref="_prompt"/> expanded by Qwen3 4B with Black Forest Labs' upsampler instructions. The transformer leaves the GPU first, the language model leaves it after.</summary>
    private async Task<string> ExpandPromptAsync(int width, int height)
    {
        _flux3!.ReleaseResident();
        // the header bar follows the language model's download and load, and the caption appears as it is written
        _writingCaption = true; _liveCaption = ""; _modelProgress = 0; _isModelLoading = true; StateHasChanged();
        try
        {
            return await Services.CaptionWriter.WriteAsync(_accelerator!, ModelSource, _prompt, width, height,
                text => { _modelStatusText = text; _ = InvokeAsync(StateHasChanged); },
                pct => { _modelProgress = pct; _isModelLoading = pct < 100; _ = InvokeAsync(StateHasChanged); },
                partial => { _liveCaption = partial; _ = InvokeAsync(StateHasChanged); });
        }
        finally { _writingCaption = false; _isModelLoading = false; }
    }

    private bool _writingCaption;
    private string _liveCaption = "";

    private void ModelChanged()
    {
        _pipeline?.Dispose(); _pipeline = null; _flux?.Dispose(); _flux = null; _flux3?.Dispose(); _flux3 = null;
        _isModelLoaded = false; _generatedImageUrl = null; _error = null;
        _modelStatusText = ModelLabel;
        if (_model == "sd") _ = _refs?.ClearAsync();
    }

    private string GenerateButtonLabel =>
        _isModelLoading ? "Loading…"
        : _isRunning ? "Generating…"
        : !_isModelLoaded ? "Download & Generate"
        : "Generate";

    private List<BackendSelector.BackendInfo> _backends = new()
    {
        new() { Id = "WebGPU", DisplayName = "WebGPU" },
    };

    [Inject] SpawnJS.SpawnJSRuntime JS { get; set; } = default!;
    [Inject] SpawnDev.ILGPU.ML.Hub.HubModelSource ModelSource { get; set; } = default!;
    [Inject] HttpClient Http { get; set; } = default!;
    private global::ILGPU.Runtime.Accelerator? _accelerator;
    private global::ILGPU.Context? _context;
    private SpawnDev.ILGPU.ML.Pipelines.ImageGenerationPipeline? _pipeline;

    // OPT-IN: ~2.5 GB SD-Turbo is NOT downloaded on page entry. First Generate click loads it
    // (same lazy residency as SpawnDev.AI.AiImageEngine.GenerateAsync).

    private async Task LoadModelAsync()
    {
        try
        {
            _error = null;
            _isModelLoading = true;
            StateHasChanged();

            if (_context == null)
            {
                var builder = SpawnDev.ILGPU.ML.MLContext.Create();
                await builder.AllAcceleratorsAsync();
                _context = builder.ToContext();
            }
            _accelerator?.Dispose();
            _accelerator = await _context.CreatePreferredAcceleratorAsync();
            if (_accelerator == null)
            {
                _error = "No GPU accelerator available (need WebGPU).";
                return;
            }

            _pipeline?.Dispose(); _flux?.Dispose(); _flux3?.Dispose(); _pipeline = null; _flux = null; _flux3 = null;
            if (_model == "flux3")
            {
                // only the tokenizer and the small VAE decoder load now; the text encoder and the transformer stream in per picture (the transformer then stays: the next picture skips the 3.5 GB reload)
                _flux3 = await SpawnDev.ILGPU.ML.Flux3.Flux3Pipeline.CreateAsync(_accelerator, ModelSource, Flux3Repo, (stage, pct) =>
                {
                    _modelStatusText = $"FLUX 3 Klein — {stage}"; _modelProgress = pct; InvokeAsync(StateHasChanged);
                });
                _flux3.KeepTransformerResident = true;      // the next picture skips the 3.5 GB reload (Chrome 151.0.7922.174 killed the GPU process on the third picture with this on: a Chrome bug, fixed in later versions; Plans/chrome-151-resident-flux3-device-loss-2026-10-20.md)
                _modelStatusText = "FLUX 3 Klein";
                _isModelLoaded = true;
                return;
            }
            if (_model == "flux2")
            {
                // only the tokenizer and the small VAE load now; the encoder and the transformer stream in per picture and leave again
                _flux = await SpawnDev.ILGPU.ML.Flux2.Flux2Pipeline.CreateAsync(_accelerator, ModelSource, FluxRepo, 512, (stage, pct) =>
                {
                    _modelStatusText = $"FLUX.2 klein — {stage}"; _modelProgress = pct; InvokeAsync(StateHasChanged);
                });
                _flux.KeepTransformerResident = true;        // this page does nothing else with the GPU: the next picture skips the 2.4 GB reload
                _modelStatusText = "FLUX.2 klein";
                _isModelLoaded = true;
                return;
            }
            // HubModelSource streams ONNX weights over HTTP into OPFS — never a 1.7GB U-Net byte[].
            _pipeline = await SpawnDev.ILGPU.ML.Pipelines.ImageGenerationPipeline.CreateAsync(
                _accelerator, ModelSource, onProgress: (stage, pct) =>
                {
                    _modelStatusText = $"SD Turbo — {stage}";
                    _modelProgress = pct;
                    InvokeAsync(StateHasChanged);
                });

            if (_pipeline == null || !_pipeline.IsReady)
            {
                _error = "SD-Turbo pipeline failed to become ready after load.";
                _pipeline?.Dispose();
                _pipeline = null;
                return;
            }

            _modelStatusText = "SD Turbo";
            _isModelLoaded = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Console.WriteLine($"[Generate] Load error: {ex}");
            _pipeline?.Dispose();
            _pipeline = null;
            _isModelLoaded = false;
        }
        finally
        {
            _isModelLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleBackendChange(string backend)
    {
        bool wasLoaded = _isModelLoaded;
        _pipeline?.Dispose();
        _pipeline = null;
        _accelerator?.Dispose();
        _accelerator = null;
        _isModelLoaded = false;
        // Opt-in: only re-load if the model was already in use.
        if (wasLoaded)
            await LoadModelAsync();
        else
            StateHasChanged();
    }

    private async Task GenerateImage()
    {
        if (string.IsNullOrWhiteSpace(_prompt)) return;
        _error = null;
        _generatedImageUrl = null;
        _gallery.Clear();

        // Lazy load on first generate — matches AiImageEngine.
        if (!_isModelLoaded && !_isModelLoading)
            await LoadModelAsync();
        if ((_pipeline == null && _flux == null && _flux3 == null) || !_isModelLoaded) return;

        _isRunning = true;
        _currentStep = 0;
        StateHasChanged();
        await Task.Yield();

        try
        {
            int baseSeed = _seed ?? Environment.TickCount & 0x7FFFFFFF;
            var (pw, ph) = PictureSize();
            var total = System.Diagnostics.Stopwatch.StartNew();
            _gallery.Clear();
            // FLUX 3 draws from a full scene caption: written once for every picture of this click, with the transformer off the GPU while the language model runs
            string caption = _prompt;
            if (_flux3 != null && _expandPrompt && _references.Count == 0) caption = await ExpandPromptAsync(pw, ph);
            _usedCaption = _flux3 != null && caption != _prompt ? caption : null;
            for (int n = 0; n < _pictures; n++)
            {
                int seed = baseSeed + n;
                _currentStep = 0;
                string label = _pictures > 1 ? $" ({n + 1}/{_pictures})" : "";
                byte[] rgba; int w, h;
                if (_flux3 != null)
                {
                    var image = await _flux3.RunAsync(new SpawnDev.ILGPU.ML.Flux3.Flux3Request
                    {
                        Caption = caption, Seed = seed, Width = pw, Height = ph, References = _references.Count > 0 ? _references : null,
                        Progress = (stage, i, c) => { _modelStatusText = $"FLUX 3 Klein{label} — {stage}"; _currentStep = stage.StartsWith("denoise") ? i + 1 : 0; _numSteps = 16; _ = InvokeAsync(StateHasChanged); },
                    });
                    (rgba, w, h) = (image.Rgba, image.Width, image.Height); _numSteps = 16;
                    _timings = string.Join(" · ", _flux3.LastTimings.Select(t => $"{t.Stage} {t.Seconds:F1} s"));
                }
                else if (_flux != null)
                {
                    var image = await _flux.RunAsync(new SpawnDev.ILGPU.ML.Flux2.Flux2Request
                    {
                        Prompt = _prompt, Seed = seed, Size = _fluxSize, Width = _references.Count > 0 ? pw : 0, Height = _references.Count > 0 ? ph : 0, References = _references.Count > 0 ? _references : null, Steps = 4,
                        Progress = (stage, i, c) => { _modelStatusText = $"FLUX.2 klein{label} — {stage}"; _currentStep = stage.StartsWith("denoise") ? i + 1 : 0; _numSteps = 4; _ = InvokeAsync(StateHasChanged); },
                    });
                    (rgba, w, h) = (image.Rgba, image.Width, image.Height); _numSteps = 4;
                }
                else
                {
                    _pipeline!.NumInferenceSteps = Math.Max(1, _numSteps);
                    _pipeline.GuidanceScale = _guidanceScale;
                    _pipeline.Width = _imageSize;
                    _pipeline.Height = _imageSize;
                    _pipeline.Seed = seed;
                    _pipeline.OnProgress += OnPipelineProgress;
                    try
                    {
                        var result = await _pipeline.RunAsync(new SpawnDev.ILGPU.ML.Pipelines.ImageGenerationInput { Prompt = _prompt, NegativePrompt = _negativePrompt });
                        (rgba, w, h) = (result.ImageRGBA, result.Width, result.Height); seed = result.Seed;
                    }
                    finally { _pipeline.OnProgress -= OnPipelineProgress; }
                }
                var url = Services.ImageDisplayHelper.ToDataUrl(JS, rgba, w, h);
                _gallery.Add(new GalleryItem(seed, url));
                _generatedImageUrl = url; _usedSeed = seed; _resultWidth = w; _resultHeight = h;
                _inferenceMs = total.Elapsed.TotalMilliseconds;
                await InvokeAsync(StateHasChanged);
            }
            _modelStatusText = ModelLabel;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Console.WriteLine($"[Generate] Error: {ex}");
        }

        _isRunning = false;
        StateHasChanged();
    }

    private void OnPipelineProgress(int step, int total)
    {
        _currentStep = step;
        _numSteps = total;
        _ = InvokeAsync(StateHasChanged);
    }

    private void DownloadResult() => DownloadUrl(_generatedImageUrl, _usedSeed);

    private void DownloadPicture(GalleryItem item) => DownloadUrl(item.Url, item.Seed);

    private void DownloadUrl(string? url, int seed)
    {
        if (url == null) return;
        try
        {
            using var document = JS.Get<SpawnDev.SpawnJS.JSObjects.Document>("document");
            using var link = document.CreateElement<SpawnDev.SpawnJS.JSObjects.HTMLAnchorElement>("a");
            link.Href = url;
            link.Download = $"generated-{seed}.png";
            using var body = document.Body!;
            body.AppendChild(link);
            link.Click();
            body.RemoveChild(link);
        }
        catch { }
    }

    private void ClearResult() { _generatedImageUrl = null; _gallery.Clear(); _currentStep = 0; _error = null; StateHasChanged(); }

    public void Dispose()
    {
        _pipeline?.Dispose();
        _flux?.Dispose();
        _flux3?.Dispose();
        _accelerator?.Dispose();
        _context?.Dispose();
    }
}
