</style>

@code {
    // Same path SpawnDev.AI.AiImageEngine uses: ImageGenerationPipeline.CreateAsync + RunAsync.
    // Evidence: SDTurbo_Generate_E2E (HeavyModel) + SDTurbo_WebGPU_ImageGen_MultiGen.
    // The prior "Coming soon" stub never called LoadModelAsync, so Generate stayed disabled forever.
    private string _selectedBackend = "WebGPU";
    private string _prompt = "a photo of a cat";
    private string _negativePrompt = "";
    private bool _showNegative;
    private int _numSteps = 1;
    private float _guidanceScale = 0;
    private int? _seed;
    private int _usedSeed;
    private int _imageSize = 512;
    private int _currentStep;
    private bool _isRunning, _isModelLoading, _isModelLoaded;
    private double _modelProgress, _inferenceMs;
    private string? _generatedImageUrl;
    private string? _error;
    private string _modelStatusText = "SD Turbo";

    private string GenerateButtonLabel =>
        _isModelLoading ? "Loading…"
        : _isRunning ? "Generating…"
        : !_isModelLoaded ? "Download & Generate"
        : "Generate";

    private List<BackendSelector.BackendInfo> _backends = new()
    {
        new() { Id = "WebGPU", DisplayName = "WebGPU" },
    };

    [Inject] SpawnJS.SpawnJSRuntime JS { get; set; } = default!;
    [Inject] SpawnDev.ILGPU.ML.Hub.HubModelSource ModelSource { get; set; } = default!;
    [Inject] HttpClient Http { get; set; } = default!;
    private global::ILGPU.Runtime.Accelerator? _accelerator;
    private global::ILGPU.Context? _context;
    private SpawnDev.ILGPU.ML.Pipelines.ImageGenerationPipeline? _pipeline;

    // OPT-IN: ~2.5 GB SD-Turbo is NOT downloaded on page entry. First Generate click loads it
    // (same lazy residency as SpawnDev.AI.AiImageEngine.GenerateAsync).

    private async Task LoadModelAsync()
    {
        try
        {
            _error = null;
            _isModelLoading = true;
            StateHasChanged();

            if (_context == null)
            {
                var builder = SpawnDev.ILGPU.ML.MLContext.Create();
                await builder.AllAcceleratorsAsync();
                _context = builder.ToContext();
            }
            _accelerator?.Dispose();
            _accelerator = await _context.CreatePreferredAcceleratorAsync();
            if (_accelerator == null)
            {
                _error = "No GPU accelerator available (need WebGPU).";
                return;
            }

            _pipeline?.Dispose();
            // HubModelSource streams ONNX weights over HTTP into OPFS — never a 1.7GB U-Net byte[].
            _pipeline = await SpawnDev.ILGPU.ML.Pipelines.ImageGenerationPipeline.CreateAsync(
                _accelerator, ModelSource, onProgress: (stage, pct) =>
                {
                    _modelStatusText = $"SD Turbo — {stage}";
                    _modelProgress = pct;
                    InvokeAsync(StateHasChanged);
                });

            if (_pipeline == null || !_pipeline.IsReady)
            {
                _error = "SD-Turbo pipeline failed to become ready after load.";
                _pipeline?.Dispose();
                _pipeline = null;
                return;
            }

            _modelStatusText = "SD Turbo";
            _isModelLoaded = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Console.WriteLine($"[Generate] Load error: {ex}");
            _pipeline?.Dispose();
            _pipeline = null;
            _isModelLoaded = false;
        }
        finally
        {
            _isModelLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleBackendChange(string backend)
    {
        bool wasLoaded = _isModelLoaded;
        _pipeline?.Dispose();
        _pipeline = null;
        _accelerator?.Dispose();
        _accelerator = null;
        _isModelLoaded = false;
        // Opt-in: only re-load if the model was already in use.
        if (wasLoaded)
            await LoadModelAsync();
        else
            StateHasChanged();
    }

    private async Task GenerateImage()
    {
        if (string.IsNullOrWhiteSpace(_prompt)) return;
        _error = null;
        _generatedImageUrl = null;

        // Lazy load on first generate — matches AiImageEngine.
        if (!_isModelLoaded && !_isModelLoading)
            await LoadModelAsync();
        if (_pipeline == null || !_isModelLoaded) return;

        _isRunning = true;
        _currentStep = 0;
        StateHasChanged();
        await Task.Yield();

        try
        {
            _pipeline.NumInferenceSteps = Math.Max(1, _numSteps);
            _pipeline.GuidanceScale = _guidanceScale;
            _pipeline.Width = _imageSize;
            _pipeline.Height = _imageSize;
            _pipeline.Seed = _seed;
            _pipeline.OnProgress += OnPipelineProgress;

            var result = await _pipeline.RunAsync(new SpawnDev.ILGPU.ML.Pipelines.ImageGenerationInput
            {
                Prompt = _prompt,
                NegativePrompt = _negativePrompt,
            });

            _pipeline.OnProgress -= OnPipelineProgress;

            _inferenceMs = result.InferenceTimeMs;
            _usedSeed = result.Seed;
            _generatedImageUrl = Services.ImageDisplayHelper.ToDataUrl(JS, result.ImageRGBA, result.Width, result.Height);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Console.WriteLine($"[Generate] Error: {ex}");
            if (_pipeline != null)
                _pipeline.OnProgress -= OnPipelineProgress;
        }

        _isRunning = false;
        StateHasChanged();
    }

    private void OnPipelineProgress(int step, int total)
    {
        _currentStep = step;
        _numSteps = total;
        _ = InvokeAsync(StateHasChanged);
    }

    private void DownloadResult()
    {
        if (_generatedImageUrl == null) return;
        try
        {
            using var document = JS.Get<SpawnDev.SpawnJS.JSObjects.Document>("document");
            using var link = document.CreateElement<SpawnDev.SpawnJS.JSObjects.HTMLAnchorElement>("a");
            link.Href = _generatedImageUrl;
            link.Download = $"generated-{_usedSeed}.png";
            using var body = document.Body!;
            body.AppendChild(link);
            link.Click();
            body.RemoveChild(link);
        }
        catch { }
    }

    private void ClearResult() { _generatedImageUrl = null; _currentStep = 0; _error = null; StateHasChanged(); }

    public void Dispose()
    {
        _pipeline?.Dispose();
        _accelerator?.Dispose();
        _context?.Dispose();
    }
}
