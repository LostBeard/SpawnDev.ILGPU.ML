    .gen-prompt-row { display: flex; gap: 0.5rem; }
    .gen-prompt-input {
        flex: 1;
        padding: 0.6rem 0.75rem;
        border-radius: 8px;
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(255,255,255,0.04);
        color: #e2e8f0;
        font-size: 0.95rem;
    }
    .gen-prompt-input::placeholder { color: #475569; }
    .gen-prompt-input:focus { border-color: rgba(139,92,246,0.5); outline: none; }
    .gen-btn {
        padding: 0.6rem 1.5rem;
        border-radius: 8px;
        border: none;
