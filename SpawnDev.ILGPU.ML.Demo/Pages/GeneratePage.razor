@page "/generate"
@using SpawnDev.SpawnJS
@using SpawnDev.ILGPU.ML
@implements IDisposable

<PageTitle>Image Generation — SpawnDev.ILGPU.ML</PageTitle>

<DemoLayout Title="Image Generation"
            Description="Generate images from text, or edit and combine your own pictures, on your GPU: FLUX 3 Image Klein 5.6B (16 steps), FLUX.2 klein 4B (4 steps), both with up to 10 reference images, or SD-Turbo (one step). Nothing leaves your machine."
            AvailableBackends="@_backends"
            SelectedBackend="@_selectedBackend"
            SelectedBackendChanged="@((v) => _selectedBackend = v)"
            OnBackendChange="@HandleBackendChange"
            InferenceTimeMs="@_inferenceMs"
            IsRunning="@_isRunning"
            ShowModelProgress="true"
            ModelName="@_modelStatusText"
            IsModelLoading="@_isModelLoading"
            IsModelLoaded="@_isModelLoaded"
            ModelProgressPercent="@_modelProgress"
            ModelSizeMB="@(_model == "flux3" ? 5900 : _model == "flux2" ? 4600 : 2500)">

    <div class="gen-prompt-section">
        <label class="gen-label">Prompt:</label>
        <div class="gen-prompt-row">
            <textarea class="gen-prompt-input" rows="@(_model == "flux3" ? 5 : 1)" @bind="_prompt" @bind:event="oninput"
                      placeholder="@(_model == "flux3" ? "FLUX 3 draws from a full scene caption: medium and style, the scene, lighting and camera, each subject with its colours, materials and position in the frame. A short prompt gives a generic picture." : "A serene mountain landscape at sunset with a lake reflection")"
                      disabled="@(_isModelLoading || _isRunning)"></textarea>
            <button class="gen-btn" @onclick="GenerateImage"
                    disabled="@(string.IsNullOrWhiteSpace(_prompt) || _isModelLoading || _isRunning)">
                @GenerateButtonLabel
            </button>
        </div>

        <div class="gen-settings">
            <div class="gen-setting">
                <label>Model:</label>
                <select @bind="_model" @bind:after="ModelChanged" class="gen-setting-select" disabled="@(_isRunning || _isModelLoading)">
                    <option value="flux3">FLUX 3 Image Klein 5.6B (best, 5.9 GB, non-commercial licence)</option>
                    <option value="flux2">FLUX.2 klein 4B (sharper, 4.6 GB)</option>
                    <option value="sd">SD Turbo (faster, 2.5 GB)</option>
                </select>
            </div>
            @if (_model == "flux2" || _model == "flux3")
            {
            <div class="gen-setting">
                <label>@(_references.Count > 0 ? "Longer side:" : "Size:")</label>
                <select @bind="_fluxSize" class="gen-setting-select" disabled="@(_isRunning)" title="Larger pictures are decoded in 512 px tiles, so memory stays flat; the transformer's work grows with the area. With reference images the picture keeps the first reference's proportions.">
                    <option value="512">@(_references.Count > 0 ? "512 px" : "512x512")</option>
                    <option value="768">@(_references.Count > 0 ? "768 px" : "768x768")</option>
                    <option value="1024">@(_references.Count > 0 ? "1024 px" : "1024x1024")</option>
                </select>
            </div>
            }
            @if (_model == "flux3" && _references.Count == 0)
            {
            <div class="gen-setting">
                <label title="FLUX 3 draws from a full scene caption. A small local language model (Qwen3 4B, a 2.5 GB download, freed afterwards) writes one from your prompt with Black Forest Labs' own upsampler instructions.">
                    <input type="checkbox" @bind="_expandPrompt" disabled="@(_isRunning)" /> Write the full caption for me (Qwen3 4B, 2.5 GB)
                </label>
            </div>
            }
            @if (_model == "sd")
            {
            <div class="gen-setting">
                <label>Steps:</label>
                <input type="number" min="1" max="50" @bind="_numSteps" class="gen-setting-input" disabled="@(_isRunning)" />
            </div>
            <div class="gen-setting">
                <label>Guidance:</label>
                <input type="number" min="0" max="20" step="0.5" @bind="_guidanceScale" class="gen-setting-input" disabled="@(_isRunning)" title="SD-Turbo is designed for guidance 0" />
            </div>
            <div class="gen-setting">
                <label>Size:</label>
                <select @bind="_imageSize" class="gen-setting-select" disabled="@(_isRunning)">
                    <option value="256">256x256</option>
                    <option value="512">512x512</option>
                </select>
            </div>
            }
            <div class="gen-setting">
                <label>Pictures:</label>
                <select @bind="_pictures" class="gen-setting-select" disabled="@(_isRunning)" title="Draw several pictures of the prompt (consecutive seeds) and choose.">
                    <option value="1">1</option>
                    <option value="4">4</option>
                    <option value="8">8</option>
                </select>
            </div>
            <div class="gen-setting">
                <label>Seed:</label>
                <input type="number" @bind="_seed" class="gen-setting-input" placeholder="random" disabled="@(_isRunning)" />
            </div>
        </div>

        @if (_model == "flux2" || _model == "flux3")
        {
            <ReferenceImages @ref="_refs" MaxImages="10" MaxSide="768" Disabled="@(_isRunning || _isModelLoading)" ReferencesChanged="@OnReferencesChanged" />
        }

        @if (_model == "sd")
        {
            @if (!string.IsNullOrEmpty(_negativePrompt) || _showNegative)
            {
                <div class="gen-negative">
                    <label class="gen-label">Negative prompt:</label>
                    <input type="text" class="gen-prompt-input" @bind="_negativePrompt"
                           placeholder="blurry, low quality, distorted" disabled="@(_isRunning)" />
                </div>
            }
            else
            {
                <button class="gen-toggle-neg" @onclick="() => _showNegative = true">+ Negative prompt</button>
            }
        }
    </div>

    @if (_isRunning && _currentStep > 0)
    {
        <div class="gen-progress">
            <div class="gen-progress-bar">
                <div class="gen-progress-fill" style="width: @(_currentStep * 100.0 / Math.Max(1, _numSteps))%"></div>
            </div>
            <span class="gen-progress-text">Step @_currentStep / @_numSteps</span>
        </div>
    }

    @if (_writingCaption)
    {
        <details class="gen-caption" open><summary>Writing the caption</summary><p style="white-space:pre-wrap">@_liveCaption</p></details>
    }

    @if (_generatedImageUrl != null)
    {
        <div class="gen-result">
            @if (_gallery.Count > 1)
            {
                <div class="gen-grid">
                    @foreach (var item in _gallery)
                    {
                        <div class="gen-grid-item">
                            <img src="@item.Url" alt="Generated image, seed @item.Seed" />
                            <span class="gen-info-item">seed @item.Seed</span>
                            <button class="action-btn download-btn" @onclick="() => DownloadPicture(item)">Download</button>
                        </div>
                    }
                </div>
            }
            else
            {
                <img src="@_generatedImageUrl" alt="Generated image" class="gen-result-img" />
            }
            <div class="gen-result-info">
                <span class="gen-info-item">@_inferenceMs.ToString("F0")ms</span>
                <span class="gen-info-item">@_resultWidth x @_resultHeight</span>
                <span class="gen-info-item">@_numSteps steps</span>
                <span class="gen-info-item">Seed: @_usedSeed</span>
            </div>
            @if (!string.IsNullOrEmpty(_timings))
            {
                <div class="gen-result-info"><span class="gen-info-item">last picture: @_timings</span></div>
            }
            @if (!string.IsNullOrEmpty(_usedCaption))
            {
                <details class="gen-caption"><summary>Caption used</summary><p>@_usedCaption</p></details>
            }
            <div class="result-actions">
                @if (_gallery.Count <= 1)
                {
                    <button class="action-btn download-btn" @onclick="DownloadResult">Download</button>
                }
                <button class="action-btn clear-btn" @onclick="ClearResult">New Generation</button>
            </div>
        </div>
    }

    @if (!_isModelLoaded && !_isModelLoading)
    {
        <div class="model-needed">
            @(_model == "flux3" ? "FLUX 3 Image Klein is ~5.9 GB (4-bit text encoder, transformer and VAE; two of them are on the GPU at a time; the 140 MB VAE encoder comes with your first reference image). Its weights are under the FLUX Kommunity License: non-commercial use" : _model == "flux2" ? "FLUX.2 klein is ~4.6 GB (4-bit text encoder, transformer and VAE; two of them are on the GPU at a time)" : "SD-Turbo is ~2.5 GB (text encoder + U-Net + VAE)"). Enter a prompt and click
            <strong>Download &amp; Generate</strong> — weights stream from the hub into OPFS on first use
            (same path as SpawnDev.AI). Cached after that. Manage cache on
            <a href="cache">Model Cache</a>.
        </div>
    }

    @if (_error != null)
    {
        <div class="error-banner">@_error</div>
    }

    <PrivacyBadge />

    <PipelineHowTo SourceFile="Pages/GeneratePage.razor" Note="FLUX 3 Image Klein 5.6B (Black Forest Labs, FLUX Kommunity License, non-commercial; modified 4-bit export LostBeard/flux-3-image-klein-q4-ILGPU), FLUX.2 klein 4B (Black Forest Labs, Apache-2.0; 4-bit export LostBeard/FLUX.2-klein-4B-q4-ILGPU) and SD-Turbo" />

</DemoLayout>

