    .gen-btn:disabled { opacity: 0.5; cursor: not-allowed; }

    .gen-settings { display: flex; gap: 1rem; margin-top: 0.75rem; flex-wrap: wrap; }
    .gen-setting { display: flex; align-items: center; gap: 0.3rem; }
    .gen-setting label { color: #64748b; font-size: 0.8rem; }
    .gen-setting-input {
        width: 70px;
        padding: 0.3rem 0.5rem;
        border-radius: 6px;
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(255,255,255,0.04);
        color: #e2e8f0;
        font-size: 0.8rem;
        text-align: center;
    }
    .gen-setting-select {
        padding: 0.3rem 0.5rem;
        border-radius: 6px;
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(255,255,255,0.04);
        color: #e2e8f0;
        font-size: 0.8rem;
    }
