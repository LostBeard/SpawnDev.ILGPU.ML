@page "/tts"
@using System.Text
@using SpawnDev.AsyncFileSystem
@using SpawnDev.ILGPU.ML
@using SpawnDev.ILGPU.ML.Hub
@using SpawnDev.ILGPU.ML.Pipelines
@using SpawnDev.ILGPU.ML.Preprocessing
@using SpawnDev.Phonemizer
@using SpawnDev.SpawnJS
@implements IDisposable
@inject SpawnJSRuntime JS
@inject HttpClient Http
@inject HubModelSource ModelSource
@inject IAsyncFS AsyncFS

<PageTitle>Text to Speech — SpawnDev.ILGPU.ML</PageTitle>

<DemoLayout Title="Text to Speech"
            Description="Type text, hear it spoken. Built-in Kokoro voices (faster than realtime) or one-shot ZipVoice cloning with saved voices — all on your GPU, no server."
            AvailableBackends="@_backends"
            SelectedBackend="@_selectedBackend"
            SelectedBackendChanged="@((v) => _selectedBackend = v)"
            OnBackendChange="@HandleBackendChange"
            InferenceTimeMs="@_inferenceMs"
            IsRunning="@_isRunning"
            ShowModelProgress="true"
            ModelName="@(_mode == "kokoro" ? "Kokoro-82M" : "ZipVoice distill int8")"
            IsModelLoading="@_isModelLoading"
            IsModelLoaded="@(_mode == "kokoro" ? _kokoroLoaded : _zipLoaded)"
            ModelProgressPercent="@_modelProgress"
            ModelSizeMB="@(_mode == "kokoro" ? 326 : 200)">

    <div class="tts-mode-toggle">
        <button class="mode-btn @(_mode == "kokoro" ? "active" : "")" @onclick='() => SetMode("kokoro")'>Kokoro voices</button>
        <button class="mode-btn @(_mode == "clone" ? "active" : "")" @onclick='() => SetMode("clone")'>Clone a voice</button>
    </div>

    @if (_mode == "kokoro")
    {
        <div class="tts-row">
            <label class="tts-label">Voice</label>
            <select class="tts-select" @bind="_kokoroVoice">
                @foreach (var name in KokoroVoicePack.EnglishVoiceNames)
                {
                    <option value="@name">@FormatVoiceName(name)</option>
                }
            </select>
        </div>
    }
    else
    {
        <div class="clone-panel">
            <div class="tts-row">
                <label class="tts-label">Saved voice</label>
                <select class="tts-select" @bind="_selectedSavedId">
                    <option value="">— pick or save one below —</option>
                    @foreach (var v in _savedVoices)
                    {
                        <option value="@v.Id">@v.DisplayName (@FormatDuration(v))</option>
                    }
                </select>
                @if (!string.IsNullOrEmpty(_selectedSavedId))
                {
                    <button class="tts-link-btn" @onclick="DeleteSelectedVoice" disabled="@_isRunning">Delete</button>
                }
            </div>

            <details class="clone-add" open="@(_savedVoices.Count == 0)">
                <summary>Save a new cloned voice</summary>
                <p class="clone-hint">
                    Record or upload a few seconds of clean speech, and type the EXACT words spoken.
                    ZipVoice clones from that clip; a wrong transcript bleeds into every line.
                </p>
                <div class="tts-row">
                    <label class="tts-label">Name</label>
                    <input class="tts-input" @bind="_newVoiceName" placeholder="e.g. My voice" />
                </div>
                <div class="tts-row">
                    <label class="tts-label">Transcript</label>
                    <input class="tts-input" @bind="_newVoiceTranscript" placeholder="Exact words in the clip" />
                </div>
                <div class="tts-mode-toggle clone-src">
                    <button class="mode-btn @(_cloneSrc == "mic" ? "active" : "")" @onclick='() => _cloneSrc = "mic"'>Microphone</button>
                    <button class="mode-btn @(_cloneSrc == "file" ? "active" : "")" @onclick='() => _cloneSrc = "file"'>Upload WAV</button>
                </div>
                @if (_cloneSrc == "mic")
                {
                    <div class="mic-row">
                        @if (!_isRecording)
                        {
                            <button class="mic-btn" @onclick="StartCloneRecording" disabled="@_isRunning">Record reference</button>
                        }
                        else
                        {
                            <button class="mic-btn recording" @onclick="StopCloneRecording">Stop (@_recordingSeconds.ToString("F1")s)</button>
                        }
                    </div>
                }
                else
                {
                    <div class="upload-zone">
                        <p>Drop a short WAV (mono or stereo)</p>
                        <InputFile OnChange="HandleCloneFile" accept="audio/wav,.wav" class="file-input" />
                    </div>
                }
                @if (_pendingRefSamples != null)
                {
                    <div class="ref-ready">
                        Reference ready: @((_pendingRefSamples.Length / (double)_pendingRefRate).ToString("F1"))s
                        at @_pendingRefRate Hz
                    </div>
                }
                <button class="speak-btn secondary" @onclick="SaveClonedVoice"
                        disabled="@(_isRunning || _pendingRefSamples == null || string.IsNullOrWhiteSpace(_newVoiceTranscript))">
                    Save voice
                </button>
            </details>
        </div>
    }

    <div class="tts-text-block">
        <label class="tts-label">Text to speak</label>
        <textarea class="tts-textarea" @bind="_text" rows="4"
                  placeholder="Type something to hear…"></textarea>
    </div>

    <div class="tts-actions">
        <button class="speak-btn" @onclick="SpeakAsync"
                disabled="@(_isRunning || _isModelLoading || string.IsNullOrWhiteSpace(_text))">
            @(_isRunning ? "Speaking…" : "Speak")
        </button>
        @if (_lastSamples != null)
        {
            <button class="speak-btn secondary" @onclick="PlayLast" disabled="@_isRunning">Play again</button>
            <button class="speak-btn secondary" @onclick="DownloadWav" disabled="@_isRunning">Download WAV</button>
        }
    </div>

    @if (!string.IsNullOrEmpty(_status))
    {
        <div class="tts-status">@_status</div>
    }
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="tts-error">@_error</div>
    }

    @if (!_kokoroLoaded && !_zipLoaded && !_isModelLoading)
    {
        <div class="model-needed">
            Models load on first Speak (or Save for clone). Kokoro ~326 MB; ZipVoice encoder/decoder/vocoder ~200 MB. Cached in OPFS after the first download.
        </div>
    }

    <PrivacyBadge />

    <PipelineHowTo SourceFile="Pages/TextToSpeechPage.razor"
                   RelatedFiles='@(new[] { "VoiceLibrary.cs" })'
                   Note="Kokoro + ZipVoice TTS" />

</DemoLayout>

<style>
    .tts-mode-toggle { display: flex; border-radius: 6px; overflow: hidden; border: 1px solid rgba(255,255,255,0.1); margin-bottom: 1rem; width: fit-content; }
    .mode-btn { padding: 0.35rem 0.85rem; border: none; background: rgba(255,255,255,0.04); color: #64748b; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: all 0.15s; }
    .mode-btn.active { background: rgba(139,92,246,0.2); color: #e2e8f0; }
    .clone-src { margin: 0.75rem 0; }

    .tts-row { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; flex-wrap: wrap; }
    .tts-label { color: #94a3b8; font-size: 0.85rem; font-weight: 600; min-width: 5.5rem; }
    .tts-select, .tts-input {
        flex: 1; min-width: 12rem; padding: 0.45rem 0.65rem; border-radius: 6px;
        border: 1px solid rgba(255,255,255,0.12); background: rgba(0,0,0,0.25); color: #e2e8f0; font-size: 0.9rem;
    }
    .tts-textarea {
        width: 100%; padding: 0.75rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.12);
        background: rgba(0,0,0,0.25); color: #e2e8f0; font-size: 0.95rem; line-height: 1.5; resize: vertical;
        font-family: inherit; box-sizing: border-box;
    }
    .tts-text-block { margin: 1rem 0; }
    .tts-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.75rem; }
    .speak-btn {
        padding: 0.55rem 1.25rem; border-radius: 8px; border: 1px solid rgba(139,92,246,0.4);
        background: rgba(139,92,246,0.2); color: #e2e8f0; font-weight: 600; cursor: pointer;
    }
