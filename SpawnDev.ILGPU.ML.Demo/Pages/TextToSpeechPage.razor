    .speak-btn.secondary { border-color: rgba(255,255,255,0.15); background: rgba(255,255,255,0.06); }
    .tts-link-btn {
        padding: 0.35rem 0.65rem; border-radius: 6px; border: 1px solid rgba(239,68,68,0.35);
        background: transparent; color: #fca5a5; font-size: 0.8rem; cursor: pointer;
    }

    .clone-panel { margin-bottom: 0.5rem; }
