@page "/detect"
@using SpawnDev.SpawnJS
@using SpawnDev.ILGPU.ML
@using SpawnDev.ILGPU.ML.Pipelines
@using SpawnDev.ILGPU.WebGPU
@using SpawnDev.ILGPU.WebGPU.Backend
@implements IDisposable

<PageTitle>Object Detection — SpawnDev.ILGPU.ML</PageTitle>

<DemoLayout Title="Object Detection"
            Description="Real-time object detection using YOLOv8-Nano. Use your webcam or upload an image."
            AvailableBackends="@_backends"
            SelectedBackend="@_selectedBackend"
            SelectedBackendChanged="@((v) => _selectedBackend = v)"
            OnBackendChange="@HandleBackendChange"
            InferenceTimeMs="@_inferenceMs"
            IsRunning="@_isRunning"
            ShowFps="@_useWebcam"
            ShowModelProgress="true"
            ModelName="YOLOv8-Nano"
            IsModelLoading="@_isModelLoading"
            IsModelLoaded="@_isModelLoaded"
            ModelProgressPercent="@_modelProgress"
            ModelSizeMB="12.2">

    <div class="detect-controls">
        <label class="threshold-label">Confidence:</label>
        <input type="range" min="10" max="95" step="5" @bind="_confidenceThreshold" class="threshold-slider" />
        <span class="threshold-value">@_confidenceThreshold%</span>

        <div class="mode-toggle">
            <button class="mode-btn @(!_useWebcam ? "active" : "")" @onclick="SwitchToImage">Image</button>
            <button class="mode-btn @(_useWebcam ? "active" : "")" @onclick="SwitchToWebcam">Webcam</button>
        </div>
    </div>

    @if (_useWebcam)
    {
        <BoundingBoxOverlay Detections="@_detections"
                            ImageWidth="640" ImageHeight="480"
                            ConfidenceThreshold="@(_confidenceThreshold / 100f)">
            <WebcamCapture OnFrameCaptured="@HandleFrame"
                           AutoCapture="@_isModelLoaded"
                           CaptureIntervalMs="100"
                           ShowCaptureButton="true"
                           Width="640" Height="480" />
        </BoundingBoxOverlay>
    }
    else if (_imageDataUrl != null)
    {
        <BoundingBoxOverlay Detections="@_detections"
                            ImageWidth="@_imageWidth" ImageHeight="@_imageHeight"
                            ConfidenceThreshold="@(_confidenceThreshold / 100f)">
            <img src="@_imageDataUrl" alt="Input" style="max-width:100%; display:block;" />
        </BoundingBoxOverlay>
        <div class="result-actions">
            <button class="action-btn" @onclick="ClearStillImage">Try Another Image</button>
        </div>
    }
    else
    {
        <ImageDropZone @bind-ImageDataUrl="_imageDataUrl"
                       OnImageLoaded="@HandleImageLoaded"
                       SampleImages="@_detectSamples" />
    }

    @if (_detections?.Any() == true)
    {
        <div class="detection-summary">
            @foreach (var group in _detections
                .Where(d => d.Confidence >= _confidenceThreshold / 100f)
                .GroupBy(d => d.Label)
                .OrderByDescending(g => g.Count()))
            {
                <span class="detection-chip">@group.Key (@group.Count())</span>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="error-banner">@_error</div>
    }
    else if (!_isModelLoaded && !_isModelLoading)
    {
        <div class="model-needed">
            YOLOv8-Nano (~12&nbsp;MB) loads on your first image or Capture click.
        </div>
    }

    <PrivacyBadge />

    <PipelineHowTo SourceFile="Pages/DetectPage.razor" Note="YOLOv8" />

</DemoLayout>

<style>
    .detect-controls {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
    }

    .threshold-label { color: #64748b; font-size: 0.85rem; }

    .threshold-slider { width: 120px; accent-color: #8b5cf6; }

    .threshold-value {
        color: #94a3b8;
        font-size: 0.8rem;
        font-family: 'JetBrains Mono', 'Consolas', monospace;
        min-width: 35px;
    }

    .mode-toggle {
        display: flex;
        border-radius: 6px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.1);
        margin-left: auto;
    }

    .mode-btn {
        padding: 0.3rem 0.75rem;
        border: none;
        background: rgba(255, 255, 255, 0.04);
        color: #64748b;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .mode-btn.active { background: rgba(139, 92, 246, 0.2); color: #e2e8f0; }
    .mode-btn:hover:not(.active) { background: rgba(255, 255, 255, 0.08); }

    .detection-summary {
        display: flex;
        gap: 0.4rem;
        flex-wrap: wrap;
        margin-top: 0.75rem;
    }

    .detection-chip {
        padding: 0.2rem 0.6rem;
        border-radius: 12px;
        background: rgba(139, 92, 246, 0.12);
        border: 1px solid rgba(139, 92, 246, 0.25);
        color: #c4b5fd;
        font-size: 0.78rem;
        font-weight: 600;
    }

    .model-needed {
        margin-top: 1rem;
        padding: 0.75rem 1rem;
        background: rgba(245, 158, 11, 0.08);
        border: 1px solid rgba(245, 158, 11, 0.2);
        border-radius: 8px;
        color: #fbbf24;
        font-size: 0.85rem;
    }

    .error-banner {
        margin-top: 1rem;
        padding: 0.75rem 1rem;
        background: rgba(248, 113, 113, 0.1);
        border: 1px solid rgba(248, 113, 113, 0.3);
        border-radius: 8px;
        color: #fca5a5;
        font-size: 0.85rem;
    }

    .result-actions { margin-top: 0.75rem; }

    .action-btn {
        padding: 0.4rem 0.9rem;
        border-radius: 6px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(255, 255, 255, 0.05);
        color: #94a3b8;
        font-size: 0.85rem;
        cursor: pointer;
    }

    .action-btn:hover { background: rgba(255, 255, 255, 0.1); color: #e2e8f0; }
</style>

@code {
    private string _selectedBackend = "WebGPU";
    private string? _imageDataUrl;
    private string? _error;
    private bool _useWebcam;
    private int _confidenceThreshold = 50;
    private bool _isRunning;
    private bool _isModelLoading;
    private bool _isModelLoaded;
    private double _modelProgress;
    private double _inferenceMs;
    private int _imageWidth = 640;
    private int _imageHeight = 480;
    private List<BoundingBoxOverlay.Detection>? _detections;
    private bool _processingFrame;
    private Task? _loadTask;

    private List<ImageDropZone.SampleImage> _detectSamples = new()
    {
        new() { Label = "Cat", Url = "samples/cat.jpg" },
        new() { Label = "Dog", Url = "samples/dog.jpg" },
        new() { Label = "Street", Url = "samples/street.jpg" },
        new() { Label = "Landscape", Url = "samples/landscape.jpg" },
    };

    private List<BackendSelector.BackendInfo> _backends = new()
    {
        new() { Id = "WebGPU", DisplayName = "WebGPU" },
        new() { Id = "WebGL", DisplayName = "WebGL" },
        new() { Id = "Wasm", DisplayName = "Wasm (CPU)" },
    };

    [Inject] SpawnJS.SpawnJSRuntime JS { get; set; } = default!;
    [Inject] HttpClient Http { get; set; } = default!;

    private global::ILGPU.Runtime.Accelerator? _accelerator;
    private global::ILGPU.Context? _context;
    private Pipelines.ObjectDetectionPipeline? _pipeline;

    // OPT-IN: YOLOv8 loads on first image / Capture — not on page entry.
    // Local wwwroot model (same bytes as the hub file) — hub is optional, not required to demo.

    private void SwitchToImage()
    {
        if (!_useWebcam) return;
        _useWebcam = false;
        _detections = null;
        StateHasChanged();
    }

    private void SwitchToWebcam()
    {
        if (_useWebcam) return;
        _useWebcam = true;
        _imageDataUrl = null;
        _detections = null;
        StateHasChanged();
    }

    private void ClearStillImage()
    {
        _imageDataUrl = null;
        _detections = null;
        StateHasChanged();
    }

    private async Task EnsureModelAsync()
    {
        if (_isModelLoaded) return;
        if (_loadTask != null)
        {
            await _loadTask;
            return;
        }
        _loadTask = LoadModelAsync();
        try { await _loadTask; }
        finally { _loadTask = null; }
    }

    private async Task LoadModelAsync()
    {
        try
        {
            _isModelLoading = true;
            _error = null;
            _modelProgress = 5;
            StateHasChanged();

            if (_context == null)
            {
                var builder = MLContext.Create();
                await builder.AllAcceleratorsAsync();
                _context = builder.ToContext();
            }

            _modelProgress = 20;
            StateHasChanged();
            _accelerator?.Dispose();
            _accelerator = await CreateAcceleratorForBackendAsync(_selectedBackend);
            if (_accelerator == null)
            {
                _error = $"No {_selectedBackend} device available";
                return;
            }

            _modelProgress = 40;
            StateHasChanged();

            // Bundled demo copy only — same bytes as the hub file, no hub round-trip.
            // A hub fallback after local failure threw 502 noise and looked like a double load.
            //
            // Known size + cache-bust: same truncated-cache trap as /face (GH Pages HTTP cache
            // can serve a short body whose Content-Length matches the short length). Measured
            // symptom: protobuf "Sub-message extends past end of data" while parsing YOLOv8 ONNX.
            const int yoloBytes = 12823637;
            var modelUrl = $"models/yolov8n/model.onnx?v={yoloBytes}";
            _modelProgress = 50;
            StateHasChanged();
            var bytes = await Http.GetByteArrayAsync(modelUrl);
            Console.WriteLine($"[Detect] downloaded {bytes.Length} bytes (expect {yoloBytes})");
            if (bytes.Length != yoloBytes)
                throw new InvalidDataException(
                    $"YOLOv8 download truncated or corrupt: got {bytes.Length} bytes, expected {yoloBytes}. "
                    + "Unregister the site's service worker (DevTools → Application) and reload.");
            _modelProgress = 70;
            StateHasChanged();
            var session = InferenceSession.CreateFromFile(
                _accelerator, bytes,
                onProgress: (stage, pct) =>
                {
                    _modelProgress = 70 + pct * 0.25;
                    StateHasChanged();
                });

            _pipeline?.Dispose();
            _pipeline = new Pipelines.ObjectDetectionPipeline(session, _accelerator);
            _isModelLoaded = true;
            _modelProgress = 100;
            Console.WriteLine($"[Detect] Model loaded on {_selectedBackend}");
        }
        catch (Exception ex)
        {
            _error = $"Failed to load YOLOv8: {ex.Message}";
            Console.WriteLine($"[Detect] Error: {ex}");
            _isModelLoaded = false;
        }
        finally
        {
            _isModelLoading = false;
            StateHasChanged();
        }
    }

    private async Task<global::ILGPU.Runtime.Accelerator?> CreateAcceleratorForBackendAsync(string backendId)
    {
        if (_context == null) return null;
        try
        {
            return backendId switch
            {
                "WebGPU" => await CreateWebGPUAsync(),
                "WebGL" => await CreateWebGLAsync(),
                "Wasm" => await CreateWasmAsync(),
                _ => null
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Detect] Backend {backendId} failed: {ex.Message}");
            return null;
        }
    }

    private async Task<global::ILGPU.Runtime.Accelerator?> CreateWebGPUAsync()
    {
        var devices = _context!.GetDevices<WebGPUILGPUDevice>();
        return devices.Count > 0 ? await devices[0].CreateAcceleratorAsync(_context) : null;
    }

    private async Task<global::ILGPU.Runtime.Accelerator?> CreateWebGLAsync()
    {
        var devices = _context!.GetDevices<SpawnDev.ILGPU.WebGL.WebGLILGPUDevice>();
        return devices.Count > 0 ? await devices[0].CreateAcceleratorAsync(_context) : null;
    }

    private async Task<global::ILGPU.Runtime.Accelerator?> CreateWasmAsync()
    {
        var devices = _context!.GetDevices<SpawnDev.ILGPU.Wasm.WasmILGPUDevice>();
        return devices.Count > 0 ? await devices[0].CreateAcceleratorAsync(_context) : null;
    }

    private async Task HandleBackendChange(string backend)
    {
        if (backend == _selectedBackend && _isModelLoaded) return;
        bool wasLoaded = _isModelLoaded;
        _selectedBackend = backend;
        _pipeline?.Dispose();
        _pipeline = null;
        _accelerator?.Dispose();
        _accelerator = null;
        _isModelLoaded = false;
        _detections = null;
        if (wasLoaded)
            await EnsureModelAsync();
        else
            StateHasChanged();
    }

    private async Task HandleImageLoaded(byte[] imageBytes)
    {
        await EnsureModelAsync();
        if (_pipeline == null) return;
        try
        {
            _error = null;
            var mime = SniffImageMime(imageBytes);
            using var blob = new SpawnDev.SpawnJS.JSObjects.Blob(
                new[] { imageBytes }, new SpawnDev.SpawnJS.JSObjects.BlobOptions { Type = mime });
            using var window = JS.Get<SpawnDev.SpawnJS.JSObjects.Window>("window");
            using var bitmap = await window.CreateImageBitmap(blob);
            int w = (int)bitmap.Width;
            int h = (int)bitmap.Height;
            using var canvas = new SpawnDev.SpawnJS.JSObjects.HTMLCanvasElement();
            canvas.Width = w;
            canvas.Height = h;
            using var ctx = canvas.Get2DContext();
            ctx.DrawImage(bitmap, 0, 0, w, h);
            using var imageData = ctx.GetImageData(0, 0, w, h);
            using var data = imageData.Data;
            var rgbaPixels = data.Read<int>();
            _imageWidth = w;
            _imageHeight = h;

            await RunDetection(rgbaPixels, w, h);
        }
        catch (Exception ex)
        {
            _error = $"Image decode/inference failed: {ex.Message}";
            Console.WriteLine($"[Detect] Image error: {ex}");
            StateHasChanged();
        }
    }

    private async Task HandleFrame(byte[] frameBytes)
    {
        if (_processingFrame) return;
        _processingFrame = true;
        try
        {
            await EnsureModelAsync();
            if (_pipeline == null) return;
            var rgbaPixels = new int[frameBytes.Length / 4];
            Buffer.BlockCopy(frameBytes, 0, rgbaPixels, 0, frameBytes.Length);
            await RunDetection(rgbaPixels, 640, 480);
        }
        catch (Exception ex)
        {
            _error = $"Frame error: {ex.Message}";
            Console.WriteLine($"[Detect] Frame error: {ex}");
        }
        finally
        {
            _processingFrame = false;
        }
    }

    private async Task RunDetection(int[] rgbaPixels, int width, int height)
    {
        _isRunning = true;
        try
        {
            var result = await _pipeline!.DetectAsync(
                rgbaPixels, width, height,
                confidenceThreshold: _confidenceThreshold / 100f);
            _inferenceMs = result.InferenceTimeMs;
            _detections = result.Objects.Select(o => new BoundingBoxOverlay.Detection
            {
                X = o.X,
                Y = o.Y,
                Width = o.Width,
                Height = o.Height,
                Label = o.Label,
                ClassId = o.ClassId,
                Confidence = o.Confidence,
            }).ToList();
        }
        catch (Exception ex)
        {
            _error = $"Inference failed: {ex.Message}";
            Console.WriteLine($"[Detect] Inference error: {ex}");
        }
        _isRunning = false;
        StateHasChanged();
    }

    private static string SniffImageMime(byte[] bytes)
    {
        if (bytes.Length >= 3 && bytes[0] == 0xFF && bytes[1] == 0xD8 && bytes[2] == 0xFF)
            return "image/jpeg";
        if (bytes.Length >= 8 && bytes[0] == 0x89 && bytes[1] == 0x50 && bytes[2] == 0x4E && bytes[3] == 0x47)
            return "image/png";
        if (bytes.Length >= 12 && bytes[0] == 0x52 && bytes[1] == 0x49 && bytes[2] == 0x46 && bytes[3] == 0x46
            && bytes[8] == 0x57 && bytes[9] == 0x45 && bytes[10] == 0x42 && bytes[11] == 0x50)
            return "image/webp";
        return "image/jpeg";
    }

    public void Dispose()
    {
        _pipeline?.Dispose();
        _accelerator?.Dispose();
        _context?.Dispose();
    }
}
