    private void Begin()
    {
        _error = null; _glb = null; _resultInfo = null; _stages.Clear(); _rigged = null; _rigNote = null; _animated = null; _animNote = null;
        _isRunning = true;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task GenerateFromText()
    {
        if (string.IsNullOrWhiteSpace(_prompt)) return;
        Begin();
        var total = System.Diagnostics.Stopwatch.StartNew();
        try
        {
            if (!await EnsureAcceleratorAsync()) return;
            await EnsureImageModelAsync();
            _candidates.Clear(); _picking = false; _nextSeed = _seed;
            if (_pictures > 1)
            {
                // The user chooses: draw them all, show them, and wait.
                await DrawAsync(Enumerable.Range(_nextSeed, _pictures).ToArray());
                _nextSeed += _pictures;
                _picking = true;
                return;
            }
            // Auto: draw, cut out, and keep the drawing whose cut-out touches the frame least (a cropped drawing becomes a truncated model).
            // SD Turbo is cheap per picture, so it tries one at a time (up to 4); FLUX.2 loads 4 GB of weights per call, so it draws two in one go.
            int[]? best = null; int bw = 0, bh = 0, usedSeed = _seed; double bestTouch = double.MaxValue; Candidate? bestCandidate = null;
            int[][] rounds = _imageModel == "sd" ? new[] { new[] { _seed }, new[] { _seed + 1 }, new[] { _seed + 2 }, new[] { _seed + 3 } } : new[] { new[] { _seed, _seed + 1 } };
            foreach (var seeds in rounds)
            {
                var drawn = await DrawAsync(seeds);
                foreach (var c in drawn)
                {
                    var sw = System.Diagnostics.Stopwatch.StartNew();
                    _currentStage = $"cutting out seed {c.Seed}"; StateHasChanged();
                    var cut = await CutOutAsync(ToPixels(c), c.Width, c.Height);
                    double touch = BorderTouch(cut, c.Width, c.Height);
                    OnStageDone($"cut-out of seed {c.Seed} (on the frame {touch:P0})", sw.Elapsed.TotalSeconds);
                    if (touch < bestTouch) { best = cut; bw = c.Width; bh = c.Height; usedSeed = c.Seed; bestTouch = touch; bestCandidate = c; }
                }
                if (bestTouch < 0.005) break;
            }
            _sourceImageUrl = bestCandidate!.Url;
            await RunTrellisAsync(best!, bw, bh, total, $"\"{_prompt}\" (image seed {usedSeed})");
        }
        catch (Exception ex) { Fail(ex); }
        finally { _isRunning = false; _isLoading = false; _currentStage = null; StateHasChanged(); }
    }

    private int _nextSeed;

    private async Task DrawMoreAsync()
    {
        Begin();
        try
        {
            if (!await EnsureAcceleratorAsync()) return;
            await EnsureImageModelAsync();
            var seeds = Enumerable.Range(_nextSeed, 4).ToArray();
            _nextSeed += 4;
            await DrawAsync(seeds);
        }
        catch (Exception ex) { Fail(ex); }
        finally { _isRunning = false; _isLoading = false; _currentStage = null; StateHasChanged(); }
    }

    private async Task MakeFromAsync(Candidate c)
    {
        Begin();
        _picking = false;
        var total = System.Diagnostics.Stopwatch.StartNew();
        try
        {
            if (!await EnsureAcceleratorAsync()) return;
            var sw = System.Diagnostics.Stopwatch.StartNew();
            _currentStage = $"cutting out seed {c.Seed}"; StateHasChanged();
            var cut = await CutOutAsync(ToPixels(c), c.Width, c.Height);
            OnStageDone($"cut-out of seed {c.Seed}", sw.Elapsed.TotalSeconds);
            _sourceImageUrl = c.Url;
            await RunTrellisAsync(cut, c.Width, c.Height, total, $"\"{_prompt}\" (image seed {c.Seed})");
        }
        catch (Exception ex) { Fail(ex); }
        finally { _isRunning = false; _isLoading = false; _currentStage = null; StateHasChanged(); }
    }

    private static int[] ToPixels(Candidate c)
    {
        var px = new int[c.Width * c.Height];
        Buffer.BlockCopy(c.Rgba, 0, px, 0, px.Length * 4);
        for (int i = 0; i < px.Length; i++) px[i] |= unchecked((int)0xFF000000);
        return px;
    }

    /// <summary>Load the chosen image model on first use (FLUX.2 klein builds only its tokenizer and small VAE here; its two 2 GB stages stream in per draw).</summary>
    private async Task EnsureImageModelAsync()
    {
        if (_imageModel == "sd" && _sd == null)
        {
            _isLoading = true; _modelSizeMb = 2450; _currentStage = "SD Turbo (first run: 2.5 GB download)"; StateHasChanged();
            var sw = System.Diagnostics.Stopwatch.StartNew();
            _sd = await SpawnDev.ILGPU.ML.Pipelines.ImageGenerationPipeline.CreateAsync(_accelerator!, ModelSource, onProgress: (stage, pct) =>
            {
                _modelStatusText = $"SD Turbo — {stage}"; _modelProgress = pct; _ = InvokeAsync(StateHasChanged);
            });
            OnStageDone("image model load", sw.Elapsed.TotalSeconds);
        }
        else if (_imageModel == "flux2" && _flux == null)
        {
            _isLoading = true; _modelSizeMb = 4600; _currentStage = "FLUX.2 klein (first run: 4.6 GB download)"; StateHasChanged();
            var sw = System.Diagnostics.Stopwatch.StartNew();
            _flux = await SpawnDev.ILGPU.ML.Flux2.Flux2Pipeline.CreateAsync(_accelerator!, ModelSource, FluxRepo, 512, (stage, pct) =>
            {
                _modelStatusText = $"FLUX.2 klein — {stage}"; _modelProgress = pct; _ = InvokeAsync(StateHasChanged);
            });
            _flux.KeepTransformerResident = true;       // "Draw 4 more" reuses it; RunTrellisAsync releases it before TRELLIS.2 needs the memory
            OnStageDone("image model load", sw.Elapsed.TotalSeconds);
        }
        _isLoading = false;
    }

    /// <summary>Draw one picture per seed with the chosen model, adding each to the candidate list as it finishes.</summary>
    private async Task<List<Candidate>> DrawAsync(int[] seeds)
    {
        var drawn = new List<Candidate>();
        var sw = System.Diagnostics.Stopwatch.StartNew();
        async Task Add(int seed, int w, int h, byte[] rgba)
        {
            var c = new Candidate(seed, w, h, rgba, Services.ImageDisplayHelper.ToDataUrl(JS, rgba, w, h));
            drawn.Add(c); _candidates.Add(c);
            OnStageDone($"picture, seed {seed}", sw.Elapsed.TotalSeconds); sw.Restart();
            await InvokeAsync(StateHasChanged);
        }
        if (_imageModel == "sd")
        {
            foreach (var seed in seeds)
            {
                _currentStage = $"drawing (seed {seed})"; StateHasChanged();
                var img = await _sd!.RunAsync(new SpawnDev.ILGPU.ML.Pipelines.ImageGenerationInput { Prompt = _prompt + PromptSuffix, Seed = seed });
                await Add(seed, img.Width, img.Height, img.ImageRGBA);
            }
        }
        else
        {
            _currentStage = seeds.Length > 1 ? $"drawing {seeds.Length} pictures" : $"drawing (seed {seeds[0]})"; StateHasChanged();
            await _flux!.RunManyAsync(new SpawnDev.ILGPU.ML.Flux2.Flux2Request
            {
                Prompt = _prompt + PromptSuffix, Size = 512, Steps = 4,
                Progress = (stage, i, n) => { _currentStage = $"drawing: {stage}"; _ = InvokeAsync(StateHasChanged); },
            }, seeds, (i, img) => Add(seeds[i], img.Width, img.Height, img.Rgba));
        }
        return drawn;
    }

    private async Task GenerateFromImage()
    {
        if (_imagePixels == null) return;
        Begin();
        var total = System.Diagnostics.Stopwatch.StartNew();
        try
        {
            if (!await EnsureAcceleratorAsync()) return;
            var px = _imagePixels;
            bool opaque = true;
            foreach (var p in px) if (((p >> 24) & 255) != 255) { opaque = false; break; }
            if (opaque)
            {
                var sw = System.Diagnostics.Stopwatch.StartNew();
                px = await CutOutAsync(px, _imageWidth, _imageHeight);
                OnStageDone("background removal (RMBG-1.4)", sw.Elapsed.TotalSeconds);
            }
            _sourceImageUrl = _imageDataUrl;
            await RunTrellisAsync(px, _imageWidth, _imageHeight, total, "image");
        }
        catch (Exception ex) { Fail(ex); }
        finally { _isRunning = false; _isLoading = false; _currentStage = null; StateHasChanged(); }
    }

    private async Task<int[]> CutOutAsync(int[] px, int w, int h)
    {
        if (_rmbg == null)
        {
            _currentStage = "RMBG-1.4 (first run: downloading 44 MB)"; StateHasChanged();
            using var hub = new SpawnDev.ILGPU.ML.Hub.ModelHub(JS);
            var session = await InferenceSession.CreateFromHuggingFaceAsync(_accelerator!, hub,
                SpawnDev.ILGPU.ML.Hub.ModelHub.KnownModels.RMBG14, SpawnDev.ILGPU.ML.Hub.ModelHub.KnownFiles.OnnxModel, http: Http);
            _rmbg = new SpawnDev.ILGPU.ML.Pipelines.BackgroundRemovalPipeline(session, _accelerator!);
        }
        var r = await _rmbg.RemoveBackgroundAsync(px, w, h);
        _rmbg.ReleaseWorkingMemory();   // its 1024 px feature maps stay parked otherwise, and the next SD decode needs that VRAM
        return r.ResultPixels;
    }

    private static double BorderTouch(int[] px, int w, int h)
    {
        int ring = 0, hit = 0;
        for (int y = 0; y < h; y++)
            for (int x = 0; x < w; x++)
            {
                if (x >= 2 && y >= 2 && x < w - 2 && y < h - 2) continue;
                ring++;
                if (((px[y * w + x] >> 24) & 255) > 127) hit++;
            }
        return ring == 0 ? 0 : (double)hit / ring;
    }

    private async Task RunTrellisAsync(int[] px, int w, int h, System.Diagnostics.Stopwatch total, string label)
    {
        _flux?.ReleaseResident();                                  // FLUX.2's transformer (2.6 GB) must not sit on the GPU while TRELLIS.2 runs
        _isLoading = _downloadBytes > 0;                          // the first run downloads; streamed weights load again on every run
        _modelSizeMb = _downloadBytes / 1048576.0; _modelProgress = 0;
        _finishedBytes = _lastDone = _lastTotal = 0; _trellisPhase = true;
        _modelStatusText = _streamWeights ? "TRELLIS.2 (streaming)" : _downloadBytes == 0 && !_ready ? "TRELLIS.2 (loading from browser storage)" : "TRELLIS.2";
        _currentStage = "image prep"; StateHasChanged();
        try { _glb = await _trellis!.GenerateGlbAsync(px, w, h, new Trellis2Options { Seed = _seed, MaxFaces = _maxFaces, TextureSize = _textureSize }); }
        finally { _trellisPhase = false; }
        _ready = true; _isLoading = false;
        _downloadBytes = _streamedBytes;                          // the planned files are in OPFS now
        _inferenceMs = total.Elapsed.TotalMilliseconds;
        StateHasChanged();
        await Task.Yield();
        using var viewer = JS.Get<SpawnJSObject>("glbViewer");
        await viewer.JSRef!.CallVoidAsync("show", "t3d-canvas", _glb);
        _resultInfo = $"{label} · {_glb.Length / 1048576.0:F1} MB GLB · {total.Elapsed.TotalSeconds:F0} s total";
    }

    private void Fail(Exception ex)
    {
        // message + the first frames: a demo user can paste it into an issue
        _error = ex.Message + "\n" + string.Join("\n", (ex.StackTrace ?? "").Split('\n').Take(5).Select(l => l.Trim()));
        Console.WriteLine($"[Text/Image to 3D] {ex}");
    }

    private async Task HandleImageLoaded(byte[] imageBytes)
    {
        _error = null;
        try
        {
            using var blob = new SpawnDev.SpawnJS.JSObjects.Blob(new[] { imageBytes });
            using var window = JS.Get<SpawnDev.SpawnJS.JSObjects.Window>("window");
            using var bitmap = await window.CreateImageBitmap(blob);
            int w = (int)bitmap.Width, h = (int)bitmap.Height;
            using var canvas = new SpawnDev.SpawnJS.JSObjects.HTMLCanvasElement();
            canvas.Width = w; canvas.Height = h;
            using var ctx = canvas.Get2DContext();
            ctx.DrawImage(bitmap, 0, 0, w, h);
            using var imageData = ctx.GetImageData(0, 0, w, h);
            using var data = imageData.Data;
            _imagePixels = data.Read<int>();
            _imageWidth = w; _imageHeight = h;
        }
        catch (Exception ex) { Fail(ex); }
        StateHasChanged();
    }

    private void DownloadGlb()
    {
        if (_glb == null) return;
        try
        {
            using var blob = new SpawnDev.SpawnJS.JSObjects.Blob(new[] { _glb }, new SpawnDev.SpawnJS.JSObjects.BlobOptions { Type = "model/gltf-binary" });
            var url = SpawnDev.SpawnJS.JSObjects.URL.CreateObjectURL(blob);
            using var document = JS.Get<SpawnDev.SpawnJS.JSObjects.Document>("document");
            using var link = document.CreateElement<SpawnDev.SpawnJS.JSObjects.HTMLAnchorElement>("a");
            link.Href = url;
            link.Download = _mode == "text" ? $"{string.Join("-", _prompt.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(5))}.glb" : "model.glb";
            using var body = document.Body!;
            body.AppendChild(link);
            link.Click();
            body.RemoveChild(link);
        }
        catch (Exception ex) { Fail(ex); }
    }

    public void Dispose()
    {
        ModelSource.OnProgress -= OnDownloadProgress;
        try { using var viewer = JS.Get<SpawnJSObject>("glbViewer"); viewer.JSRef!.CallVoid("dispose", "t3d-canvas"); } catch { }
        _sd?.Dispose();
        _rmbg?.Dispose();
        _trellis?.Dispose();
        _accelerator?.Dispose();
        _context?.Dispose();
    }
