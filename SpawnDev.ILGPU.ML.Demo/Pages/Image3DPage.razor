    .t3d-settings label { display: flex; align-items: center; gap: 0.35rem; }
    .t3d-num { width: 80px; padding: 0.25rem 0.4rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.04); color: #e2e8f0; }
    .t3d-select { padding: 0.25rem 0.4rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.04); color: #e2e8f0; }
    .t3d-select option { background: #1e293b; }
