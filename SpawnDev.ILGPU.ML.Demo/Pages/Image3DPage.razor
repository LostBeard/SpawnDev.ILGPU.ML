@page "/image-to-3d"
@page "/text-to-3d"
@using SpawnDev.SpawnJS
@using SpawnDev.ILGPU.ML
@using SpawnDev.ILGPU.ML.Trellis2
@using SpawnDev.ILGPU.ML.SkinTokens
@implements IDisposable

<PageTitle>Text &amp; Image to 3D — SpawnDev.ILGPU.ML</PageTitle>

<DemoLayout Title="Text & Image to 3D"
            Description="Type what you want, or drop a picture of an object, and get a textured PBR 3D model (GLB) generated entirely on your GPU: FLUX.2 klein (or SD Turbo) draws it, RMBG-1.4 cuts it out, TRELLIS.2 builds the mesh and textures. Nothing leaves your machine."
            AvailableBackends="@_backends"
            SelectedBackend="@_selectedBackend"
            SelectedBackendChanged="@((v) => _selectedBackend = v)"
            InferenceTimeMs="@_inferenceMs"
            IsRunning="@_isRunning"
            ShowModelProgress="true"
            ModelName="@_modelStatusText"
            IsModelLoading="@_isLoading"
            IsModelLoaded="@(_ready && !_isLoading)"
            ModelProgressPercent="@_modelProgress"
            ModelSizeMB="@_modelSizeMb">

    <div class="t3d-modes">
        <button class="t3d-mode @(_mode == "text" ? "active" : "")" @onclick='() => _mode = "text"' disabled="@_isRunning">Text to 3D</button>
        <button class="t3d-mode @(_mode == "image" ? "active" : "")" @onclick='() => _mode = "image"' disabled="@_isRunning">Image to 3D</button>
    </div>

    @if (_mode == "text")
    {
        <div class="t3d-prompt-row">
            <input type="text" class="t3d-prompt" @bind="_prompt" @bind:event="oninput"
                   placeholder="a wooden treasure chest with iron bands" disabled="@_isRunning" />
            <button class="t3d-btn" @onclick="GenerateFromText" disabled="@(string.IsNullOrWhiteSpace(_prompt) || _isRunning)">@ButtonLabel</button>
        </div>
        <div class="t3d-settings">
            <label>Image model
                <select @bind="_imageModel" class="t3d-select" disabled="@_isRunning">
                    <option value="flux2">FLUX.2 klein 4B (sharper; 4.6 GB first download)</option>
                    <option value="sd">SD Turbo (faster; 2.5 GB first download)</option>
                </select>
            </label>
            <label>Pictures
                <select @bind="_pictures" class="t3d-select" disabled="@_isRunning">
                    <option value="1">Auto-pick the best fit</option>
                    <option value="4">Draw 4, I pick</option>
                    <option value="8">Draw 8, I pick</option>
                </select>
            </label>
        </div>
        @if (_candidates.Count > 0 && _picking)
        {
            <div class="t3d-pick">
                <div class="t3d-hint">Pick the picture to build in 3D (the same prompt with different seeds):</div>
                <div class="t3d-pick-grid">
                    @foreach (var c in _candidates)
                    {
                        <div class="t3d-pick-item">
                            <img src="@c.Url" alt="seed @c.Seed" />
                            <button class="t3d-btn small" @onclick="() => MakeFromAsync(c)" disabled="@_isRunning">Make 3D from this</button>
                            <span class="t3d-hint">seed @c.Seed</span>
                        </div>
                    }
                </div>
                <button class="t3d-btn small" @onclick="DrawMoreAsync" disabled="@_isRunning">Draw 4 more</button>
            </div>
        }
    }
    else
    {
        <ImageDropZone @bind-ImageDataUrl="_imageDataUrl" OnImageLoaded="@HandleImageLoaded" SampleImages="@_samples" />
        <p class="t3d-hint">Best results: one whole object. Images with a transparent background are used as is; others are cut out with RMBG-1.4 first.</p>
        @if (_imagePixels != null)
        {
            <button class="t3d-btn" @onclick="GenerateFromImage" disabled="@_isRunning">@ButtonLabel</button>
        }
    }

    <div class="t3d-settings">
        <label>Seed <input type="number" @bind="_seed" class="t3d-num" disabled="@_isRunning" /></label>
        <label>Triangles
            <select @bind="_maxFaces" class="t3d-select" disabled="@_isRunning">
                <option value="50000">50k (light)</option>
                <option value="100000">100k</option>
                <option value="150000">150k</option>
                <option value="300000">300k (default)</option>
            </select>
        </label>
        <label>Texture
            <select @bind="_textureSize" class="t3d-select" disabled="@_isRunning">
                <option value="1024">1024</option>
                <option value="2048">2048</option>
            </select>
        </label>
    </div>

    @if (_stages.Count > 0 || (_isRunning && _currentStage != null))
    {
        <div class="t3d-stages">
            @foreach (var s in _stages)
            {
                <div class="t3d-stage"><span class="t3d-stage-name">@s.Name</span><span class="t3d-stage-time">@s.Seconds.ToString("F1") s</span></div>
            }
            @if (_isRunning && _currentStage != null)
            {
                <div class="t3d-stage running"><span class="t3d-stage-name">@_currentStage</span><span class="t3d-stage-time">@(_downloadText ?? "…")</span></div>
            }
        </div>
    }

    <div class="t3d-result" style="display:@(_glb != null ? "block" : "none")">
        <div class="t3d-preview-row">
            @if (_sourceImageUrl != null)
            {
                <img class="t3d-source" src="@_sourceImageUrl" alt="source image" />
            }
            <canvas id="t3d-canvas" class="t3d-canvas"></canvas>
        </div>
        <div class="t3d-result-info">@_resultInfo</div>
        @if (_candidates.Count > 1 && !_picking)
        {
            <button class="action-btn" @onclick="() => _picking = true" disabled="@_isRunning">Choose another picture</button>
        }
        <div class="result-actions">
            <button class="action-btn download-btn" @onclick="DownloadGlb">Download .glb</button>
            <button class="action-btn rig-btn" @onclick="RigModelAsync" disabled="@(_isRunning || _rigging)"
                    title="Adds a skeleton and learned skin weights (SkinTokens, MIT) so the character can be animated. Best on a standing humanoid in a T or A pose.">@(_rigging ? "Rigging…" : "Rig this model")</button>
            @if (_rigged != null)
            {
                <button class="action-btn download-btn" @onclick="DownloadRigged">Download rigged .glb</button>
            }
        </div>
        @if (_rigNote != null)
        {
            <div class="t3d-hint">@_rigNote</div>
        }
        @if (_rigged != null)
        {
            <div class="result-actions">
                <button class="action-btn rig-btn" @onclick="AnimateAsync" disabled="@(_isRunning || _rigging || _animating)"
                        title="Plays 22 preset moves (NVIDIA Kimodo, via image-to-3dlab) on the rig. Needs a standing humanoid: two legs, a spine, a neck and two arms.">@(_animating ? "Animating…" : _animated == null ? "Animate (22 moves)" : "Animate again")</button>
                @if (_animated != null)
                {
                    <select @bind="_move" @bind:after="PlayMoveAsync" class="t3d-select">
                        @foreach (var m in _moves)
                        {
                            <option value="@m.Id">@m.Label</option>
                        }
                    </select>
                    <label class="t3d-hint"><input type="checkbox" @bind="_inPlace" @bind:after="PlayMoveAsync" /> in place</label>
                    <label class="t3d-hint" title="Swings the upper arms away from the body so arms and armour do not pass through the torso. Applied when the moves are retargeted.">arm clearance
                        <select @bind="_armClearance" @bind:after="AnimateAsync" class="t3d-select" disabled="@(_isRunning || _animating)">
                            <option value="0">0°</option><option value="5">5°</option><option value="8">8°</option><option value="12">12°</option><option value="18">18°</option>
                        </select></label>
                    <button class="action-btn download-btn" @onclick="DownloadAnimated">Download animated .glb (all moves)</button>
                }
            </div>
            @if (_animNote != null)
            {
                <div class="t3d-hint">@_animNote</div>
            }
        }
    </div>

    @if (!_ready && !_isLoading && _glb == null)
    {
        <div class="model-needed">
            This demo is opt-in and large: about <strong>11&nbsp;GB</strong> of TRELLIS.2 weights (three 2.5&nbsp;GB flow transformers, two decoders,
            DINOv3) plus <strong>4.6&nbsp;GB</strong> of FLUX.2 klein (4-bit) or <strong>2.5&nbsp;GB</strong> of SD Turbo for text mode and 44&nbsp;MB of RMBG-1.4. Everything downloads on the first
            generation, streams into your browser's storage (OPFS) and is reused after that; the <a href="cache">Model Cache</a> page removes it.
            Needs WebGPU and a GPU with about 6&nbsp;GB of free memory. A generation takes a few minutes on a desktop GPU.
        </div>
    }

    @if (_storageNote != null)
    {
        <div class="model-needed">@_storageNote</div>
    }

    @if (_error != null)
    {
        <div class="error-banner">@_error</div>
    }

    <PrivacyBadge />
    <PipelineHowTo SourceFile="Pages/Image3DPage.razor" Note="TRELLIS.2 (MIT) + FLUX.2 klein 4B (Black Forest Labs, Apache-2.0, 4-bit export LostBeard/FLUX.2-klein-4B-q4-ILGPU) or SD Turbo + RMBG-1.4; built with DINOv3; rigging: SkinTokens (VAST AI, MIT)" />
</DemoLayout>

<style>
    .t3d-modes { display: flex; gap: 0.5rem; margin-bottom: 1rem; }
    .t3d-mode { padding: 0.45rem 1.1rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.04); color: #94a3b8; cursor: pointer; }
    .t3d-mode.active { background: linear-gradient(135deg, #3b82f6, #8b5cf6); color: white; border-color: transparent; }
    .t3d-prompt-row { display: flex; gap: 0.5rem; }
    .t3d-prompt { flex: 1; padding: 0.6rem 0.75rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.04); color: #e2e8f0; font-size: 0.95rem; }
    .t3d-btn { padding: 0.6rem 1.5rem; border-radius: 8px; border: none; background: linear-gradient(135deg, #3b82f6, #8b5cf6); color: white; font-weight: 600; cursor: pointer; white-space: nowrap; margin-top: 0.5rem; }
    .t3d-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .t3d-hint { color: #64748b; font-size: 0.8rem; margin: 0.4rem 0; }
    .t3d-btn.small { padding: 0.35rem 0.9rem; font-size: 0.8rem; }
    .t3d-pick { margin-top: 0.9rem; }
    .t3d-pick-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 0.75rem; margin: 0.5rem 0 0.75rem; }
    .t3d-pick-item { display: flex; flex-direction: column; gap: 0.3rem; align-items: stretch; }
    .t3d-pick-item img { width: 100%; aspect-ratio: 1; object-fit: contain; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1); background: #0f172a; }
    .t3d-settings { display: flex; gap: 1.25rem; margin-top: 0.9rem; flex-wrap: wrap; color: #64748b; font-size: 0.8rem; }
    .t3d-settings label { display: flex; align-items: center; gap: 0.35rem; }
    .t3d-num { width: 80px; padding: 0.25rem 0.4rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.04); color: #e2e8f0; }
    .t3d-select { padding: 0.25rem 0.4rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.04); color: #e2e8f0; }
    .t3d-select option { background: #1e293b; }
    .t3d-stages { margin-top: 1rem; border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; padding: 0.5rem 0.75rem; font-family: monospace; font-size: 0.8rem; max-height: 260px; overflow-y: auto; }
    .t3d-stage { display: flex; justify-content: space-between; color: #94a3b8; padding: 0.1rem 0; }
    .t3d-stage.running { color: #fbbf24; }
    .t3d-stage-time { color: #64748b; }
    .t3d-result { margin-top: 1.25rem; }
    .t3d-preview-row { display: flex; gap: 1rem; align-items: stretch; flex-wrap: wrap; }
    .t3d-source { width: 220px; height: 220px; object-fit: contain; border-radius: 10px; border: 1px solid rgba(255,255,255,0.1); background: #0f172a; }
    .t3d-canvas { flex: 1; min-width: 300px; height: 460px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.1); cursor: grab; touch-action: none; }
    .t3d-result-info { color: #64748b; font-size: 0.8rem; font-family: monospace; margin-top: 0.5rem; }
    .result-actions { display: flex; gap: 0.5rem; margin-top: 0.75rem; }
    .action-btn { padding: 0.5rem 1rem; border-radius: 8px; font-size: 0.85rem; font-weight: 600; cursor: pointer; }
    .download-btn { border: 1px solid rgba(52,211,153,0.3); background: rgba(52,211,153,0.1); color: #6ee7b7; }
    .rig-btn { border: 1px solid rgba(139,92,246,0.35); background: rgba(139,92,246,0.12); color: #c4b5fd; }
    .rig-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .model-needed { margin-top: 1rem; padding: 0.75rem 1rem; background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2); border-radius: 8px; color: #fbbf24; font-size: 0.85rem; }
    .model-needed a { color: #fcd34d; }
    .error-banner { margin-top: 1rem; padding: 0.75rem 1rem; background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); border-radius: 8px; color: #fca5a5; font-size: 0.85rem; white-space: pre-wrap; }
</style>

@code {
    // Prompt / picture -> FLUX.2 klein or SD Turbo (text mode) -> RMBG-1.4 cut-out -> TRELLIS.2 (Trellis2ImageTo3D on the portable WebGPU kernels,
    // checkpoints streamed from the hub into OPFS one stage at a time) -> GLB -> preview (wwwroot/js/glb-viewer.js) + download.
    // Everything is opt-in: nothing loads until the first Generate.
    private const string PromptSuffix = ", a single object, centered, the whole object in frame with an empty margin around it, isolated on a plain white background, soft studio lighting, high detail";

    private string _selectedBackend = "WebGPU";
    private string _mode = "text";
    private string _prompt = "a wooden treasure chest with iron bands";
    private int _seed = 42;
    private int _maxFaces = 300_000;               // thin armour and cloth lose pieces at 150k (flecks and cracks); 300k keeps them
    private int _textureSize = 2048;
    private bool _isRunning, _isLoading, _ready;
    private double _modelProgress, _inferenceMs;
    private string _modelStatusText = "TRELLIS.2";
    private string? _error, _imageDataUrl, _sourceImageUrl, _resultInfo, _currentStage;
    private int[]? _imagePixels;
    private int _imageWidth, _imageHeight;
    private byte[]? _glb;
    private readonly List<(string Name, double Seconds)> _stages = new();

    private string ButtonLabel => _isRunning ? "Generating…" : _ready && (_mode == "image" || (_imageModel == "sd" ? _sd != null : _flux != null)) ? "Generate 3D" : "Download & Generate";

    private List<BackendSelector.BackendInfo> _backends = new() { new() { Id = "WebGPU", DisplayName = "WebGPU" } };
    private List<ImageDropZone.SampleImage> _samples = new()
    {
        new() { Label = "Crown", Url = "samples/crown.webp" },
        new() { Label = "Plant", Url = "samples/plant.webp" },
        new() { Label = "Witch", Url = "samples/witch.webp" },
        new() { Label = "Cat (photo)", Url = "samples/cat.jpg" },
    };

    [Inject] SpawnJSRuntime JS { get; set; } = default!;
    [Inject] SpawnDev.ILGPU.ML.Hub.HubModelSource ModelSource { get; set; } = default!;
    [Inject] HttpClient Http { get; set; } = default!;

    private global::ILGPU.Context? _context;
    private global::ILGPU.Runtime.Accelerator? _accelerator;
    private SpawnDev.ILGPU.ML.Pipelines.ImageGenerationPipeline? _sd;
    private SpawnDev.ILGPU.ML.Flux2.Flux2Pipeline? _flux;
    private const string FluxRepo = "LostBeard/FLUX.2-klein-4B-q4-ILGPU";
    private string _imageModel = "flux2";               // "flux2" | "sd"
    private int _pictures = 1;                          // 1 = auto-pick the best fit; 4 / 8 = draw that many and let the user pick
    private bool _picking;
    private readonly List<Candidate> _candidates = new();
    private sealed record Candidate(int Seed, int Width, int Height, byte[] Rgba, string Url);
    private SpawnDev.ILGPU.ML.Pipelines.BackgroundRemovalPipeline? _rmbg;
    private Trellis2ImageTo3D? _trellis;

    [Inject] NavigationManager Nav { get; set; } = default!;

    protected override void OnInitialized()
    {
        ModelSource.OnProgress += OnDownloadProgress;
        if (Nav.Uri.Contains("/image-to-3d", StringComparison.OrdinalIgnoreCase)) _mode = "image";   // each route opens its own mode
    }

    private async Task<bool> EnsureAcceleratorAsync()
    {
        if (_accelerator != null) return true;
        var builder = MLContext.Create();
        await builder.AllAcceleratorsAsync();
        _context = builder.ToContext();
        _accelerator = await _context.CreatePreferredAcceleratorAsync();
        if (_accelerator == null || _accelerator.AcceleratorType != global::ILGPU.Runtime.AcceleratorType.WebGPU)
        {
            _error = "This demo needs WebGPU (Chrome or Edge on a desktop GPU).";
            return false;
        }
        // Per file: cache the TRELLIS.2 checkpoints in OPFS, stream from the hub with range requests (on every run) only what the browser has no
        // room for. navigator.storage.estimate() is NOT a limit: Chrome 151 reports usage + 10 GiB however much it would really take (measured:
        // 14 GiB written against a 10 GiB "quota"), so the plan believes only an exact headroom (BrowserStorageEstimate) and a write the browser
        // really refuses falls back to streaming that file (RangeStreamModelSource.CacheFallback).
        var estimate = await ModelSource.GetStorageEstimateAsync();
        var ranged = new SpawnDev.ILGPU.ML.Hub.RangeStreamModelSource(ModelSource);
        ranged.OnProgress += OnDownloadProgress;
        ranged.CacheFallback += key =>
        {
            _streamWeights = true;
            _storageNote = "The browser refused to store all of the TRELLIS.2 weights, so part of them stream from the hub on every run.";
            _ = InvokeAsync(StateHasChanged);
        };
        var (cachedBytes, streamedBytes) = await ranged.PlanCacheAsync(Trellis2Weights.HubWeightFiles(), estimate);
        _streamWeights = streamedBytes > 0;
        _downloadBytes = streamedBytes + await UncachedBytesAsync(ranged);   // what the next run transfers
        _streamedBytes = streamedBytes;
        if (_streamWeights && estimate is { } e)
            _storageNote = $"This browser reports room for {e.Headroom / 1073741824.0:F1} GB more: {cachedBytes / 1073741824.0:F1} GB of the TRELLIS.2 weights are cached, "
                + $"the other {streamedBytes / 1073741824.0:F1} GB stream from the hub on every run.";
        _trellis = new Trellis2ImageTo3D(_accelerator, Trellis2Weights.FromModelSource(ranged)) { StageDone = OnStageDone };
        return true;
    }

    // bytes of the planned-for-cache files that are not in OPFS yet (they download once, on the next run)
    private async Task<long> UncachedBytesAsync(SpawnDev.ILGPU.ML.Hub.RangeStreamModelSource ranged)
    {
        long sum = 0;
        foreach (var (repo, path) in Trellis2Weights.HubWeightFiles())
        {
            if (!ranged.CacheFiles.Contains(repo + "/" + path) || await ModelSource.Store.ExistsAsync(ModelSource.CacheKey(repo, path))) continue;
            using var probe = await ModelSource.OpenForInspectionAsync(repo, path);
            sum += probe.Length;
        }
        return sum;
    }

    private long _downloadBytes, _streamedBytes;
    private bool _streamWeights;
    private string? _storageNote;
    private DateTime _lastProgressRender;

    // header progress while TRELLIS.2 loads: bytes of the finished files + the file in flight, over all TRELLIS.2 files
    private bool _trellisPhase;
    private long _finishedBytes, _lastDone, _lastTotal;
    private double _modelSizeMb = 11_010_000_000L / 1048576.0;

    private void OnDownloadProgress(long done, long total)
    {
        if (_trellisPhase && total > 0)
        {
            bool newFile = done < _lastDone || _lastDone >= _lastTotal;
            if (newFile && done >= total) return;                     // one complete report on open = a file already in OPFS: nothing transferred
            if (done < _lastDone) _finishedBytes += _lastTotal;      // a new file started
            _lastDone = done; _lastTotal = total;
            _modelProgress = Math.Min(100, 100.0 * (_finishedBytes + done) / Math.Max(_downloadBytes, 1));
        }
        if (total <= 0 || (DateTime.UtcNow - _lastProgressRender).TotalMilliseconds < 250 && done < total) return;
        _lastProgressRender = DateTime.UtcNow;
        _downloadText = $"{done / 1048576.0:F0} / {total / 1048576.0:F0} MB";
        _ = InvokeAsync(StateHasChanged);
    }
    private string? _downloadText;

    private void OnStageDone(string name, double seconds)
    {
        _downloadText = null;
        _stages.Add((name, seconds));
        _currentStage = NextStageHint(name);
        if (_streamWeights) _currentStage = _currentStage?.Replace("first run: ", "");   // part of the weights streams on every run: no "first run" promise
        _ = InvokeAsync(StateHasChanged);
    }

    private static string? NextStageHint(string done) => done switch
    {
        var d when d.StartsWith("image prep") => "DINOv3 features (first run: 1.2 GB download)",
        var d when d.StartsWith("dinov3") => "sparse structure flow weights (first run: 2.5 GB download)",
        var d when d.StartsWith("ss flow load") => "sparse structure flow (12 steps)",
        var d when d.StartsWith("ss flow sample") => "structure decoder",
        var d when d.StartsWith("ss decode") => "shape flow weights (first run: 2.5 GB download)",
        var d when d.StartsWith("shape flow load") => "shape flow (12 steps)",
        var d when d.StartsWith("shape flow sample") => "shape decoder weights",
        var d when d.StartsWith("shape decoder load") => "shape decoder + mesh",
        var d when d.StartsWith("shape decode") => "texture flow weights (first run: 2.5 GB download)",
        var d when d.StartsWith("tex flow load") => "texture flow (12 steps)",
        var d when d.StartsWith("tex flow sample") => "texture decoder",
        var d when d.StartsWith("tex decode") => "simplify mesh",
        var d when d.StartsWith("simplify") => "UV atlas",
        var d when d.StartsWith("mesh read") => "UV atlas",
        var d when d.StartsWith("uv atlas") => "texture bake",
        var d when d.StartsWith("texture bake") => "PNG + GLB",
        _ => null,
    };

    // Rig this model: SkinTokens (VAST AI Research, MIT; the converted bf16 weights are LostBeard/SkinTokens-bf16) writes a skeleton and learned skin weights into the GLB.
    // The 1.15 GB of weights stream into OPFS on the first rig and are reused after that. The rigger is built for the call and released straight after: it holds ~3 GB of GPU
    // memory (weights, KV cache, activations) that the next TRELLIS.2 generation needs.
    private const string SkinTokensRepo = "LostBeard/SkinTokens-bf16";
    private bool _rigging;
    private byte[]? _rigged;
    private string? _rigNote;

    private async Task RigModelAsync()
    {
        if (_glb == null || _accelerator == null || _rigging) return;
        _rigging = true; _isRunning = true; _error = null; _rigged = null; _animated = null; _animNote = null; _rigNote = "Rigging: loading SkinTokens (1.15 GB the first time)...";
        _isLoading = true; _modelSizeMb = 1150; _modelProgress = 0; _modelStatusText = "SkinTokens"; _currentStage = "SkinTokens weights";
        StateHasChanged();
        var total = System.Diagnostics.Stopwatch.StartNew();
        GpuWeights? weights = null; SkinTokensRigger? rigger = null;
        try
        {
            var estimate = await ModelSource.GetStorageEstimateAsync();
            var ranged = new SpawnDev.ILGPU.ML.Hub.RangeStreamModelSource(ModelSource);
            ranged.OnProgress += OnDownloadProgress;
            await ranged.PlanCacheAsync(SkinTokensWeights.HubWeightFiles(SkinTokensRepo), estimate);
            weights = await SkinTokensWeights.LoadAsync(_accelerator, ranged, SkinTokensRepo);
            _isLoading = false; _modelProgress = 100;
            var sw = System.Diagnostics.Stopwatch.StartNew();
            OnStageDone("skintokens weights", total.Elapsed.TotalSeconds);
            _currentStage = "rig: mesh encoder"; StateHasChanged(); await Task.Yield();
            rigger = new SkinTokensRigger(_accelerator, weights) { StageDone = (name, seconds) => { OnStageDone("rig " + name, seconds); _ = InvokeAsync(StateHasChanged); } };
            var result = await rigger.RigGlbAsync(_glb, _seed);
            _rigged = result.Glb;
            _rigNote = $"Rigged: {result.Skeleton.Count} joints with learned skin weights · {_rigged.Length / 1048576.0:F1} MB GLB · {total.Elapsed.TotalSeconds:F0} s. Download it, or load it in a viewer that plays skinned meshes.";
        }
        catch (Exception ex) { Fail(ex); _rigNote = null; }
        finally
        {
            rigger?.Dispose(); weights?.Dispose();
            _rigging = false; _isRunning = false; _isLoading = false; _currentStage = null;
            StateHasChanged();
        }
    }

    // Animate: the rig's skeleton is matched to Kimodo's SOMA skeleton by the shape of its bone tree and 22 preset moves (wwwroot/motions, NVIDIA Kimodo clips packed by
    // image-to-3dlab, Apache-2.0) are retargeted onto it; the result is one GLB with all the moves as glTF animations, previewed in the viewer.
    private sealed record Move(string Id, string Label);
    private readonly List<Move> _moves = new();
    private byte[]? _animated;
    private bool _animating, _inPlace = true;
    private int _armClearance = 8;                      // degrees: generated characters are bulkier than Kimodo's slim body
    private string _move = "walk";
    private string? _animNote;

    private async Task AnimateAsync()
    {
        if (_rigged == null || _animating) return;
        _animating = true; _error = null; _animNote = "Retargeting the moves onto the rig...";
        StateHasChanged();
        try
        {
            var sk = SpawnDev.ILGPU.ML.UniRig.RiggedGlb.ReadSkeleton(_rigged);
            var heads = Enumerable.Range(0, sk.Count).Select(i => new SpawnDev.ILGPU.ML.Animation.Vec3(sk.Joints[i * 3], sk.Joints[i * 3 + 1], sk.Joints[i * 3 + 2])).ToArray();
            var retargeter = new SpawnDev.ILGPU.ML.Animation.HumanoidRetargeter(sk.Parents, heads);
            using var index = System.Text.Json.JsonDocument.Parse(await Http.GetStringAsync("motions/moves.json"));
            var moves = index.RootElement.GetProperty("moves").EnumerateArray().Select(m => new Move(m.GetProperty("id").GetString()!, m.GetProperty("label").GetString()!)).ToList();
            var clips = new List<SpawnDev.ILGPU.ML.Animation.RetargetedClip>();
            foreach (var m in moves)
            {
                var clip = SpawnDev.ILGPU.ML.Animation.MotionClip.FromNpz(await Http.GetByteArrayAsync($"motions/{m.Id}.bin"), m.Id);
                clips.Add(retargeter.Retarget(clip, 1.0, _armClearance));
            }
            _animated = SpawnDev.ILGPU.ML.Animation.AnimatedGlb.Add(_rigged, clips);
            _moves.Clear(); _moves.AddRange(moves);
            if (!_moves.Any(m => m.Id == _move)) _move = _moves[0].Id;
            StateHasChanged(); await Task.Yield();
            using var viewer = JS.Get<SpawnJSObject>("glbViewer");
            await viewer.JSRef!.CallVoidAsync("show", "t3d-canvas", _animated);
            await viewer.JSRef!.CallVoidAsync("play", "t3d-canvas", _move, _inPlace);
            _animNote = $"{_moves.Count} moves on {sk.Count} bones · {_animated.Length / 1048576.0:F1} MB GLB. Pick a move; drag to orbit. Clips: NVIDIA Kimodo via image-to-3dlab (see motions/NOTICE.md).";
        }
        catch (SpawnDev.ILGPU.ML.Animation.NotAHumanoidException ex) { _animated = null; _animNote = "This model does not look like a standing humanoid, so the moves cannot be mapped onto it (" + ex.Message + ")."; }
        catch (Exception ex) { _animated = null; _animNote = null; Fail(ex); }
        finally { _animating = false; StateHasChanged(); }
    }

    private async Task PlayMoveAsync()
    {
        if (_animated == null) return;
        try { using var viewer = JS.Get<SpawnJSObject>("glbViewer"); await viewer.JSRef!.CallVoidAsync("play", "t3d-canvas", _move, _inPlace); }
        catch (Exception ex) { Fail(ex); }
    }

