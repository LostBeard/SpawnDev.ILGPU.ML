<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
		<!-- Publish TRIMMED, as consumers ship: SpawnDev.ILGPU.ML and SpawnDev.ILGPU are IsTrimmable, so the Blazor
		     default TrimMode=partial trims them and PMT tests them that way. Test assemblies are rooted below. -->
		<PublishTrimmed>true</PublishTrimmed>
		<!-- AOT: publish with -p:DemoAot=true (the GitHub Pages workflow does). RunAOTCompilation + WasmStripILAfterAOT=false keeps
		     the IL ILGPU compiles kernels from. WasmDedup stays at its default (true): the smallest dotnet.native.wasm, but one
		     single-threaded module for the generic instantiations (an hour+). For a quick local AOT build add -p:WasmDedup=false
		     (MEASURED: 25 min here, dotnet.native.wasm 131 MB raw / 37 MB .gz). Off by default because PlaywrightMultiTest publishes this
		     project for every run. Host code is the interpreter's otherwise: TRELLIS.2's mesh simplify / UV atlas and kernel IL compiles
		     run 30-45x slower than desktop .NET there. -->
		<DemoAot Condition="'$(DemoAot)' == ''">false</DemoAot>
		<RunAOTCompilation>$(DemoAot)</RunAOTCompilation>
		<WasmStripILAfterAOT>false</WasmStripILAfterAOT>
		<!-- mark as testable by PlaywrightMultiTest -->
		<PlaywrightMultiTest>

		</PlaywrightMultiTest>
	</PropertyGroup>

	<!-- Inject build timestamp into assembly metadata so the app can print it to browser console -->
	<ItemGroup>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>BuildTimestamp</_Parameter1>
			<_Parameter2>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm:ss")) UTC</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
		<!-- Direct ref so the whole graph (incl. WebTorrent's lower transitive pin) resolves UP to the
		     current AsyncFileSystem: the WebTorrent download store needs a Uint8Array-capable FS for its
		     zero-copy path. 2.2.0 also pins SpawnJS 2.1.17, matching the rest of the chain - an older
		     AsyncFileSystem would reach a stale SpawnJS transitively. -->
		<PackageReference Include="SpawnDev.AsyncFileSystem" Version="2.3.0" />
		<!-- Force the whole graph (incl. SpawnDev.ILGPU's transitive version) up to the current SpawnJS. The
		     original reason for pinning this directly was JSRef.Get<long?> (INumberNullableMarshaller) - WebGPU
		     adapter/device limits are long?, so without it maxStorageBufferBindingSize read null and the device
		     fell back to the 128 MiB default. It must now also be >= the version SpawnDev.ILGPU.ML requires
		     (2.1.15 introduced OPFSStream, which OpfsModelCache delivers models through), or NuGet fails the
		     build with an NU1605 downgrade rather than silently resolving low. -->
		<PackageReference Include="SpawnDev.SpawnJS" Version="3.0.6" />
	</ItemGroup>

	<ItemGroup>
		<Content Remove="playwright-test.json" />
	</ItemGroup>

	<ItemGroup>
		<None Include="playwright-test.json" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SpawnDev.ILGPU.ML\SpawnDev.ILGPU.ML.csproj" />
		<!-- Phonemizer: Kokoro / ZipVoice need EnglishPhonemizer in the TTS demo page. -->
		<ProjectReference Include="..\SpawnDev.Phonemizer\SpawnDev.Phonemizer.csproj" />
		<!-- Optional WebTorrent delivery. SpawnDev.ILGPU.ML no longer references WebTorrent; the demo keeps
		     this so the torrent path stays available and tested. Delivery DEFAULTS to HubModelSource (plain
		     HTTP + OPFS) - nothing here requires a WebTorrentClient to load a model. -->
		<ProjectReference Include="..\SpawnDev.ILGPU.ML.WebTorrent\SpawnDev.ILGPU.ML.WebTorrent.csproj" />
		<ProjectReference Include="..\SpawnDev.ILGPU.ML.Demo.Shared\SpawnDev.ILGPU.ML.Demo.Shared.csproj" />
	</ItemGroup>

	<!-- Tests are discovered by reflection: keep the app and the shared test assembly whole. -->
	<ItemGroup>
		<TrimmerRootAssembly Include="SpawnDev.ILGPU.ML.Demo" />
		<TrimmerRootAssembly Include="SpawnDev.ILGPU.ML.Demo.Shared" />
	</ItemGroup>
</Project>
