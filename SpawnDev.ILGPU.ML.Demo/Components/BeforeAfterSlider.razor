<div class="ba-container @(AfterHasTransparency ? "ba-checker" : "")" @ref="_container">
    @* Before clip is mirrored to After's so they meet at the slider and never overlap.
       Without this, a transparent After (e.g. background-removal RGBA) would show the
       Before image *through* its alpha holes — the visible result would look identical
       to the source even when the alpha mask is doing its job. *@
    <div class="ba-image ba-before" style="clip-path: inset(0 @(100 - SliderPosition)% 0 0);">
        <img src="@BeforeImageUrl" alt="Before" />
        <span class="ba-label ba-label-before">@BeforeLabel</span>
    </div>
    <div class="ba-image ba-after" style="clip-path: inset(0 0 0 @(SliderPosition)%);">
        @if (AfterCanvasReady.HasDelegate)
        {
            @* Canvas-based After: a Blazor consumer hooks an ICanvasRenderer to this
               element via the AfterCanvasReady callback so the GPU buffer renders
               directly — no PNG encode, no base64 data URL, no Blob shuffling. *@
            <canvas @ref="_afterCanvas"
                    width="@CanvasWidth"
                    height="@CanvasHeight"></canvas>
        }
        else
        {
            <img src="@AfterImageUrl" alt="After" />
        }
        <span class="ba-label ba-label-after">@AfterLabel</span>
    </div>
    <div class="ba-slider" style="left: @(SliderPosition)%;">
        <div class="ba-slider-line"></div>
        <div class="ba-slider-handle">
            <span class="ba-handle-arrows">&lsaquo; &rsaquo;</span>
        </div>
    </div>
    <input type="range" min="0" max="100" value="@SliderPosition"
           class="ba-range"
           @oninput="HandleSliderInput" />
</div>

@code {
    private ElementReference _container;
    private ElementReference _afterCanvas;
    private bool _canvasReadyFired;

    [Parameter] public string? BeforeImageUrl { get; set; }
    [Parameter] public string? AfterImageUrl { get; set; }
    [Parameter] public string BeforeLabel { get; set; } = "Original";
    [Parameter] public string AfterLabel { get; set; } = "Result";
    [Parameter] public double SliderPosition { get; set; } = 50;

    /// <summary>
    /// When true, the slider container shows a checkerboard pattern behind the After image
    /// so transparent regions of an RGBA result (e.g. background removal) are visually
    /// obvious instead of blending with the page background. Set this on pages whose After
    /// image legitimately has transparency.
    /// </summary>
    [Parameter] public bool AfterHasTransparency { get; set; }

    /// <summary>
    /// When supplied, the After side renders a <c>&lt;canvas&gt;</c> element instead of an
    /// <c>&lt;img&gt;</c>, and this callback fires once with the canvas's
    /// <see cref="ElementReference"/> after first render. Consumers create an ILGPU
    /// <c>ICanvasRenderer</c>, attach it to the element, and call
    /// <c>PresentAsync</c> with a <c>MemoryBuffer2D&lt;int, Stride2D.DenseX&gt;</c> — the
    /// GPU buffer renders straight to the page with no PNG encode, no base64 data URL,
    /// and no extra Blob/URL shuffling. <see cref="AfterImageUrl"/> is ignored in this
    /// mode. <see cref="CanvasWidth"/> / <see cref="CanvasHeight"/> set the canvas
    /// backing-store dimensions; CSS scales the canvas to container width.
    /// </summary>
    [Parameter] public EventCallback<ElementReference> AfterCanvasReady { get; set; }

    /// <summary>Canvas backing-store width (px) when <see cref="AfterCanvasReady"/> is set.</summary>
    [Parameter] public int CanvasWidth { get; set; } = 512;

    /// <summary>Canvas backing-store height (px) when <see cref="AfterCanvasReady"/> is set.</summary>
    [Parameter] public int CanvasHeight { get; set; } = 512;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (AfterCanvasReady.HasDelegate && !_canvasReadyFired)
        {
            _canvasReadyFired = true;
            await AfterCanvasReady.InvokeAsync(_afterCanvas);
        }
    }

    private void HandleSliderInput(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var val))
        {
            SliderPosition = val;
        }
    }
}

<style>
    .ba-container {
        position: relative;
        width: 100%;
        overflow: hidden;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: #0a0a0a;
        user-select: none;
    }

    /* Checkerboard for transparent-After demos (background removal). 16x16 squares,
       two grey tones so it reads as "transparency" regardless of the page theme. */
    .ba-checker {
        background-color: #1a1a1a;
        background-image:
            linear-gradient(45deg, #2a2a2a 25%, transparent 25%),
            linear-gradient(-45deg, #2a2a2a 25%, transparent 25%),
            linear-gradient(45deg, transparent 75%, #2a2a2a 75%),
            linear-gradient(-45deg, transparent 75%, #2a2a2a 75%);
        background-size: 16px 16px;
        background-position: 0 0, 0 8px, 8px -8px, -8px 0;
    }

    .ba-image {
        width: 100%;
    }

    /* Both img and canvas scale to container width; canvas keeps its aspect via the
       backing-store dimensions set by CanvasWidth/CanvasHeight. */
    .ba-image img,
    .ba-image canvas {
        width: 100%;
        height: auto;
        display: block;
    }

    .ba-before {
        position: relative;
    }

    .ba-after {
        position: absolute;
        inset: 0;
    }

    .ba-label {
        position: absolute;
        bottom: 0.75rem;
        padding: 0.25rem 0.6rem;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
        background: rgba(0, 0, 0, 0.6);
        color: #e2e8f0;
        backdrop-filter: blur(4px);
    }

    .ba-label-before {
        left: 0.75rem;
    }

    .ba-label-after {
        right: 0.75rem;
    }

    .ba-slider {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        z-index: 2;
    }

    .ba-slider-line {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 2px;
        background: white;
        box-shadow: 0 0 8px rgba(0, 0, 0, 0.5);
    }

    .ba-slider-handle {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
        z-index: 3;
    }

    .ba-handle-arrows {
        color: #1e293b;
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 0.2em;
    }

    .ba-range {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: col-resize;
        z-index: 4;
        margin: 0;
    }
</style>
