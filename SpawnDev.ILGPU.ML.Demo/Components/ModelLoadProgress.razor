@using SpawnDev.ILGPU.ML.Hub
@implements IDisposable
@* 2026-11-27: /text-gen showed "15 %, 49.5 / 330.0 MB" through its whole 330 MB download while the download bar said 44 % then 73 %: the pages set a
   coarse percent and then open their model file, and an open waits for the whole download (HubModelSource.OpenAsync). The MB figure was the page's
   percent times the model size, never a measured byte. And /generate said "FLUX.2 klein - text encoder: READY" while that 1.95 GB file downloaded:
   it marks the model loaded once the pipeline exists and the weights come on Generate. So: while the shared source downloads, this card shows the
   real bytes, whatever the page's flags say. *@
@{ var dl = Downloading; bool downloading = dl != null && string.IsNullOrEmpty(ErrorMessage); }
<div class="model-progress @(IsComplete && !downloading ? "complete" : "") @(IsLoading || downloading ? "loading" : "")">
    <div class="mp-header">
        <span class="mp-label">@ModelName</span>
        @if (downloading)
        {
            <span class="mp-status mp-status-loading">@(dl!.Value.Fraction is { } f ? $"downloading {f * 100:F0}%" : "downloading")</span>
        }
        else if (IsComplete)
        {
            <span class="mp-status mp-status-ready">Ready</span>
        }
        else if (IsLoading)
        {
            <span class="mp-status mp-status-loading">@(ProgressPercent.ToString("F0"))%</span>
        }
        else if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <span class="mp-status mp-status-error">Error</span>
        }
        else
        {
            <span class="mp-status mp-status-idle">Not loaded</span>
        }
    </div>

    @if (downloading)
    {
        var d = dl!.Value;
        <div class="mp-track">
            <div class="mp-fill" style="width: @((d.Fraction ?? 0) * 100)%;"></div>
        </div>
        <div class="mp-detail">loading: downloading @Mb(d.Received)@(d.Total > 0 ? " of " + Mb(d.Total) : "")@(d.Files > 1 ? $" ({d.Files} files)" : "")</div>
    }
    else if (IsLoading)
    {
        <div class="mp-track">
            <div class="mp-fill" style="width: @(ProgressPercent)%;"></div>
        </div>
        <div class="mp-detail">loading@(TotalSizeMB > 0 ? $" (about {TotalSizeMB:F0} MB on first use)" : "")</div>
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="mp-error">@ErrorMessage</div>
    }
</div>

@code {
    [Parameter] public string ModelName { get; set; } = "Model";
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsComplete { get; set; }
    [Parameter] public double ProgressPercent { get; set; }
    [Parameter] public double TotalSizeMB { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }

    [Inject] HubModelSource ModelSource { get; set; } = default!;

    private readonly record struct DownloadSum(long Received, long Total, int Files)
    {
        public double? Fraction => Total > 0 ? Math.Clamp((double)Received / Total, 0, 1) : null;
    }

    /// <summary>Every download running through the shared source, summed; null when none is running.</summary>
    private DownloadSum? Downloading
    {
        get
        {
            var all = ModelSource.ActiveDownloads;
            if (all.Count == 0) return null;
            long got = 0, total = 0; bool known = true;
            foreach (var x in all) { got += x.BytesReceived; if (x.TotalBytes > 0) total += x.TotalBytes; else known = false; }
            return new DownloadSum(got, known ? total : 0, all.Count);
        }
    }

    private static string Mb(long bytes) => bytes >= 1_000_000_000 ? $"{bytes / 1e9:F2} GB" : $"{bytes / 1e6:F1} MB";

    private System.Threading.PeriodicTimer? _timer;
    private int _shownCount;

    protected override void OnInitialized()
    {
        ModelSource.ActiveDownloadsChanged += OnDownloadsChanged;
        _ = PollAsync();
    }

    private void OnDownloadsChanged() => _ = InvokeAsync(StateHasChanged);

    // as ActiveDownloadsBar: the event carries the updates, the timer clears the card when a download ended between events
    private async Task PollAsync()
    {
        _timer = new System.Threading.PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await _timer.WaitForNextTickAsync())
            {
                int now = ModelSource.ActiveDownloads.Count;
                if (now == 0 && _shownCount == 0) continue;
                _shownCount = now;
                StateHasChanged();
            }
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        ModelSource.ActiveDownloadsChanged -= OnDownloadsChanged;      // the source is a singleton and outlives the page
        _timer?.Dispose();
    }
}

<style>
    .model-progress {
        padding: 0.6rem 0.8rem;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
    }

    .model-progress.complete {
        border-color: rgba(52, 211, 153, 0.2);
        background: rgba(52, 211, 153, 0.04);
    }

    .model-progress.loading {
        border-color: rgba(56, 189, 248, 0.2);
        background: rgba(56, 189, 248, 0.04);
    }

    .mp-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.25rem;
    }

    .mp-label {
        color: #cbd5e1;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .mp-status {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 0.15rem 0.5rem;
        border-radius: 4px;
    }

    .mp-status-ready {
        color: #34d399;
        background: rgba(52, 211, 153, 0.1);
    }

    .mp-status-loading {
        color: #38bdf8;
        background: rgba(56, 189, 248, 0.1);
    }

    .mp-status-idle {
        color: #64748b;
        background: rgba(100, 116, 139, 0.1);
    }

    .mp-status-error {
        color: #f87171;
        background: rgba(248, 113, 113, 0.1);
    }

    .mp-track {
        height: 6px;
        background: rgba(255, 255, 255, 0.06);
        border-radius: 3px;
        overflow: hidden;
        margin-bottom: 0.25rem;
    }

    .mp-fill {
        height: 100%;
        background: linear-gradient(90deg, #3b82f6, #8b5cf6);
        border-radius: 3px;
        transition: width 0.3s ease;
    }

    .mp-detail {
        color: #64748b;
        font-size: 0.75rem;
        font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
    }

    .mp-error {
        color: #f87171;
        font-size: 0.8rem;
        margin-top: 0.25rem;
    }
</style>
