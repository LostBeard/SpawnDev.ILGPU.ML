@* Compact source links for a demo page. Points at the real files on GitHub so the "how"
   cannot drift from what the page actually runs — no duplicated snippet to go stale. *@

<div class="howto">
    <div class="howto-row">
        <span class="howto-label">Source</span>
        @foreach (var file in AllFiles)
        {
            <a class="howto-link" href="@BlobUrl(file)" target="_blank" rel="noopener noreferrer">@DisplayName(file)</a>
        }
        @if (!string.IsNullOrWhiteSpace(Note))
        {
            <span class="howto-sep">·</span>
            <span class="howto-note">@Note</span>
        }
    </div>
</div>

<style>
    .howto {
        margin-top: 1.5rem;
        padding: 0.65rem 1rem;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 8px;
        background: rgba(255,255,255,0.02);
    }
    .howto-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.45rem 0.65rem;
    }
    .howto-label {
        color: #64748b;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    .howto-link {
        color: #a5b4fc;
        font-size: 0.85rem;
        font-family: 'JetBrains Mono', 'Consolas', monospace;
        text-decoration: none;
        border-bottom: 1px solid rgba(165,180,252,0.35);
    }
    .howto-link:hover {
        color: #c7d2fe;
        border-bottom-color: rgba(199,210,254,0.7);
    }
    .howto-sep { color: #475569; font-size: 0.85rem; }
    .howto-note { color: #94a3b8; font-size: 0.8rem; line-height: 1.35; }
</style>

@code {
    /// <summary>
    /// Path under <c>SpawnDev.ILGPU.ML.Demo/</c>, e.g. <c>Pages/WhisperPage.razor</c>.
    /// </summary>
    [Parameter, EditorRequired]
    public string SourceFile { get; set; } = "";

    /// <summary>Extra Demo-relative paths (code-behind, helpers) shown after the primary file.</summary>
    [Parameter]
    public IEnumerable<string>? RelatedFiles { get; set; }

    /// <summary>Optional one-line note (pipeline name, docs pointer) — keep short.</summary>
    [Parameter]
    public string? Note { get; set; }

    private const string RepoBlobBase =
        "https://github.com/LostBeard/SpawnDev.ILGPU.ML/blob/master/SpawnDev.ILGPU.ML.Demo/";

    private IEnumerable<string> AllFiles
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(SourceFile))
                yield return SourceFile.Trim().Replace('\\', '/').TrimStart('/');
            if (RelatedFiles == null) yield break;
            foreach (var f in RelatedFiles)
            {
                if (string.IsNullOrWhiteSpace(f)) continue;
                yield return f.Trim().Replace('\\', '/').TrimStart('/');
            }
        }
    }

    private static string BlobUrl(string file) => RepoBlobBase + file;

    private static string DisplayName(string file)
    {
        var i = file.LastIndexOf('/');
        return i >= 0 ? file[(i + 1)..] : file;
    }
}
