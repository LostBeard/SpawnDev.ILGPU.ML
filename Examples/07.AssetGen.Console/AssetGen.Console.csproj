<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>AssetGen.Console</AssemblyName>
    <RootNamespace>SpawnDev.ILGPU.ML.Examples.AssetGenConsole</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SpawnDev.ILGPU.ML\SpawnDev.ILGPU.ML.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The 22 bundled Kimodo clips (NVIDIA, see motions/NOTICE.md), copied beside the executable. -->
    <None Include="..\..\SpawnDev.ILGPU.ML.Demo\wwwroot\motions\*.bin" Link="motions\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\SpawnDev.ILGPU.ML.Demo\wwwroot\motions\NOTICE.md" Link="motions\NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
