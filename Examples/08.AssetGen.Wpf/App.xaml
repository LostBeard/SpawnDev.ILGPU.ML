<Application x:Class="SpawnDev.ILGPU.ML.Examples.AssetGenWpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0F141F" />
        <SolidColorBrush x:Key="Panel" Color="#172033" />
        <SolidColorBrush x:Key="Fg" Color="#E2E8F0" />
        <SolidColorBrush x:Key="Muted" Color="#94A3B8" />
        <SolidColorBrush x:Key="Accent" Color="#3B82F6" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#0F141F" />
            <Setter Property="Background" Value="#E2E8F0" />
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#64748B" /></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#0F141F" /></Style>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}" /></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Muted}" /></Style>
    </Application.Resources>
</Application>
