<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ImageGen.Console</AssemblyName>
    <RootNamespace>SpawnDev.ILGPU.ML.Examples.ImageGenConsole</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The ML library brings the diffusion pipeline + the hub model stream (and SpawnDev.WebTorrent
         transitively). The accelerator is created here (the app owns it) and runs SD-Turbo on the GPU. -->
    <ProjectReference Include="..\..\SpawnDev.ILGPU.ML\SpawnDev.ILGPU.ML.csproj" />
  </ItemGroup>

</Project>
