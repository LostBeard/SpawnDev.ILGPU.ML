<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ImageGen.Console</AssemblyName>
    <RootNamespace>SpawnDev.ILGPU.ML.Examples.ImageGenConsole</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The ML library brings the image pipelines (FLUX 3, FLUX.2, SD-Turbo) and the models-host downloader. The accelerator is
         created here (the app owns it) and runs them on the GPU. -->
    <ProjectReference Include="..\..\SpawnDev.ILGPU.ML\SpawnDev.ILGPU.ML.csproj" />
    <!-- Pure-managed, cross-platform image decode for reference pictures (PNG/JPEG/...). Example-only dependency. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.5" />
  </ItemGroup>

</Project>
